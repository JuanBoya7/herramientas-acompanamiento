@@meta
archivo: crisis-surfear-el-impulso.html
titulo: Surfear el impulso
orden: 02
enfoque: Crisis y consumo
etiqueta: Prevención de recaídas
sub: El deseo de consumir llega como una ola: sube, llega a su punto más alto y baja. No hay que obedecerla ni pelear con ella. Se le pone nombre —«esto es un impulso»—, se observa en el cuerpo con cierta distancia y se deja pasar. La tabla es la atención; la ola hace el resto.
fuente: Surf del impulso (urge surfing), en Marlatt y Donovan, Prevención de recaídas: estrategias de mantenimiento en el tratamiento de conductas adictivas, cap. 1, sobre Marlatt y Kristeller (1999).
resumen: Una ola que sube, llega a la cresta y baja en tiempo real mientras la persona marca cuánto pesa el impulso. Se etiqueta el impulso, se observa en el cuerpo y se deja pasar sin actuar ni luchar. Queda registrado cómo cambió y qué se hizo después.
campo3: Sesión
campo3ph: Ej. Sesión 4
@@css
  .ola{display:block;width:100%;max-width:640px;height:auto;margin:0 auto}
  .fase{font-size:18px;font-weight:700;text-align:center;margin:6px 0 2px;color:var(--acento);min-height:26px}
  .fase-sub{text-align:center;font-size:14px;color:var(--tinta-suave);max-width:560px;margin:0 auto;min-height:40px;line-height:1.5}
  button.arrancar{background:#2f7a9a;border-color:#2f7a9a;color:#fff;font-weight:600}
  button.arrancar:hover{background:#28687f;border-color:#28687f}
@@html
<section class="paso">
  <h2><span class="num">1</span>Ponerle nombre</h2>
  <p class="ayuda">El primer paso es reconocer lo que pasa por dentro como un impulso: no es una
  orden ni una necesidad, es un impulso.</p>
  <div class="cuerpo">
    <label class="etiqueta">¿Impulso de qué?</label>
    <div class="chips" id="deque"></div>
    <label class="etiqueta">¿Dónde se siente en el cuerpo?</label>
    <div class="chips" id="donde"></div>
    <div class="medidor" style="margin-top:12px">
      <label for="inicial">¿Qué tan fuerte es ahora?</label>
      <input type="range" id="inicial" min="0" max="10" value="7">
      <span class="valor" id="vInicial">7</span>
    </div>
  </div>
</section>

<div class="escenario">
  <svg class="ola" id="ola" viewBox="0 0 640 240" role="img"
    aria-label="Ola que sube hasta la cresta y vuelve a bajar"></svg>
  <div class="fase" id="fase">La ola todavía no empieza</div>
  <div class="fase-sub" id="faseSub">Al empezar, solo se observa. No se hace nada con el impulso.</div>
  <div class="marcas">
    <div><span class="n" id="mReloj" style="color:#2f7a9a">0:00</span><span class="r">surfeando</span></div>
    <div><span class="n" id="mFuerza" style="color:var(--acento)">7</span><span class="r">fuerza ahora</span></div>
  </div>
  <div class="medidor" style="max-width:600px;margin:10px auto 0">
    <label for="ahora">Mientras dura, ¿qué tan fuerte es?</label>
    <input type="range" id="ahora" min="0" max="10" value="7">
    <span class="valor" id="vAhora">7</span>
  </div>
  <div class="duracion" id="tiempo">
    <button type="button" class="chip" id="t60">1 minuto</button>
    <button type="button" class="chip activa" id="t180">3 minutos</button>
    <button type="button" class="chip" id="t300">5 minutos</button>
  </div>
  <div class="mandos">
    <button type="button" class="arrancar" id="btnArrancar" onclick="arrancar()">Empezar a surfear</button>
    <button type="button" onclick="detener()">Detener</button>
  </div>
</div>

<section class="paso">
  <h2><span class="num">2</span>Después de la ola</h2>
  <div class="cuerpo">
    <label class="etiqueta">¿Qué hice después?</label>
    <div class="chips" id="despues"></div>
    <div id="lectura"></div>
  </div>
</section>
@@js
const $ = Kit.$;

const DEQUE = ["Tomar alcohol", "Fumar", "Consumir marihuana", "Consumir otra sustancia", "Apostar", "Comer sin hambre"];
const DONDE = ["Pecho", "Estómago", "Garganta o boca", "Manos", "Cabeza", "Todo el cuerpo"];
const DESPUES = ["La dejé pasar sin consumir", "Hice otra cosa", "Llamé a alguien", "Consumí"];
const GUIA = [
  ["Nombrarlo", "Di por dentro: «esto es un impulso». Solo nombrarlo, sin discutirle."],
  ["Observar", "¿Dónde está en el cuerpo? ¿Qué forma tiene, cambia, se mueve? Míralo con curiosidad y algo de distancia, como quien mira una ola desde la tabla."],
  ["La cresta", "Si sube, déjalo subir. No hay que obedecerlo ni luchar contra él: se trata de aceptarlo mientras está."],
  ["Bajar", "Nota cómo baja, aunque sea un poco. Las olas llegan a su punto más alto y después bajan."]
];

let total = 180, t = 0, registro = [];

$("tiempo").addEventListener("click", e => {
  const b = e.target.closest(".chip"); if(!b || reloj.anda()) return;
  $("tiempo").querySelectorAll(".chip").forEach(c => c.classList.toggle("activa", c === b));
  total = +b.id.slice(1);
});

function altura(x){                     /* x de 0 a 1: sube, cresta, baja */
  return Math.sin(Math.PI * Math.min(1, Math.max(0, x))) ** 1.4;
}
function dibujar(){
  const svg = $("ola"); svg.innerHTML = "";
  const g = (tag, a) => svg.appendChild(Kit.svg(tag, a));
  g("rect", {x:0, y:0, width:640, height:240, fill:"#f2f8fb"});
  let d = "M0 220";
  for(let i = 0; i <= 64; i++){ const x = i / 64; d += " L" + (x * 640) + " " + (220 - altura(x) * 170); }
  g("path", {d:d + " L640 240 L0 240 Z", fill:"#2f7a9a", "fill-opacity":.18, stroke:"#2f7a9a", "stroke-width":2});
  /* lo que la persona fue marcando */
  if(registro.length > 1){
    let r = "";
    registro.forEach((p, i) => { r += (i ? " L" : "M") + (p[0] * 640) + " " + (220 - p[1] / 10 * 170); });
    g("path", {d:r, fill:"none", stroke:"#c9962f", "stroke-width":2.5, "stroke-linejoin":"round"});
  }
  const x = Math.min(1, t / total);
  const cx = x * 640, cy = 220 - altura(x) * 170;
  g("rect", {x:cx - 22, y:cy - 12, width:44, height:8, rx:4, fill:"#e8b04a", stroke:"#a8761f",
    transform:"rotate(" + (Math.cos(Math.PI * x) * -18) + " " + cx + " " + (cy - 8) + ")"});
}

function pintar(){
  const s = Math.floor(t);
  $("mReloj").textContent = Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0");
  $("mFuerza").textContent = $("ahora").value;
  const x = t / total, i = x < .15 ? 0 : x < .45 ? 1 : x < .65 ? 2 : 3;
  if(reloj.anda()){ $("fase").textContent = GUIA[i][0]; $("faseSub").textContent = GUIA[i][1]; }
  dibujar();
}

let acumulado = 0;
const reloj = Kit.reloj(dt => {
  t += dt; acumulado += dt;
  if(acumulado >= 2){ acumulado = 0; registro.push([Math.min(1, t / total), +$("ahora").value]); }
  if(t >= total){ terminar(); return; }
  pintar();
});

function arrancar(){
  if(reloj.anda()) return;
  t = 0; acumulado = 0;
  $("ahora").value = $("inicial").value; $("vAhora").textContent = $("ahora").value;
  registro = [[0, +$("inicial").value]];
  $("btnArrancar").textContent = "Surfeando…";
  reloj.andar(); pintar();
}
function detener(){
  reloj.parar(); $("btnArrancar").textContent = "Empezar a surfear";
  $("fase").textContent = "Detenido"; $("faseSub").textContent = "";
}
function terminar(){
  reloj.parar(); t = total; registro.push([1, +$("ahora").value]);
  $("btnArrancar").textContent = "Otra ola";
  $("fase").textContent = "La ola pasó";
  $("faseSub").textContent = "La línea dorada muestra cómo fue cambiando la fuerza del impulso.";
  pintar(); leer();
  Kit.brindis("Ola terminada");
}

function leer(){
  $("vInicial").textContent = $("inicial").value;
  $("vAhora").textContent = $("ahora").value;
  $("mFuerza").textContent = $("ahora").value;
  const a = +$("inicial").value, f = +$("ahora").value, d = Kit.activas("despues");
  let html = "";
  if(registro.length > 1)
    html += f < a
      ? `<div class="logro">De ${a} a ${f}: el impulso bajó sin obedecerlo. Eso es lo que se entrena.</div>`
      : `<div class="pistas">El impulso no bajó en este rato. Pasa, sobre todo al principio: la ola
         puede ser más larga. Se puede surfear otra, o pasar a otra estrategia del plan.</div>`;
  if(d.indexOf("Consumí") >= 0)
    html += `<div class="pistas">Si hubo consumo, se revisa con calma qué pasó justo antes y
      durante, como información para la próxima vez; una caída no borra lo aprendido.</div>`;
  $("lectura").innerHTML = html;
}

function resumen(){
  const l = [];
  l.push("Impulso de: " + (Kit.activas("deque").join(", ") || "—") + " · en: " + (Kit.activas("donde").join(", ") || "—"));
  l.push(`Fuerza al inicio: ${$("inicial").value}/10 · al final: ${$("ahora").value}/10 · duración ${Math.round(total / 60)} min`);
  const d = Kit.activas("despues");
  if(d.length) l.push("Después: " + d.join(", "));
  return l.join("\n");
}

Kit.chips("deque", DEQUE);
Kit.chips("donde", DONDE);
Kit.chips("despues", DESPUES, leer);
$("inicial").addEventListener("input", leer);
$("ahora").addEventListener("input", leer);
dibujar(); leer();

Kit.iniciar({ clave: "crisis-surfear-el-impulso", alCambiar: leer, resumen: resumen });
