@@meta
archivo: met-el-escenario.html
titulo: El escenario y el reflector
orden: 13
enfoque: ACT
etiqueta: Yo observador
sub: Sobre el escenario están todos tus pensamientos, emociones, recuerdos y también lo que te importa. Cuando el reflector se cierra sobre el actor más ruidoso, parece que no existiera nada más en la sala. Encender las luces de todo el escenario y notar la butaca desde la que miras no echa a nadie de las tablas, pero devuelve la proporción.
fuente: La metáfora del espectáculo en el escenario (The Stage Show Metaphor), en Harris, ACT Made Simple (2009), caps. 4 y 10; When Life Hits Hard (2021), cap. 19.
resumen: Se identifica qué voz acapara hoy el centro del escenario y qué otros elementos siguen sobre las tablas aunque a oscuras. Los mandos de iluminación permiten abrir la luz general y distinguir la perspectiva desde la butaca.
@@css
  .teatro{display:block;width:100%;height:auto;max-width:700px;margin:0 auto}
  .fase{font-size:19px;font-weight:700;text-align:center;margin:8px auto 2px;color:var(--acento);
    min-height:28px;max-width:600px;line-height:1.35}
  .fase-sub{text-align:center;font-size:14px;color:var(--tinta-suave);max-width:560px;margin:0 auto;
    min-height:22px;line-height:1.5}
@@html
<section class="paso">
  <h2><span class="num">1</span>Quiénes están hoy sobre las tablas</h2>
  <p class="ayuda">En el espectáculo hay un personaje que hoy grita bajo el reflector y varios más que
  siguen en escena aunque queden en penumbra.</p>
  <div class="cuerpo">
    <label class="etiqueta">Quién grita en el centro del escenario</label>
    <div class="chips" id="actorGrita"></div>
    <label class="etiqueta">Quiénes más están sobre las tablas aunque a oscuras</label>
    <div class="chips" id="otrosActores"></div>
  </div>
</section>

<div class="escenario">
  <svg class="teatro" id="svgTeatro" viewBox="0 0 700 467" role="img"
    aria-label="Un teatro visto desde las butacas: el reflector, las tablas y quien mira"></svg>
  <div class="marcas">
    <div><span class="n" id="mVolvi" style="color:#3f7d5a">0</span><span class="r">veces que volví a abrir la luz</span></div>
  </div>
  <div class="duracion" id="luces">
    <button type="button" class="chip activa" id="luzCerrada" onclick="ponerLuz('cerrada')">Reflector cerrado</button>
    <button type="button" class="chip" id="luzAbierta" onclick="ponerLuz('abierta')">Encender las luces de todo el escenario</button>
    <button type="button" class="chip" id="luzButaca" onclick="ponerLuz('butaca')">Mirar desde la butaca</button>
  </div>
</div>

<section class="bloque pregunta-sola">
  <div class="pregunta" id="pregunta">Sin echar a nadie de las tablas, ¿a qué parte del escenario quieres prestarle atención ahora?</div>
  <div class="cuerpo" style="padding:10px 0 0">
    <div class="chips" id="focoElegido"></div>
  </div>
</section>
@@js
const $ = Kit.$;

const GRITA = [
  "El miedo a fallar",
  "El reproche por el pasado",
  "La urgencia de controlar todo",
  "El cansancio en el cuerpo"
];
const OTROS = [
  "El afecto por los míos",
  "El gusto por aprender o crear",
  "La calma de este momento",
  "Lo que sí salió bien hoy",
  "La persona que me acompaña"
];
const FOCO = [
  "Mirar todo el escenario sin quedarme pegado a un solo grito",
  "Acercar la atención a lo que valoro aunque el otro actor siga ahí",
  "Recordar que yo soy quien mira desde la butaca, no el espectáculo",
  "Dejar que el personaje ruidoso esté en un costado sin discutirle"
];

let modoLuz = "cerrada"; /* cerrada | abierta | butaca */
let apertura = 0;        /* 0 = cerrada, 1 = abierta */
let verButaca = 0;       /* 0 = sin foco en butaca, 1 = butaca destacada */

function nombreGrita(){
  const a = Kit.activas("actorGrita");
  return a.length ? a[0] : "El miedo a fallar";
}
function listaOtros(){
  const o = Kit.activas("otrosActores");
  if(o.length >= 2) return o.slice(0, 4);
  if(o.length === 1) return [o[0], "Lo que importa hoy", "Este momento presente"];
  return ["El afecto por los míos", "Lo que sí salió bien hoy", "La calma de este momento"];
}

let fondoTeatro = null, volvi = 0, abierto = 0;
const ACTORES = [{href:"[[imagen:escenario-actor-1.webp]]", r:0.85}, {href:"[[imagen:escenario-actor-2.webp]]", r:0.412}, {href:"[[imagen:escenario-actor-3.webp]]", r:0.365}, {href:"[[imagen:escenario-actor-4.webp]]", r:0.492}, {href:"[[imagen:escenario-actor-5.webp]]", r:0.546}, {href:"[[imagen:escenario-actor-6.webp]]", r:0.581}];
const TABLAS = 248;      /* donde pisan los actores */
function dibujar(){
  const svg = $("svgTeatro");
  svg.innerHTML = "";
  const g = (tag, a, p) => (p || svg).appendChild(Kit.svg(tag, a));
  const rotulo = (x, y, s, tam, color, op) => {
    const e = Kit.svg("text", {x, y, "text-anchor":"middle",
      style:`font:600 ${tam}px Georgia,serif;font-style:italic;fill:${color};opacity:${op};paint-order:stroke;stroke:#151b22;stroke-width:4px;stroke-linejoin:round`});
    e.textContent = s; svg.appendChild(e);
  };
  const actor = (clave, cual, x, alto, op) => {
    const f = ACTORES[cual], w = alto * f.r;
    svg.appendChild(Kit.figura(clave, f.href, {x:x - w / 2, y:TABLAS - alto, width:w, height:alto, opacity:op}));
  };
  if(!fondoTeatro) fondoTeatro = Kit.svg("image", {href:"[[imagen:escenario-acuarela.jpg]]", x:0, y:0, width:700, height:467, preserveAspectRatio:"none"});
  svg.appendChild(fondoTeatro);

  /* los demás siguen en las tablas aunque no se los vea */
  const otros = listaOtros(), sitios = [150, 232, 468, 556];
  otros.slice(0, 4).forEach((txt, i) => actor("otro" + i, [3, 4, 5, 1][i], sitios[i], 104, 1));

  /* la sala a oscuras: con el reflector cerrado solo existe lo que está bajo el cono */
  const oscuro = 0.8 * (1 - apertura);
  if(oscuro > 0.01) g("rect", {x:0, y:0, width:700, height:260, fill:"#0b1016", opacity:oscuro.toFixed(3)});
  if(apertura > 0.02) g("ellipse", {cx:350, cy:150, rx:310 * apertura, ry:120 * apertura, fill:"#ffe9b8", opacity:(0.18 * apertura).toFixed(2), style:"mix-blend-mode:soft-light"});
  if(apertura < 0.98) g("polygon", {points:`350,0 ${262 - 40 * apertura},${TABLAS + 6} ${438 + 40 * apertura},${TABLAS + 6}`, fill:"#fff3c4", opacity:((1 - apertura) * 0.3).toFixed(2)});

  /* quien grita: bajo el cono se ve enorme; con la luz abierta recupera su tamaño */
  const ng = nombreGrita();
  const alto = 104 * (1.42 - 0.42 * apertura);
  actor("grita", 0, 350, alto, 1);
  rotulo(350, TABLAS - alto - 26, "«" + (ng.length > 28 ? ng.slice(0, 26) + "…" : ng) + "»", 14, "#ffd9cf", 1);
  otros.slice(0, 4).forEach((txt, i) =>
    rotulo(sitios[i], TABLAS - 112 - (i % 2) * 15, txt.length > 19 ? txt.slice(0, 18) + "…" : txt, 11.5, "#f1f5f8", (0.05 + 0.95 * apertura).toFixed(2)));

  /* la butaca: quien mira todo el escenario */
  if(verButaca > 0.03){
    g("rect", {x:0, y:0, width:700, height:262, fill:"#0b1016", opacity:(0.22 * verButaca).toFixed(3)});
    g("ellipse", {cx:498, cy:318, rx:112, ry:120, fill:"#ffe9b8", opacity:(0.34 * verButaca).toFixed(2), style:"mix-blend-mode:soft-light"});
    g("ellipse", {cx:498, cy:318, rx:104, ry:112, fill:"none", stroke:"#f3d27a", "stroke-width":2, "stroke-dasharray":"2 7", "stroke-linecap":"round", opacity:verButaca.toFixed(2)});
  }
}

const reloj = Kit.reloj(dt => {
  const metaA = modoLuz === "cerrada" ? 0 : 1;
  const metaB = modoLuz === "butaca" ? 1 : 0;
  apertura += (metaA - apertura) * Math.min(1, dt * 5);
  verButaca += (metaB - verButaca) * Math.min(1, dt * 5);
  /* la atención se cierra sola: al rato el reflector vuelve a quien grita */
  if(modoLuz !== "cerrada"){
    abierto += dt;
    if(abierto > 16){ modoLuz = "cerrada"; abierto = 0; actualizarUI(); }
  }
  dibujar();
});

function actualizarUI(){
  $("luzCerrada").classList.toggle("activa", modoLuz === "cerrada");
  $("luzAbierta").classList.toggle("activa", modoLuz === "abierta");
  $("luzButaca").classList.toggle("activa", modoLuz === "butaca");
  $("mVolvi").textContent = volvi;
}

function ponerLuz(m){
  if(m !== "cerrada" && modoLuz === "cerrada") volvi++;
  modoLuz = m; abierto = 0;
  actualizarUI();
  reloj.andar();
  Kit.guardar();
}

function leer(){
  actualizarUI();
  dibujar();
}

function resumen(){
  const l = [];
  const g = Kit.activas("actorGrita");
  if(g.length) l.push("Quién grita en el centro: " + g.join(", "));
  const o = Kit.activas("otrosActores");
  if(o.length) l.push("Quiénes más están sobre las tablas: " + o.join(", "));
  l.push("Iluminación explorada: " + (modoLuz === "cerrada" ? "Reflector cerrado" : modoLuz === "abierta" ? "Todo el escenario iluminado" : "Perspectiva desde la butaca"));
  const f = Kit.activas("focoElegido");
  if(f.length) l.push("Dónde poner la atención ahora: " + f.join(", "));
  return l.join("\n");
}

Kit.chips("actorGrita", GRITA, leer);
Kit.chips("otrosActores", OTROS, leer);
Kit.chips("focoElegido", FOCO);
dibujar();

reloj.andar();
Kit.iniciar({
  clave: "met-el-escenario",
  alCambiar: leer,
  resumen: resumen,
  extra: () => ({modoLuz}),
  restaurar: d => {
    modoLuz = (d && d.modoLuz) || "cerrada";
    apertura = modoLuz === "cerrada" ? 0 : 1;
    verButaca = modoLuz === "butaca" ? 1 : 0;
  }
});
