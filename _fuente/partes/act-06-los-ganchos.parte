@@meta
archivo: act-los-ganchos.html
titulo: Los ganchos
orden: 06
enfoque: ACT
etiqueta: Matriz, paso 3
sub: Un pez nada hacia lo que le importa y en el camino aparecen ganchos: un pensamiento, una emoción, un recuerdo, algo que se ve. El pez no sabe que mordió por el gancho, sino porque de pronto lo arrastran en otra dirección. No necesita entender el gancho ni deshacerse de él: le basta con notarlo como gancho.
fuente: La metáfora de los ganchos y su hoja de trabajo, en Polk, Schoendorff, Webster y Olaz, The Essential Guide to the ACT Matrix (2016), paso 3.
resumen: Se anota hacia qué nada la persona y cuáles son sus ganchos, cada uno con lo que hace después de morderlo. Luego el pez recorre el lago y, en cada gancho, se decide en voz alta: morder o notarlo y seguir. Termina con una sola pregunta y la práctica de notar ganchos en la semana.
@@css
  .lago{display:block;width:100%;height:auto}
  .fase{font-size:19px;font-weight:700;text-align:center;margin:8px auto 2px;color:var(--acento);
    min-height:28px;max-width:600px;line-height:1.35}
  .fase-sub{text-align:center;font-size:14px;color:var(--tinta-suave);max-width:560px;margin:0 auto;
    min-height:22px;line-height:1.5}
  button.arrancar{background:#3f9b86;border-color:#3f9b86;color:#fff;font-weight:600}
  button.arrancar:hover{background:#357f6e;border-color:#357f6e}
  button.morder{border-color:#b0503f;color:#b0503f;font-weight:600}
  button.notar{border-color:#3f9b86;color:#3f9b86;font-weight:600}
  .linea-gancho{display:grid;grid-template-columns:minmax(120px,190px) 1fr;gap:10px;align-items:center;
    margin:0 0 8px}
  .linea-gancho .cebo{font-size:14px;font-weight:600;color:#b0503f}
  .linea-gancho .cebo::before{content:"\21B3  ";color:var(--tinta-suave)}
  @media (max-width:560px){.linea-gancho{grid-template-columns:1fr;gap:3px}}
@@html
<section class="paso">
  <h2><span class="num">1</span>Hacia dónde nadas</h2>
  <p class="ayuda">Lo de abajo a la derecha en la matriz: quién o qué te importa.</p>
  <div class="cuerpo">
    <div class="chips" id="importa"></div>
  </div>
</section>

<section class="paso">
  <h2><span class="num">2</span>Tus ganchos</h2>
  <p class="ayuda">En el cebo va lo que engancha; en la línea, lo que haces después. No hay que
  clasificarlo bien: a veces el gancho está afuera, en algo que se ve o se oye.</p>
  <div class="cuerpo">
    <label class="etiqueta">Lo que engancha</label>
    <div class="chips" id="cebos"></div>
    <label class="etiqueta">Lo que haces después</label>
    <div id="lineas"></div>
  </div>
</section>

<div class="escenario">
  <svg class="lago" id="lago" viewBox="0 0 700 250" role="img"
    aria-label="Un pez nada hacia lo que importa y en el camino cuelgan ganchos"></svg>
  <div class="fase" id="fase">Elige los ganchos y empieza</div>
  <div class="fase-sub" id="faseSub"></div>
  <div class="marcas">
    <div><span class="n" id="mNotados" style="color:#3f9b86">0</span><span class="r">notados</span></div>
    <div><span class="n" id="mMordidos" style="color:#b0503f">0</span><span class="r">mordidos</span></div>
  </div>
  <div class="mandos">
    <button type="button" class="arrancar" id="btnArrancar" onclick="arrancar()">Soltar el pez</button>
    <button type="button" class="morder" id="btnMorder" onclick="morder()" hidden>Morder</button>
    <button type="button" class="notar" id="btnNotar" onclick="notar()" hidden>Notarlo y seguir nadando</button>
    <button type="button" onclick="reiniciar()">Volver a empezar</button>
  </div>
</div>

<section class="bloque pregunta-sola">
  <div class="pregunta" id="pregunta">¿Cómo te das cuenta de que mordiste?</div>
  <div class="cuerpo" style="padding:10px 0 0">
    <div class="chips" id="seDa"></div>
  </div>
</section>

<section class="paso">
  <h2><span class="num">3</span>Para la semana</h2>
  <p class="ayuda">Pescar no es atrapar. Se practica notar el gancho y lo que se hace después;
  no hace falta entenderlo ni deshacerse de él.</p>
  <div class="cuerpo">
    <div class="chips" id="practica"></div>
  </div>
</section>
@@js
const $ = Kit.$;

const IMPORTA = ["Mi familia", "Mi pareja", "Mis amigos", "Mi trabajo o estudio", "Mi salud"];
const CEBOS = ["Rabia", "«No sirvo»", "Miedo a quedar mal", "Un recuerdo", "Cansancio",
  "Ganas de consumir"];
const SEDA = ["Por lo que hago después", "Por lo que siento en el cuerpo", "Me doy cuenta mucho después",
  "No me doy cuenta"];
const PRACTICA = ["Anotar un gancho al día y lo que hice después",
  "Notar el gancho en el momento, sin anotarlo",
  "Un minuto al día separando lo que llega por los cinco sentidos de lo de adentro"];

let LINEAS = {};                       /* cebo -> lo que hace después */
const ORILLA = 40, META = 640, VEL = 75, AGUA = 40, PEZ_Y = 185;
let hooks = [], pez = {x:ORILLA, y:PEZ_Y, modo:"quieto", t:0, i:-1, desdeX:0, desdeY:0};
let notados = 0, mordidos = 0;

function destino(){
  const i = Kit.activas("importa");
  return i.length ? i.join(", ").toLowerCase() : "lo que importa";
}

/* ---------- las líneas de cada cebo ---------- */
function pintarLineas(){
  const c = Kit.activas("cebos"), caja = $("lineas");
  if(!c.length){ caja.innerHTML = `<p class="ayuda" style="margin:0">Aparecen al elegir los ganchos.</p>`; return; }
  const abierto = document.activeElement && document.activeElement.dataset
    ? document.activeElement.dataset.cebo : null;
  caja.innerHTML = "";
  c.forEach(txt => {
    const f = Kit.crearEl("div", "linea-gancho");
    f.appendChild(Kit.crearEl("div", "cebo", txt));
    const inp = document.createElement("input");
    inp.type = "text"; inp.dataset.cebo = txt;
    inp.placeholder = "Ej. levantar la voz y salir";
    inp.value = LINEAS[txt] || "";
    inp.addEventListener("input", () => { LINEAS[txt] = inp.value; Kit.guardar(); });
    f.appendChild(inp);
    caja.appendChild(f);
    if(abierto === txt) inp.focus();
  });
}

function armarGanchos(){
  const c = Kit.activas("cebos").slice(0, 6);
  const paso = (520 - 140) / Math.max(1, c.length - 1);
  hooks = c.map((txt, i) => ({txt, x: c.length === 1 ? 340 : 140 + paso * i, estado:null}));
}

/* ---------- el lago ---------- */
function dibujar(){
  const svg = $("lago");
  svg.innerHTML = "";
  svg.appendChild(Kit.svg("rect", {x:0, y:AGUA, width:700, height:250 - AGUA, fill:"#e8f3f6"}));
  svg.appendChild(Kit.svg("path", {d:`M0 ${AGUA} Q 87 ${AGUA - 6} 175 ${AGUA} T 350 ${AGUA} T 525 ${AGUA} T 700 ${AGUA}`,
    fill:"none", stroke:"#8fbfcc", "stroke-width":2}));
  /* la meta */
  svg.appendChild(Kit.svg("line", {x1:668, y1:AGUA + 8, x2:668, y2:240, stroke:"#3f9b86", "stroke-width":2,
    "stroke-dasharray":"5 5"}));
  const m = Kit.svg("text", {x:662, y:AGUA + 24, "text-anchor":"end", "font-size":13, "font-weight":700, fill:"#3f9b86"});
  m.textContent = destino().length > 34 ? destino().slice(0, 33) + "…" : destino();
  svg.appendChild(m);
  /* los ganchos */
  hooks.forEach((h, i) => {
    const tirando = pez.modo === "tirado" && pez.i === i;
    const yCebo = tirando ? Math.min(150, pez.y) : 150;
    svg.appendChild(Kit.svg("line", {x1:h.x, y1:0, x2:h.x, y2:yCebo - 10, stroke:"#6b7280", "stroke-width":1.2}));
    svg.appendChild(Kit.svg("path", {d:`M${h.x} ${yCebo - 10} v12 a6 6 0 0 1 -12 0`, fill:"none",
      stroke:"#6b7280", "stroke-width":2}));
    if(!tirando) svg.appendChild(Kit.svg("ellipse", {cx:h.x, cy:yCebo + 1, rx:7, ry:4,
      fill:h.estado === "notado" ? "#b8c9c4" : "#c26a4e"}));
    const t = Kit.svg("text", {x:h.x > 460 ? h.x - 9 : h.x + 9, "text-anchor":h.x > 460 ? "end" : "start",
      y:120 - (i % 2) * 22, "font-size":12, fill:h.estado === "notado" ? "#7a8b86" : "#8a3d2e",
      "font-weight":600});
    t.textContent = h.txt.length > 20 ? h.txt.slice(0, 19) + "…" : h.txt;
    svg.appendChild(t);
  });
  /* el pez */
  const g = Kit.svg("g", {transform:`translate(${pez.x} ${pez.y})` + (pez.modo === "tirado" ? " rotate(-35)" : "")});
  g.appendChild(Kit.svg("path", {d:"M-16 0 L-30 -10 L-30 10 Z", fill:"#e0a34a"}));
  g.appendChild(Kit.svg("ellipse", {cx:0, cy:0, rx:20, ry:11, fill:"#f0b75a", stroke:"#c98a2c", "stroke-width":1.2}));
  g.appendChild(Kit.svg("circle", {cx:10, cy:-3, r:2.2, fill:"#333"}));
  svg.appendChild(g);
}

function siguienteGancho(){
  for(let i = 0; i < hooks.length; i++) if(!hooks[i].estado && hooks[i].x > pez.x) return i;
  return -1;
}

function botones(esperando){
  $("btnMorder").hidden = !esperando;
  $("btnNotar").hidden = !esperando;
  $("btnArrancar").hidden = esperando;
}

const reloj = Kit.reloj(dt => {
  pez.t += dt;
  if(pez.modo === "nada"){
    pez.x += VEL * dt;
    pez.y = PEZ_Y + Math.sin(pez.t * 3) * 3;
    const i = siguienteGancho();
    if(i >= 0 && pez.x >= hooks[i].x - 36){
      pez.modo = "espera"; pez.i = i; reloj.parar(); botones(true);
      $("fase").textContent = "Aparece: " + hooks[i].txt;
      $("faseSub").textContent = "¿Qué pasa ahora?";
    } else if(pez.x >= META){
      pez.modo = "quieto"; reloj.parar();
      $("fase").textContent = "Llegó a " + destino();
      $("faseSub").textContent = "Los ganchos siguen en el agua. Lo que cambió fue notarlos.";
      $("btnArrancar").textContent = "Otra vuelta";
      Kit.brindis("Llegó");
    }
  } else if(pez.modo === "rodea"){
    const h = hooks[pez.i], ini = h.x - 36, fin = h.x + 40;
    pez.x += VEL * dt;
    const p = Math.min(1, (pez.x - ini) / (fin - ini));
    pez.y = PEZ_Y + Math.sin(Math.PI * p) * 32;
    if(pez.x >= fin){ h.estado = "notado"; pez.modo = "nada"; pez.y = PEZ_Y; }
  } else if(pez.modo === "tirado"){
    const h = hooks[pez.i], p = Math.min(1, pez.t / 2.2);
    if(p < .3){ const q = p / .3; pez.x = pez.desdeX + (h.x - pez.desdeX) * q; pez.y = pez.desdeY + (150 - pez.desdeY) * q; }
    else { const q = (p - .3) / .7; pez.x = h.x - q * (h.x - ORILLA); pez.y = 150 - q * 110; }
    if(p >= 1){
      hooks.forEach(k => k.estado = null);
      pez = {x:ORILLA, y:PEZ_Y, modo:"quieto", t:0, i:-1};
      reloj.parar();
      $("btnArrancar").textContent = "Seguir nadando";
    }
  }
  dibujar();
});

function arrancar(){
  if(!hooks.length){ $("fase").textContent = "Primero, los ganchos"; $("faseSub").textContent = "Se eligen arriba."; return; }
  if(reloj.anda()) return;
  if(pez.x >= META){ hooks.forEach(k => k.estado = null); pez.x = ORILLA; }
  pez.modo = "nada"; pez.t = 0;
  $("fase").textContent = "Nadando hacia " + destino();
  $("faseSub").textContent = "";
  botones(false);
  $("btnArrancar").textContent = "Nadando…";
  reloj.andar();
}
function morder(){
  const h = hooks[pez.i];
  mordidos++; pintarMarcas();
  pez.modo = "tirado"; pez.t = 0; pez.desdeX = pez.x; pez.desdeY = pez.y;
  botones(false);
  $("btnArrancar").textContent = "Arrastrado…";
  $("fase").textContent = LINEAS[h.txt] ? "Mordió: " + LINEAS[h.txt] : "Mordió";
  $("faseSub").textContent = "Y vuelve a empezar, más lejos de " + destino() + ".";
  reloj.andar();
}
function notar(){
  notados++; pintarMarcas();
  pez.modo = "rodea"; pez.t = 0;
  botones(false);
  $("btnArrancar").textContent = "Nadando…";
  $("fase").textContent = "Lo nota como gancho";
  $("faseSub").textContent = "Y sigue nadando hacia " + destino() + ".";
  reloj.andar();
}
function reiniciar(){
  reloj.parar();
  armarGanchos();
  pez = {x:ORILLA, y:PEZ_Y, modo:"quieto", t:0, i:-1};
  notados = mordidos = 0; pintarMarcas();
  botones(false);
  $("btnArrancar").textContent = "Soltar el pez";
  $("fase").textContent = hooks.length ? "Listo" : "Elige los ganchos y empieza";
  $("faseSub").textContent = "";
  dibujar();
}
function pintarMarcas(){ $("mNotados").textContent = notados; $("mMordidos").textContent = mordidos; }

function leer(){
  pintarLineas();
  if(!reloj.anda() && pez.modo !== "espera"){
    const antes = hooks.map(h => h.txt).join("|");
    armarGanchos();
    if(hooks.map(h => h.txt).join("|") !== antes) reiniciar();
  }
  dibujar();
}

function resumen(){
  const l = [];
  const i = Kit.activas("importa");
  if(i.length) l.push("Hacia dónde nada: " + i.join(", "));
  const c = Kit.activas("cebos");
  if(c.length){
    l.push("", "GANCHOS (cebo → lo que hace después)");
    c.forEach(t => l.push("  " + t + " → " + (LINEAS[t] || "—")));
  }
  const s = Kit.activas("seDa");
  if(s.length) l.push("", "Cómo se da cuenta de que mordió: " + s.join(", "));
  const p = Kit.activas("practica");
  if(p.length) l.push("", "PRÁCTICA: " + p.join(", "));
  return l.join("\n");
}

Kit.chips("importa", IMPORTA, leer);
Kit.chips("cebos", CEBOS, leer);
Kit.chips("seDa", SEDA);
Kit.chips("practica", PRACTICA);
armarGanchos(); dibujar();

Kit.iniciar({ clave: "act-los-ganchos", alCambiar: leer, resumen: resumen,
  extra: () => ({lineas: LINEAS}), restaurar: d => { LINEAS = d.lineas || {}; } });
