@@meta
archivo: met-la-cuerda.html
titulo: La cuerda y el monstruo
orden: 03
enfoque: Metáforas vivas
etiqueta: Aceptación
sub: Hay un monstruo al otro lado de un hoyo sin fondo y una cuerda entre los dos. En cuanto empieza, él jala solo: no espera a que decidas nada. Jalar te devuelve unos centímetros y le da fuerza a él, así que cada vez duran menos. Soltar no lo hace desaparecer ni lo hace caer, y es lo único que detiene el arrastre.
fuente: Metáfora de la lucha con el monstruo y el control como problema, en Díaz Corbobés, MANUAL ACT §3.2, dentro del trabajo de desesperanza creativa y aceptación.
resumen: El monstruo jala en tiempo real y el borde se acerca solo. Jalar da centímetros prestados que cada vez rinden menos; soltar detiene el arrastre y deja las manos libres, con el monstruo todavía de pie.
campo3: Sesión
campo3ph: Ej. Sesión 4
@@css
  button.jalar{background:#8a3d3d;border-color:#8a3d3d;color:#fff;font-weight:600}
  button.jalar:hover{background:#763333;border-color:#763333}
  button.jalar:disabled{background:#d3bdbd;border-color:#d3bdbd}
  button.soltar{background:#3f7d5a;border-color:#3f7d5a;color:#fff;font-weight:600}
  button.soltar:hover{background:#356b4d;border-color:#356b4d}
  button.arranque{background:#2f6f8f;border-color:#2f6f8f;color:#fff;font-weight:600}
  button.arranque:hover{background:#28607c;border-color:#28607c}

  /* el globo que se abre sobre el sujeto cuando suelta la cuerda */
  .bocadillo{position:relative;max-width:520px;margin:16px auto 4px;border:2px solid #3f7d5a;
    border-radius:14px;padding:13px 16px;background:#f4faf6}
  /* la punta mira hacia arriba, hacia la persona que acaba de soltar */
  .bocadillo::after{content:"";position:absolute;left:26%;top:-11px;width:18px;height:18px;
    background:#f4faf6;border-left:2px solid #3f7d5a;border-top:2px solid #3f7d5a;
    transform:rotate(45deg)}
  .bocadillo .titulin{font-size:11px;text-transform:uppercase;letter-spacing:.7px;font-weight:700;
    color:#3f7d5a;margin-bottom:8px}
  .bocadillo .chip.activa{background:#3f7d5a;border-color:#3f7d5a}
  .bocadillo .chip.mas{color:#3f7d5a}

  .pregunta-sola{border-left-color:#8a3d3d;background:linear-gradient(180deg,#fdf7f5,#fff)}
  .pregunta-sola.libre{border-left-color:#3f7d5a;background:linear-gradient(180deg,#f4faf6,#fff)}
  .pregunta-sola.libre .pregunta{color:#2c5a44}
@@html
<section class="paso">
  <h2><span class="num">1</span>¿Con quién estás jalando?</h2>
  <p class="ayuda">No es una persona ni una situación: es lo de adentro contra lo que llevas años
  haciendo fuerza.</p>
  <div class="cuerpo">
    <div class="chips" id="monstruo"></div>
    <div class="medidor" style="margin-top:16px">
      <label for="tamano">Qué tan grande está hoy</label>
      <input type="range" id="tamano" min="1" max="10" value="6">
      <span class="valor" id="vTamano">6</span>
    </div>
  </div>
</section>

<div class="escenario">
  <svg id="tira" viewBox="0 0 700 340" role="img"
    aria-label="Tira y afloja con el monstruo sobre un hoyo sin fondo"></svg>

  <div class="bocadillo" id="bocadillo" hidden>
    <div class="titulin">Con las manos libres</div>
    <div class="chips" id="manosLibres"></div>
  </div>

  <div class="marcas">
    <div><span class="n" id="mJalones" style="color:#8a3d3d">0</span><span class="r">jalones</span></div>
    <div><span class="n" id="mBorde" style="color:#8a3d3d">100</span><span class="r">cm del borde</span></div>
    <div><span class="n" id="mSuelo" style="color:#3f7d5a">0</span><span class="r">seg. con la cuerda en el suelo</span></div>
    <div><span class="n" id="mCaidas" style="color:#8a3d3d">0</span><span class="r">veces que cayó él</span></div>
  </div>
  <div class="mandos">
    <button type="button" class="arranque" id="btnArrancar" onclick="arrancar()">Empezar</button>
    <button type="button" class="jalar" id="btnJalar" onclick="jalar()">Jalar más fuerte</button>
    <button type="button" class="soltar" id="btnSoltar" onclick="soltar()">Soltar la cuerda</button>
    <button type="button" id="btnRetomar" onclick="retomar()" hidden>Volver a jalar</button>
    <button type="button" onclick="reiniciar()">Reiniciar</button>
  </div>
</div>

<section class="bloque pregunta-sola" id="relato">
  <div class="pregunta" id="preguntaRelato"></div>
</section>
@@js
const $ = Kit.$;

const MONSTRUOS = ["La ansiedad","La tristeza","La culpa","El miedo a fallar"];
const MANOS = ["Salir de la casa","Estar con mi gente"];

let jalones = 0, soltada = false, caido = false;
let borde = 100;               /* centímetros que faltan para el borde del hoyo */
let suelo = 0, mejorSuelo = 0; /* segundos seguidos con la cuerda en el suelo   */
let arrastrado = 0;            /* centímetros que ganó él sin que hicieras nada */
let fase = 0, rugidos = [], proximoRugido = 1.1, ultimaPregunta = "";

const nombres = () => Kit.activas("monstruo");
/* Cada jalón lo hace más grande. Al soltar baja un poco y ahí se queda:
   no se va, no se cae, solo deja de alimentarse de la fuerza. */
const tamano = () => {
  const base = Math.min(10, +$("tamano").value + jalones * .6);
  return soltada ? Math.max(1, base - 1) : base;
};
/* Lo que él jala por segundo. Empieza bajo y crece con cada jalón tuyo: por eso
   los centímetros que recuperas cada vez te duran menos. */
const arrastre = () => 2.4 + jalones * .95;

/* ====================== EL LATIDO ====================== */
const escena = Kit.reloj(latido);

function latido(dt){
  fase += dt;

  if(!soltada && !caido){
    const antes = borde;
    borde = Math.max(0, borde - arrastre() * dt);
    arrastrado += antes - borde;
    if(borde <= 0){
      caido = true;
      Kit.brindis("Te caíste al hoyo. Él sigue de pie.");
      botones();
      Kit.guardar();
    }
  }
  if(soltada){
    suelo += dt;
    if(suelo > mejorSuelo) mejorSuelo = suelo;
  }

  /* Ruge igual: cuando jalas, cuando sueltas y cuando no haces nada. */
  proximoRugido -= dt;
  if(proximoRugido <= 0){
    const l = nombres();
    if(l.length) rugidos.push({texto:l[Math.floor(Math.random() * l.length)], t:0});
    proximoRugido = 2.1 + Math.random() * 1.5;
  }
  rugidos.forEach(r => { r.t += dt; });
  rugidos = rugidos.filter(r => r.t < 2.4);

  marcas();
  dibujar();
  preguntar();
}

/* ====================== FIGURAS ====================== */
/* El monstruo: patas, brazos, melena de lobo y hocico. Crece de verdad. */
let spriteMonstruo = null;
function monstruo(padre, x, base, alto, col){
  if(!spriteMonstruo) spriteMonstruo=Kit.svg("image", {href:"[[imagen:monstruo-acuarela.png]]", preserveAspectRatio:"xMidYMid meet"});
  const h=alto*1.26, w=h*.84, izquierda=x-w*.47, arriba=base-h;
  Object.entries({x:izquierda,y:arriba,width:w,height:h}).forEach(([k,v])=>spriteMonstruo.setAttribute(k,v));
  padre.appendChild(spriteMonstruo);
  return {mano:[izquierda+w*.06,arriba+h*.35],cabeza:[x+w*.15,arriba+5]};
}

/* La persona: cabeza, pelo, tronco, dos brazos y dos piernas afianzadas. */
function persona(padre, x, base, col, estado, tiembla){
  const g = (t, a) => padre.appendChild(Kit.svg(t, a));
  const cad = base - 46, hom = base - 84, cab = base - 98;

  if(estado === "caido"){
    /* dentro del hoyo, con los brazos arriba */
    const y = base + 26;
    g("circle", {cx:x, cy:y, r:11, fill:col});
    g("path", {d:`M${x - 5} ${y - 8} q 5 -7 10 0`, stroke:"#2c3a48", "stroke-width":3,
      fill:"none", "stroke-linecap":"round"});
    g("path", {d:`M${x} ${y + 11} L${x} ${y + 26}`, stroke:col, "stroke-width":6,
      "stroke-linecap":"round"});
    g("path", {d:`M${x} ${y + 15} L${x - 16} ${y - 2} M${x} ${y + 15} L${x + 16} ${y - 2}`,
      stroke:col, "stroke-width":5, "stroke-linecap":"round"});
    return {mano:[x, y - 2]};
  }

  const suelta = estado === "suelta";
  const inc = suelta ? 0 : -7 + tiembla;
  const piel="#b88c6c", pantalon="#455660", camisa=suelta?"#65907b":"#718ba0";
  // Pantalón con volumen y botas; el cuerpo acompaña la tensión de la cuerda.
  g("path",{d:`M${x-8} ${cad-3} L${x+9} ${cad-3} L${x+21} ${base-5} Q${x+16} ${base} ${x+10} ${base-4} L${x} ${cad+16} L${x-8} ${base-4} L${x-19} ${base-4} Z`,fill:pantalon});
  g("path",{d:`M${x-19} ${base-7} Q${x-29} ${base-4} ${x-25} ${base} L${x-7} ${base} L${x-7} ${base-7} Z M${x+10} ${base-7} L${x+21} ${base-7} Q${x+31} ${base-4} ${x+28} ${base} L${x+10} ${base} Z`,fill:"#534c40"});
  g("path",{d:`M${x+inc-10} ${hom+2} Q${x+inc} ${hom-4} ${x+inc+10} ${hom+3} L${x+10} ${cad+3} Q${x} ${cad+8} ${x-10} ${cad+2} Z`,fill:camisa,stroke:"#5c7582","stroke-width":.7});
  g("path",{d:`M${x+inc-5} ${hom+9} Q${x+inc+1} ${hom+24} ${x-4} ${cad}`,stroke:"#fff","stroke-width":2,opacity:.17,fill:"none"});
  g("path",{d:`M${x+inc-4} ${cab+8} L${x+inc-3} ${hom+3} Q${x+inc+4} ${hom+7} ${x+inc+6} ${hom} L${x+inc+5} ${cab+7} Z`,fill:piel});
  g("ellipse",{cx:x+inc,cy:cab,rx:10,ry:13,fill:piel});
  g("path",{d:`M${x+inc-9} ${cab+4} Q${x+inc-16} ${cab-12} ${x+inc-4} ${cab-15} Q${x+inc+10} ${cab-17} ${x+inc+11} ${cab-5} Q${x+inc+3} ${cab-10} ${x+inc-5} ${cab-5} L${x+inc-5} ${cab+4} Z`,fill:"#3d3e39"});
  g("path",{d:`M${x+inc+8} ${cab-3} l4 6 -4 1`,fill:piel});
  g("circle",{cx:x+inc+6,cy:cab-2,r:1.1,fill:"#3c3934"});

  let mano;
  if(suelta){
    /* un brazo relajado, el otro señalando hacia adelante */
    g("path", {d:`M${x} ${hom + 5} q -12 12 -14 24`, stroke:camisa, "stroke-width":7,
      fill:"none", "stroke-linecap":"round"});
    g("path", {d:`M${x} ${hom + 5} q 14 8 20 2`, stroke:camisa, "stroke-width":7,
      fill:"none", "stroke-linecap":"round"});
    mano = [x + 20, hom + 7];
  } else {
    /* las dos manos agarradas a la cuerda */
    g("path", {d:`M${x + inc} ${hom + 4} L${x + 20} ${hom + 2}`, stroke:camisa, "stroke-width":7,
      "stroke-linecap":"round"});
    g("path", {d:`M${x + inc} ${hom + 10} L${x + 26} ${hom + 6}`, stroke:camisa, "stroke-width":7,
      "stroke-linecap":"round"});
    mano = [x + 26, hom + 4];
  }
  g("ellipse",{cx:mano[0],cy:mano[1],rx:4,ry:3,fill:piel});
  return {mano};
}

/* ====================== ESCENA ====================== */
function dibujar(){
  const svg = $("tira");
  svg.innerHTML = "";
  const g = (t, a, p) => (p || svg).appendChild(Kit.svg(t, a));
  const texto = (x, y, s, estilo) => {
    const t = Kit.svg("text", {x, y, "text-anchor":"middle", style:estilo});
    t.textContent = s;
    svg.appendChild(t);
  };

  const SUELO = 250, HX0 = 260, HX1 = 440;

  g("rect", {x:0, y:0, width:700, height:SUELO, fill:"#f8f5ea"});
  g("rect", {x:0, y:SUELO, width:HX0, height:340 - SUELO, fill:"#c5af8a"});
  g("rect", {x:HX1, y:SUELO, width:700 - HX1, height:340 - SUELO, fill:"#c5af8a"});

  const defs = Kit.svg("defs", {});
  const hoyo = Kit.svg("linearGradient", {id:"hoyo", x1:"0", y1:"0", x2:"0", y2:"1"});
  hoyo.appendChild(Kit.svg("stop", {offset:"0", "stop-color":"#4a4034"}));
  hoyo.appendChild(Kit.svg("stop", {offset:"1", "stop-color":"#120f0c"}));
  defs.appendChild(hoyo);
  svg.appendChild(defs);
  g("rect", {x:HX0, y:SUELO, width:HX1 - HX0, height:340 - SUELO, fill:"url(#hoyo)"});
  g("ellipse", {cx:(HX0 + HX1) / 2, cy:SUELO, rx:(HX1 - HX0) / 2, ry:11, fill:"#241e18"});

  // Orillas orgánicas: el centro permanece despejado para leer la acción.
  g("path", {d:"M0 248 Q55 242 107 250 T212 248 L260 250 L252 258 Q164 249 82 260 L0 259 Z",fill:"#71866b"});
  g("path", {d:"M440 250 Q490 241 545 249 T700 246 L700 260 Q561 257 449 260 Z",fill:"#71866b"});
  for(let k=0;k<9;k++){
    const xx=18+k*27;g("path",{d:`M${xx} 255 q-4 -12 -7 -15 M${xx} 255 q2 -9 6 -13`,stroke:"#617a59","stroke-width":1.5,fill:"none",opacity:.6});
  }
  const t = tamano();
  /* respira: el alto late un poco aunque nadie toque nada */
  const alto = (52 + t * 11) * (1 + Math.sin(fase * 1.7) * .018);
  const mx = HX1 + 92;
  const mCol = Kit.mezcla("#9a8fa8", "#5c3f6e", t / 10);

  const tenso = escena.anda() && !soltada && !caido;
  const tiembla = tenso ? Math.sin(fase * 21) * 1.3 : 0;
  const px = caido ? (HX0 + HX1) / 2 - 6 : HX0 - 30 - borde * 1.55;
  const pCol = soltada ? "#3f7d5a" : "#3f5163";

  const capaM = Kit.svg("g", {});
  svg.appendChild(capaM);
  const m = monstruo(capaM, mx, SUELO, alto, mCol);

  const capaP = Kit.svg("g", {});
  svg.appendChild(capaP);
  const p = persona(capaP, px, SUELO, pCol, caido ? "caido" : soltada ? "suelta" : "jala", tiembla);

  if(soltada){
    /* la cuerda tirada en el suelo, de un lado al otro del hoyo */
    g("path", {d:`M${px + 24} ${SUELO - 2} q 40 10 ${HX0 - px - 40} 6`,
      stroke:"#b9a98c", "stroke-width":3.5, fill:"none", "stroke-linecap":"round", opacity:.8});
    g("path", {d:`M${HX1 + 4} ${SUELO - 4} Q ${m.mano[0] - 20} ${SUELO + 2} ${m.mano[0]} ${m.mano[1]}`,
      stroke:"#b9a98c", "stroke-width":3.5, fill:"none", "stroke-linecap":"round", opacity:.8});
    /* El globo va por encima de la cabeza, no apoyado en ella: la coronilla
       queda en SUELO-110 y la cola del globo baja 49 px desde su borde, así
       que la caja arranca en SUELO-172 y quedan unos treinta píxeles de aire. */
    globo(svg, px, SUELO - 172, Kit.activas("manosLibres"));
  } else {
    /* la cuerda tensa por encima del hoyo: se comba menos cuanto más se jala */
    const combado = caido ? 40
      : Math.max(4, 26 - jalones * 2) + (tenso ? Math.sin(fase * 15) * 1.6 : 0);
    g("path", {d:`M${p.mano[0]} ${p.mano[1]} Q ${(px + mx) / 2} ${p.mano[1] + combado} ` +
      `${m.mano[0]} ${m.mano[1]}`, stroke:"#8a7a5f", "stroke-width":4, fill:"none",
      "stroke-linecap":"round"});
  }

  /* lo que grita mientras tanto, jales o no jales */
  rugidos.forEach(r => {
    const op = r.t < .3 ? r.t / .3 : Math.max(0, 1 - (r.t - .3) / 2.1);
    const y = m.cabeza[1] - 12 - r.t * 26;
    const corto = r.texto.length > 22 ? r.texto.slice(0, 21) + "…" : r.texto;
    texto(m.cabeza[0] + 26, y, "«" + corto + "»",
      `font:600 12.5px system-ui;fill:#5c3f6e;opacity:${op.toFixed(2)};` +
      `paint-order:stroke;stroke:#f5f9fb;stroke-width:3;stroke-linejoin:round`);
  });

  const et = nombres().length ? nombres().join(" · ") : "el monstruo";
  texto(mx, SUELO - alto - 34, et.length > 34 ? et.slice(0, 33) + "…" : et,
    `font:600 13px system-ui;fill:${mCol}`);
  texto(HX0 - 62, SUELO + 62, "un hoyo sin fondo", "font:11.5px system-ui;fill:#8a7f74");
}

/* Globo de pensamiento sobre la persona con lo que hará con las manos libres. */
function globo(svg, x, y, lista){
  const txt = lista.length ? lista.join(" · ") : "…";
  const corto = txt.length > 40 ? txt.slice(0, 39) + "…" : txt;
  const ancho = Math.max(76, 18 + corto.length * 6.6);
  const gg = Kit.svg("g", {transform:`translate(${x - ancho / 2},${y})`});
  svg.appendChild(gg);
  const p = (t, a) => gg.appendChild(Kit.svg(t, a));
  p("rect", {x:0, y:0, width:ancho, height:30, rx:15, fill:"#f4faf6", stroke:"#3f7d5a",
    "stroke-width":2});
  p("circle", {cx:ancho / 2 - 4, cy:38, r:5, fill:"#f4faf6", stroke:"#3f7d5a", "stroke-width":2});
  p("circle", {cx:ancho / 2 + 4, cy:49, r:3.2, fill:"#f4faf6", stroke:"#3f7d5a", "stroke-width":1.8});
  const t = Kit.svg("text", {x:ancho / 2, y:20, "text-anchor":"middle",
    style:"font:600 12px system-ui,sans-serif;fill:#2c5a44"});
  t.textContent = corto;
  gg.appendChild(t);
}

/* ====================== ACCIONES ====================== */
function arrancar(){
  if(!nombres().length){ Kit.brindis("Primero dile cómo se llama"); return; }
  if(caido){ Kit.brindis("Ya estás dentro del hoyo. Solo queda soltar."); return; }
  escena.andar();
  botones();
  Kit.guardar();
}

function jalar(){
  if(!nombres().length){ Kit.brindis("Primero dile cómo se llama"); return; }
  if(caido){ Kit.brindis("Ya estás dentro del hoyo. Solo queda soltar."); return; }
  if(!escena.anda()) escena.andar();
  /* jalar devuelve unos centímetros y le da fuerza a él: la próxima vez
     los mismos centímetros duran menos */
  borde = Math.min(100, borde + 6);
  jalones++;
  soltada = false;
  suelo = 0;
  $("btnRetomar").hidden = true;
  $("bocadillo").hidden = true;
  botones();
  Kit.guardar();
}

function soltar(){
  if(!nombres().length){ Kit.brindis("Primero dile cómo se llama"); return; }
  soltada = true;
  suelo = 0;
  if(caido){                    /* sale del hoyo, pero queda justo en el borde */
    caido = false;
    borde = 14;
  }
  escena.andar();               /* la escena sigue: él no se detiene contigo */
  $("btnRetomar").hidden = false;
  $("bocadillo").hidden = false;
  botones();
  Kit.guardar();
  setTimeout(() => $("bocadillo").scrollIntoView({behavior:"smooth", block:"center"}), 350);
}

function retomar(){
  soltada = false;
  suelo = 0;
  $("btnRetomar").hidden = true;
  $("bocadillo").hidden = true;
  escena.andar();
  botones();
  Kit.guardar();
}

function reiniciar(){
  escena.parar();
  jalones = 0; soltada = false; caido = false;
  borde = 100; suelo = 0; mejorSuelo = 0; arrastrado = 0;
  rugidos = []; proximoRugido = 1.1;
  $("btnRetomar").hidden = true;
  $("bocadillo").hidden = true;
  refrescar();
  Kit.guardar();
}

function botones(){
  $("btnJalar").disabled = caido;
  $("btnArrancar").disabled = escena.anda();
}

function marcas(){
  $("mJalones").textContent = jalones;
  $("mBorde").textContent   = Math.round(borde);
  $("mSuelo").textContent   = Math.floor(suelo);
  $("mCaidas").textContent  = 0;
}

/* Al cargar y cuando cambia una ficha: pinta sin depender del latido. */
function refrescar(){
  $("vTamano").textContent = $("tamano").value;
  botones();
  marcas();
  dibujar();
  preguntar();
}

function preguntar(){
  const rel = $("relato");
  rel.classList.toggle("libre", soltada);
  let q;
  if(soltada && suelo >= 15)
    q = `Llevas ${Math.floor(suelo)} segundos sin jalar y él sigue ahí. ¿Qué ha pasado contigo en estos segundos?`;
  else if(soltada)
    q = "¿Qué cosas dejaste de hacer todos estos años porque tenías las manos ocupadas?";
  else if(caido)
    q = "Estás dentro del hoyo y él sigue arriba. ¿Qué te queda por probar?";
  else if(!nombres().length)
    q = "¿Qué es eso que más quisieras que no estuviera?";
  else if(!escena.anda() && jalones === 0)
    q = "¿Cómo se ve, en tu vida real, ese jalar más fuerte?";
  else if(jalones === 0)
    q = "Él ya está jalando y tú todavía no has hecho nada. ¿Se parece a algo?";
  else if(jalones < 4)
    q = "¿Cuánto te duró lo que ganaste con ese jalón?";
  else
    q = "Si esto no se puede ganar jalando, ¿qué es lo que no has probado?";
  if(q !== ultimaPregunta){
    $("preguntaRelato").textContent = q;
    ultimaPregunta = q;
  }
}

/* ====================== RESUMEN ====================== */
function resumen(){
  const l = [];
  l.push("EL MONSTRUO");
  l.push(nombres().length ? nombres().join(" · ") : "(sin nombrar)");
  l.push(`Tamaño declarado al empezar: ${$("tamano").value}/10`);
  l.push("", `TIRA Y AFLOJA: ${jalones} jalones, monstruo en ${tamano().toFixed(1)}, ` +
             `${Math.round(borde)} cm del borde, ${Math.round(arrastrado)} cm arrastrados por él, ` +
             `0 caídas del monstruo.`);
  l.push("Cayó al hoyo en sesión: " + (caido ? "sí" : "no"));
  l.push("Soltó la cuerda en sesión: " + (soltada ? "sí" : "no"));
  l.push(`Racha más larga con la cuerda en el suelo: ${Math.floor(mejorSuelo)} segundos.`);

  const m = Kit.activas("manosLibres");
  if(m.length) l.push("", "QUÉ HARÁ CON LAS MANOS LIBRES", m.join(", "));
  return l.join("\n");
}

Kit.chips("monstruo", MONSTRUOS, refrescar);
Kit.chips("manosLibres", MANOS, refrescar);
$("tamano").addEventListener("input", refrescar);

Kit.iniciar({
  clave: "met-la-cuerda",
  extra: () => ({jalones, soltada, caido, borde, mejorSuelo, arrastrado}),
  restaurar: d => {
    jalones = d.jalones || 0; soltada = !!d.soltada; caido = !!d.caido;
    borde = d.borde === undefined ? 100 : d.borde;
    mejorSuelo = d.mejorSuelo || 0; arrastrado = d.arrastrado || 0;
    if(soltada){ $("bocadillo").hidden = false; $("btnRetomar").hidden = false; }
  },
  alCambiar: refrescar,
  resumen: resumen
});
