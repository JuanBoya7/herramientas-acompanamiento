@@meta
archivo: met-trampa-china.html
titulo: La trampa china de dedos
enfoque: ACT
etiqueta: Aceptación
sub: Dos dedos dentro de un tubo trenzado. El impulso de tirar llega solo; tirar (botón mantenido) estira y cierra el tejido, y acercar los dedos lo ensancha.
fuente: Metáfora de la trampa china de dedos (Hayes, Strosahl y Wilson, 1999, cap. 3; Eifert y Forsyth, 2005; Díaz Corbobés, MANUAL ACT).
resumen: El tirón aparece solo cada tanto. Mantener «Tirar» alarga y angosta el tubo sobre los dedos; soltar el botón no lo afloja. Cada acercamiento lo ensancha hasta dejar holgura para mover los dedos. El marcador cuenta las veces que se volvió a acercar.
@@css
  .marcas div{min-width:130px}
  .mandos button.tirar{background:#8a3d3d;border-color:#8a3d3d;color:#fff;font-weight:600;touch-action:none;user-select:none}
  .mandos button.tirar:hover{background:#763333;border-color:#763333}
  .mandos button.acercar{background:#2f7a5f;border-color:#2f7a5f;color:#fff;font-weight:600}
  .mandos button.acercar:hover{background:#27674f;border-color:#27674f}
@@html
<section class="paso">
  <h2><span class="num">1</span>Lo que hoy tienes entre los dedos</h2>
  <div class="cuerpo">
    <div class="chips" id="siente">
      <button class="chip" data-v="La opresión en el pecho antes de hablar">La opresión en el pecho antes de hablar</button>
      <button class="chip" data-v="El nudo de no saber qué va a pasar">El nudo de no saber qué va a pasar</button>
      <button class="chip" data-v="El recuerdo que vuelve sin permiso">El recuerdo que vuelve sin permiso</button>
      <button class="chip" data-v="El temor a equivocarme frente a otros">El temor a equivocarme frente a otros</button>
    </div>
    <label class="etiqueta">Cómo tiras hacia afuera cuando aparece</label>
    <div class="chips" id="tiron">
      <button class="chip" data-v="Repasar mil veces lo que voy a decir">Repasar mil veces lo que voy a decir</button>
      <button class="chip" data-v="Exigirme estar tranquilo ya">Exigirme estar tranquilo ya</button>
      <button class="chip" data-v="Posponer o cancelar">Posponer o cancelar</button>
      <button class="chip" data-v="Distraerme con el teléfono">Distraerme con el teléfono</button>
    </div>
  </div>
</section>

<div class="escenario">
  <svg id="lienzo" viewBox="0 0 700 300" role="img" aria-label="Dos manos con los índices dentro de un tubo trenzado de bambú"></svg>
  <div class="marcas">
    <div><span class="n" id="mVolvi" style="color:#2f7a5f">0</span><span class="r">veces que volví a acercarme</span></div>
  </div>
  <div class="mandos">
    <button type="button" class="tirar" id="bTirar">Tirar hacia afuera (mantener apretado)</button>
    <button type="button" class="acercar" id="bAcercar">Acercar los dedos</button>
    <button type="button" id="bReiniciar">Empezar de nuevo</button>
  </div>
</div>

<section class="bloque pregunta-sola" id="cierre">
  <div class="pregunta" id="textoPregunta">El cuerpo pide tirar, y el tubo responde cerrándose. ¿Qué pasa con lo que sientes cuando haces exactamente lo que el impulso pide?</div>
  <details class="apunte">
    <summary>Anotar lo conversado</summary>
    <textarea id="apunte" placeholder="Qué sería hoy acercarte un milímetro en vez de jalar..."></textarea>
  </details>
</section>
@@js
const $ = Kit.$;
Kit.chips("siente", {multiple:false, libre:true});
Kit.chips("tiron", {multiple:false, libre:true});

const CX = 350, CY = 150;
const MANO = {href:"[[imagen:trampa-mano.webp]]", r:2.455, punta:0.27};   // punta: altura relativa de la yema
const ALTO_MANO = 185;

let tension, tirando, volvi, debe, t, sigImpulso, sacude;
function reiniciar(){
  tension = 0.45;      // 0 = holgado, 1 = cerrado sobre los dedos
  tirando = false; volvi = 0; debe = false; t = 0; sigImpulso = 5; sacude = 0;
  $("textoPregunta").textContent = "El cuerpo pide tirar, y el tubo responde cerrándose. ¿Qué pasa con lo que sientes cuando haces exactamente lo que el impulso pide?";
}
reiniciar();

const escena = Kit.reloj(latido);
function latido(dt){
  t += dt;
  sacude = Math.max(0, sacude - dt * 2.5);
  if(tirando){ tension = Math.min(1, tension + dt * 0.45); sacude = 1; debe = true; }
  /* el impulso de tirar llega solo: un tirón corto que nadie decidió */
  sigImpulso -= dt;
  if(sigImpulso <= 0){
    if(!tirando && tension < 0.95){ tension = Math.min(1, tension + 0.09); sacude = 1; debe = true; }
    sigImpulso = 5 + Math.random() * 5;
  }
  dibujar();
}

function dibujar(){
  const svg = $("lienzo");
  svg.innerHTML = "";
  const g = (tg, a, p) => (p || svg).appendChild(Kit.svg(tg, a));
  const dd = Kit.svg("defs", {});
  svg.appendChild(dd);
  g("rect", {x:0, y:0, width:700, height:300, rx:12, fill:"#f8f4ea"});
  g("ellipse", {cx:CX, cy:CY + 6, rx:310, ry:118, fill:"#cfdcd8", opacity:.75, filter:Kit.acuarela(svg)});

  /* a más tensión, el tubo es más largo y más angosto, y las manos se separan */
  const largo = 170 + tension * 170, alto = 70 - tension * 34;
  const x0 = CX - largo / 2, x1 = CX + largo / 2;
  const tiembla = sacude > 0 ? Math.sin(t * 60) * 2.2 * sacude : 0;
  const holgura = tension < 0.15 ? Math.sin(t * 2.2) * 5 * (1 - tension / 0.15) : 0;   // con espacio, los dedos se mueven

  /* manos: la yema entra en el tubo; la derecha es la misma imagen en espejo */
  const w = ALTO_MANO * MANO.r, dentro = 52;
  [-1, 1].forEach(lado => {
    const boca = lado < 0 ? x0 : x1;
    const gm = Kit.svg("g", {transform:`translate(${(boca - lado * (dentro) + lado * tiembla).toFixed(1)} ${(CY + (lado < 0 ? holgura : -holgura)).toFixed(1)}) scale(${-lado} 1)`});
    gm.appendChild(Kit.figura("mano" + lado, MANO.href, {x:-w, y:-ALTO_MANO * MANO.punta, width:w, height:ALTO_MANO}));
    svg.appendChild(gm);
  });

  /* el tubo trenzado: dos familias de tiras que se cruzan; estirado, las tiras se acuestan */
  const forma = `M${x0} ${CY - alto / 2} Q${CX} ${CY - alto / 2 - 5 * (1 - tension)} ${x1} ${CY - alto / 2} L${x1} ${CY + alto / 2} Q${CX} ${CY + alto / 2 + 5 * (1 - tension)} ${x0} ${CY + alto / 2} Z`;
  dd.innerHTML = `<clipPath id="tcTubo"><path d="${forma}"/></clipPath>`;
  const tubo = Kit.svg("g", {filter:Kit.acuarela(svg)});
  svg.appendChild(tubo);
  g("path", {d:forma, fill:"#8a6a35"}, tubo);
  const trenza = Kit.svg("g", {"clip-path":"url(#tcTubo)"});
  tubo.appendChild(trenza);
  const paso = 13 + tension * 9, corre = alto * (0.9 + tension * 1.8), grosor = 7.5 - tension * 2.5;
  for(let x = x0 - corre; x < x1 + corre; x += paso){
    g("line", {x1:x, y1:CY - alto / 2 - 4, x2:x + corre, y2:CY + alto / 2 + 4, stroke:"#d9b872", "stroke-width":grosor}, trenza);
    g("line", {x1:x + corre, y1:CY - alto / 2 - 4, x2:x, y2:CY + alto / 2 + 4, stroke:"#c39f58", "stroke-width":grosor}, trenza);
  }
  g("path", {d:forma, fill:"none", stroke:"#6f5326", "stroke-width":2}, tubo);
  [x0, x1].forEach(x => g("ellipse", {cx:x, cy:CY, rx:5, ry:alto / 2, fill:"#5b4420", stroke:"#3f2f16", "stroke-width":1.5}, tubo));

  const rot = (y, s, color) => {
    if(!s) return;
    const e = Kit.svg("text", {x:CX, y, "text-anchor":"middle",
      style:`font:600 13.5px Georgia,serif;font-style:italic;fill:${color};paint-order:stroke;stroke:#fffaf0;stroke-width:4px;stroke-linejoin:round`});
    e.textContent = s.length > 56 ? s.slice(0, 54) + "…" : s; svg.appendChild(e);
  };
  rot(34, Kit.activas("siente")[0], "#3b3128");
  if(tirando) rot(60, Kit.activas("tiron")[0], "#7a3328");

  $("mVolvi").textContent = volvi;
  $("bAcercar").disabled = tension <= 0.02;
}

function tirar(si){ tirando = si; }
const bt = $("bTirar");
bt.addEventListener("pointerdown", () => tirar(true));
["pointerup", "pointerleave", "pointercancel"].forEach(ev => bt.addEventListener(ev, () => tirar(false)));
bt.addEventListener("keydown", ev => { if(ev.key === " " || ev.key === "Enter"){ ev.preventDefault(); tirar(true); } });
bt.addEventListener("keyup", () => tirar(false));

$("bAcercar").addEventListener("click", () => {
  tension = Math.max(0, tension - 0.24);
  if(debe){ volvi++; debe = false; }
  sigImpulso = Math.max(sigImpulso, 4);
  if(tension < 0.2) $("textoPregunta").textContent = "El tubo sigue ahí y ya no aprieta. Si hoy dejaras de jalar contra esa sensación, ¿qué movimiento pequeño te quedaría disponible?";
  Kit.guardar();
});
$("bReiniciar").addEventListener("click", () => { reiniciar(); Kit.guardar(); });

Kit.iniciar({
  clave: "met-trampa-china",
  alCambiar: dibujar,
  resumen: () => [
    "LA TRAMPA CHINA DE DEDOS",
    `Lo que hay en el tubo: ${Kit.activas("siente")[0] || "—"}`,
    `Forma habitual de tirar: ${Kit.activas("tiron")[0] || "—"}`,
    `Veces que volví a acercarme: ${volvi}`,
    $("apunte").value.trim() ? `Lo conversado: ${$("apunte").value.trim()}` : ""
  ].filter(Boolean).join("\n")
});
escena.andar();
