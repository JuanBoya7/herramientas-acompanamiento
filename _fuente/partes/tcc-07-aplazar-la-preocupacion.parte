@@meta
archivo: tcc-aplazar-la-preocupacion.html
titulo: Aplazar la preocupación
orden: 07
enfoque: Cognitivo-conductual
etiqueta: Metacognitiva
sub: El pensamiento que dispara la preocupación no se controla: aparece. Lo que sí se elige es lo que viene después. Frente a un desencadenante hay tres caminos: engancharse a preocuparse, intentar sacarlo o dejarlo ahí y aplazar la preocupación para más tarde. Es un experimento para poner a prueba la creencia de que la preocupación es incontrolable.
fuente: Mindfulness desapegado y aplazamiento de la preocupación, en Wells, Terapia metacognitiva para la ansiedad y la depresión, caps. 6 (ansiedad generalizada), 7 (estrés postraumático) y 9 (depresión).
resumen: Se califica cuánto se cree que la preocupación es incontrolable y se revisan las evidencias de que se detiene. Con un desencadenante se prueban los tres caminos y se ve qué pasa con cada uno. Queda acordado el momento para preocuparse, la frase para aplazar y la segunda calificación de la creencia.
@@css
  .mente{display:block;width:100%;height:auto;max-width:640px;margin:0 auto}
  .fase{font-size:19px;font-weight:700;text-align:center;margin:6px auto 2px;color:var(--acento);
    min-height:28px;max-width:600px}
  .fase-sub{text-align:center;font-size:14px;color:var(--tinta-suave);max-width:560px;margin:0 auto;min-height:40px;line-height:1.5}
  button.camino{font-weight:600}
  button.c1{border-color:#b0503f;color:#b0503f}
  button.c2{border-color:#8a6d3b;color:#8a6d3b}
  button.c3{background:#2f6f8f;border-color:#2f6f8f;color:#fff}
  .creencia{background:#f8fafc;border-radius:10px;padding:13px 16px}
  .creencia .medidor input[type=range]{accent-color:#2f6f8f}
@@html
<section class="paso">
  <h2><span class="num">1</span>¿Es incontrolable?</h2>
  <p class="ayuda">Una cifra de cuánto se cree hoy. Después, las veces en que la preocupación se
  detiene sola porque algo más reclama la atención.</p>
  <div class="cuerpo">
    <div class="creencia">
      <div class="medidor">
        <label for="creeAntes">Creo que mi preocupación es incontrolable</label>
        <input type="range" id="creeAntes" min="0" max="100" step="5" value="80">
        <span class="valor" id="vCreeAntes">80 %</span>
      </div>
    </div>
    <label class="etiqueta">¿Qué pasa con la preocupación cuando…?</label>
    <div class="chips" id="evidencia"></div>
    <div id="lecturaEvidencia"></div>
  </div>
</section>

<section class="paso">
  <h2><span class="num">2</span>El desencadenante</h2>
  <p class="ayuda">El pensamiento o la imagen con que empezó la última preocupación: suele ser un
  «¿y si…?».</p>
  <div class="cuerpo">
    <div class="chips" id="disparo"></div>
  </div>
</section>

<div class="escenario">
  <svg class="mente" id="mente" viewBox="0 0 640 280" role="img"
    aria-label="Un pensamiento desencadenante y lo que pasa después según el camino elegido"></svg>
  <div class="fase" id="fase">Aparece el desencadenante</div>
  <div class="fase-sub" id="faseSub">No se elige que aparezca. Se elige qué hacer después.</div>
  <div class="mandos">
    <button type="button" class="camino c1" onclick="camino('preocupar')">Engancharme a preocuparme</button>
    <button type="button" class="camino c2" onclick="camino('sacar')">Intentar sacarlo</button>
    <button type="button" class="camino c3" onclick="camino('aplazar')">Dejarlo ahí y aplazarlo</button>
    <button type="button" onclick="otraVez()">Otra vez</button>
  </div>
</div>

<section class="paso">
  <h2><span class="num">3</span>El momento para preocuparse</h2>
  <p class="ayuda">Un rato breve más tarde en el día, no justo antes de dormir. No es obligatorio:
  la mayoría de la gente se olvida de usarlo.</p>
  <div class="cuerpo">
    <label class="etiqueta">Cuándo</label>
    <div class="chips" id="momento"></div>
    <label class="etiqueta">Cuánto dura</label>
    <div class="chips" id="dura"></div>
    <label class="etiqueta">Lo que me digo al aplazar</label>
    <div class="chips" id="frase"></div>
  </div>
</section>

<section class="paso">
  <h2><span class="num">4</span>Una semana después</h2>
  <p class="ayuda">Se vuelve a calificar en la siguiente sesión, después de probar el aplazamiento.</p>
  <div class="cuerpo">
    <div class="creencia">
      <div class="medidor">
        <label for="creeDespues">Creo que mi preocupación es incontrolable</label>
        <input type="range" id="creeDespues" min="0" max="100" step="5" value="80">
        <span class="valor" id="vCreeDespues">80 %</span>
      </div>
    </div>
    <div id="lectura"></div>
  </div>
</section>
@@js
const $ = Kit.$;

const EVIDENCIA = ["…suena el teléfono y contesto", "…duermo", "…alguien me necesita con urgencia",
  "…estoy concentrado en algo que me gusta"];
const DISPARO = ["«¿Y si me enfermo?»", "«¿Y si pierdo el trabajo?»", "«¿Y si le pasa algo a mi familia?»",
  "«¿Y si no puedo con esto?»"];
const MOMENTO = ["Al volver a casa", "Después de almorzar", "Al terminar la jornada"];
const DURA = ["10 minutos", "15 minutos"];
const FRASE = ["«Es un desencadenante. Lo dejo en paz y me ocupo más tarde.»",
  "«Tengo un pensamiento que me preocupa; no necesito pensarlo ahora.»"];
const CADENA = ["¿y si…?", "y entonces…", "¿qué haría?", "¿y si no puedo?", "sería terrible",
  "¿y si pasa otra vez?", "tengo que resolverlo", "¿y si…?", "¿por qué a mí?", "y después…",
  "¿y si nadie ayuda?", "no puedo parar"];

function unica(id){
  $(id).addEventListener("click", e => {
    const b = e.target.closest(".chip");
    if(!b || !b.hasAttribute("data-txt")) return;
    $(id).querySelectorAll(".chip.activa").forEach(c => { if(c !== b) c.classList.remove("activa"); });
  }, true);
}
const disparo = () => Kit.activas("disparo")[0] || "«¿Y si…?»";

/* ---------- la escena ---------- */
let modo = null, t = 0, burbujas = [], rebotes = 0;
const CENTRO = {x:130, y:140};

function nube(svg, x, y, txt, s, col, op){
  const w = Math.max(70, txt.length * 7.2) * s, h = 34 * s;
  svg.appendChild(Kit.svg("rect", {x:x - w / 2, y:y - h / 2, width:w, height:h, rx:h / 2,
    fill:"#fff", stroke:col, "stroke-width":1.8, opacity:op}));
  const tx = Kit.svg("text", {x:x, y:y + 4.5 * s, "text-anchor":"middle", "font-size":13 * s,
    "font-weight":600, fill:col, opacity:op});
  tx.textContent = txt;
  svg.appendChild(tx);
}

function dibujar(){
  const svg = $("mente");
  svg.innerHTML = "";
  svg.appendChild(Kit.svg("rect", {x:0, y:0, width:640, height:280, rx:10, fill:"#f5f8fb"}));
  /* la caja de más tarde */
  if(modo === "aplazar"){
    svg.appendChild(Kit.svg("rect", {x:500, y:190, width:110, height:66, rx:6, fill:"#e7eff5", stroke:"#2f6f8f"}));
    svg.appendChild(Kit.svg("path", {d:"M500 196 L555 228 L610 196", fill:"none", stroke:"#2f6f8f"}));
    const l = Kit.svg("text", {x:555, y:272, "text-anchor":"middle", "font-size":11.5, fill:"#2f6f8f"});
    l.textContent = "para más tarde";
    svg.appendChild(l);
  }
  /* la cadena */
  burbujas.forEach(b => {
    svg.appendChild(Kit.svg("line", {x1:b.px, y1:b.py, x2:b.x, y2:b.y, stroke:"#d9a79d", "stroke-width":1.3}));
  });
  burbujas.forEach(b => nube(svg, b.x, b.y, b.txt, .82, "#b0503f", 1));

  /* el desencadenante */
  let s = 1, op = 1, x = CENTRO.x, y = CENTRO.y;
  if(modo === "sacar"){
    const p = t % 2.4;
    s = p < .9 ? 1 - p * .6 : .46 + Math.min(1, (p - .9) * 2) * (.54 + rebotes * .12);
    x += p < .9 ? Math.sin(p * 40) * 4 : 0;
  }
  if(modo === "aplazar") op = Math.max(.12, 1 - Math.max(0, t - 2) / 9);
  if(modo === "sacar" && rebotes > 0)
    for(let i = 0; i < Math.min(rebotes, 3); i++)
      nube(svg, x + 40 + i * 30, y - 60 + i * 55, disparo(), .7, "#8a6d3b", .8);
  nube(svg, x, y, disparo(), s * 1.15, "#2f4858", op);
  /* la copia que viaja a la caja */
  if(modo === "aplazar" && t < 2.2){
    const p = Math.min(1, t / 1.6);
    const cx = CENTRO.x + (555 - CENTRO.x) * p, cy = CENTRO.y + (222 - CENTRO.y) * p;
    svg.appendChild(Kit.svg("rect", {x:cx - 22, y:cy - 14, width:44, height:28, rx:3, fill:"#fff", stroke:"#2f6f8f",
      opacity:1 - Math.max(0, p - .85) * 6}));
  }
}

const reloj = Kit.reloj(dt => {
  t += dt;
  if(modo === "preocupar"){
    const quiere = Math.min(CADENA.length, Math.floor(t / .75));
    while(burbujas.length < quiere){
      const i = burbujas.length;
      const padre = i === 0 ? {x:CENTRO.x + 60, y:CENTRO.y} : burbujas[Math.floor((i - 1) / 1.6)] || burbujas[i - 1];
      const col = 1 + Math.floor(i / 3), fila = i % 3;
      burbujas.push({txt:CADENA[i], x:210 + col * 100, y:55 + fila * 85 + (col % 2) * 20,
        px:padre.x, py:padre.y});
    }
    $("faseSub").textContent = "Una vuelta lleva a otra. " + burbujas.length + " y contando.";
    if(burbujas.length >= CADENA.length){
      reloj.parar();
      $("faseSub").textContent = "Así sigue hasta que algo más reclama la atención.";
    }
  }
  if(modo === "sacar"){
    const r = Math.floor(t / 2.4);
    if(r > rebotes){ rebotes = r; }
    $("faseSub").textContent = rebotes ? "Vuelve, y a veces con más fuerza." : "Empujándolo fuera…";
    if(t > 8){ reloj.parar(); $("faseSub").textContent = "Cuanto más se intenta sacar, más presente está."; }
  }
  if(modo === "aplazar"){
    if(t > 2.2) $("faseSub").textContent = "Sigue ahí un rato. No hace falta sacarlo: se desvanece a su propio ritmo.";
    if(t > 11){ reloj.parar(); $("faseSub").textContent = "La preocupación quedó para más tarde. El pensamiento, a su ritmo, se fue."; }
  }
  dibujar();
});

function camino(m){
  reloj.parar();
  modo = m; t = 0; burbujas = []; rebotes = 0;
  $("fase").textContent = {preocupar:"Engancharse a preocuparse", sacar:"Intentar sacarlo",
    aplazar:"Dejarlo ahí y aplazarlo"}[m];
  $("faseSub").textContent = m === "aplazar"
    ? "«Es un desencadenante. Lo dejo en paz y me ocupo más tarde.»" : "";
  reloj.andar();
}
function otraVez(){
  reloj.parar();
  modo = null; t = 0; burbujas = []; rebotes = 0;
  $("fase").textContent = "Aparece el desencadenante";
  $("faseSub").textContent = "No se elige que aparezca. Se elige qué hacer después.";
  dibujar();
}

/* ---------- lectura ---------- */
function leer(){
  const a = +$("creeAntes").value, d = +$("creeDespues").value;
  $("vCreeAntes").textContent = a + " %";
  $("vCreeDespues").textContent = d + " %";
  const ev = Kit.activas("evidencia");
  $("lecturaEvidencia").innerHTML = ev.length
    ? `<div class="pregunta" style="margin-top:12px">Si fuera del todo incontrolable, ¿cómo es que se
       detiene cuando ${ev.map(e => e.replace("…", "")).join(" o cuando ")}?</div>` : "";
  let html = "";
  if(d < a)
    html = `<div class="logro">La creencia bajó de ${a} % a ${d} %. El aplazamiento funcionó como
      evidencia de que la preocupación responde a lo que uno elige hacer.</div>`;
  else if(d > a)
    html = `<div class="pistas">Si no cambió, conviene revisar cómo se aplicó: si se aplazó con todos
      los desencadenantes o solo con algunos, y si en realidad se intentó suprimir el pensamiento.</div>`;
  $("lectura").innerHTML = html;
  if(!reloj.anda()) dibujar();
}

function resumen(){
  const l = [];
  l.push("Creencia en la incontrolabilidad: " + $("creeAntes").value + " % al inicio" +
    ($("creeDespues").value !== $("creeAntes").value ? " · " + $("creeDespues").value + " % una semana después" : ""));
  const ev = Kit.activas("evidencia");
  if(ev.length) l.push("Evidencias de que se detiene: " + ev.map(e => e.replace("…", "")).join(", "));
  const d = Kit.activas("disparo");
  if(d.length) l.push("Desencadenante trabajado: " + d.join(", "));
  const m = Kit.activas("momento"), u = Kit.activas("dura"), f = Kit.activas("frase");
  if(m.length || u.length || f.length)
    l.push("", "APLAZAMIENTO: " + [m.join(", "), u.join(", ")].filter(Boolean).join(" · ") +
      (f.length ? " · frase: " + f.join(" ") : ""));
  return l.join("\n");
}

Kit.chips("evidencia", EVIDENCIA, leer);
Kit.chips("disparo", DISPARO, () => { leer(); if(!reloj.anda()) dibujar(); });
Kit.chips("momento", MOMENTO, null);
Kit.chips("dura", DURA, null, true);
Kit.chips("frase", FRASE, null);
["disparo", "dura"].forEach(unica);
$("creeAntes").addEventListener("input", leer);
$("creeDespues").addEventListener("input", leer);
dibujar();

Kit.iniciar({ clave: "tcc-aplazar-la-preocupacion", alCambiar: leer, resumen: resumen });
