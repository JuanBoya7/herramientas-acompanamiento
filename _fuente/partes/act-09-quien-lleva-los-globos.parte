@@meta
archivo: act-quien-lleva-los-globos.html
titulo: Quién lleva los globos
orden: 09
enfoque: ACT
etiqueta: Defusión y elección
sub: Algo aparece y por un momento se mira todo desde adentro de él. Luego pasa a un globo, enfrente; se pregunta quién lo está mirando; y con el globo en la mano se decide quién manda en el paso siguiente. Aquí los globos no se sueltan: se llevan. Lo que se practica es notar quién los lleva y hacia dónde camina.
fuente: Interacciones de defusión con encuadre deíctico, jerárquico y de regulación, en Luciano et al. (2011), Gil-Luciano et al. (2017) y López-López y Luciano (2017); ejercicio del globo en Ruiz et al., Protocolo de dos sesiones de ACT centrado en el pensamiento negativo repetitivo (2018), sesión 2; y las tres estrategias de Törneke, Luciano, Barnes-Holmes y Bond (2016). La escena de caminar con los globos en la mano es una adaptación de esta hoja.
resumen: Varios ensayos seguidos con el mismo ciclo: lo que aparece se pone en un globo, se nota quién lo mira y que hay sitio para todos, y con lo difícil se elige quién manda. Empieza por cosas neutras y sigue con las que suelen mandar. Los globos se quedan en la mano mientras se camina hacia lo que importa.
@@css
  .camino{display:block;width:100%;height:auto;max-width:700px;margin:0 auto}
  .fase{font-size:19px;font-weight:700;text-align:center;margin:8px auto 2px;color:var(--acento);
    min-height:28px;max-width:600px}
  .fase-sub{text-align:center;font-size:14px;color:var(--tinta-suave);max-width:560px;
    margin:0 auto;min-height:22px;line-height:1.5}
  .unaPalabra{max-width:320px;margin:9px auto 0}
  .unaPalabra input{text-align:center}
  button.arrancar{background:#3f9b86;border-color:#3f9b86;color:#fff;font-weight:600}
  button.arrancar:hover{background:#357f6e;border-color:#357f6e}
  button.seguir{background:#2f6f8f;border-color:#2f6f8f;color:#fff;font-weight:600;min-width:170px}
  button.seguir:hover{background:#28607c;border-color:#28607c}
  button.mandaEl{background:#fff;border-color:#9aa8b5;color:#5a6a7d;font-weight:700;min-width:150px}
  button.mandoYo{background:#fff;border-color:#3f9b86;color:#3f9b86;font-weight:700;min-width:150px}
  .marcas div{min-width:104px}
@@html
<section class="paso">
  <h2><span class="num">1</span>Hacia dónde vas</h2>
  <p class="ayuda">Lo que importa en esta época de la vida. No hace falta que esté yendo bien:
  basta con que importe. Es la dirección del letrero.</p>
  <div class="cuerpo">
    <div class="chips" id="importa"></div>
  </div>
</section>

<section class="paso">
  <h2><span class="num">2</span>Lo que aparece en el camino</h2>
  <p class="ayuda">Pensamientos o sensaciones de los de siempre, tal como llegan. Primero vendrán
  cosas neutras, para practicar donde no duele, y después estas.</p>
  <div class="cuerpo">
    <div class="chips" id="dificiles"></div>
    <label class="etiqueta">Cuando eso manda, sueles…</label>
    <div class="chips" id="manda"></div>
  </div>
</section>

<div class="escenario">
  <svg class="camino" id="camino" viewBox="0 0 700 300" role="img"
    aria-label="Una figura que camina con globos en la mano hacia un letrero"></svg>
  <div class="fase" id="fase"></div>
  <div class="fase-sub" id="faseSub"></div>
  <div class="unaPalabra" id="cajaPalabra" hidden>
    <input type="text" id="palabra" placeholder="Una palabra que lo resuma, si quieres">
  </div>
  <div class="marcas">
    <div><span class="n" id="mGlobos" style="color:#2f6f8f">0</span><span class="r">globos en la mano</span></div>
    <div><span class="n" id="mYo" style="color:#3f9b86">0</span><span class="r">veces que mandaste tú</span></div>
    <div><span class="n" id="mEl" style="color:#7d8994">0</span><span class="r">veces que mandó el globo</span></div>
  </div>
  <div class="duracion">
    <button type="button" class="chip activa" id="cNeutros">Empezar por lo neutro</button>
  </div>
  <div class="mandos">
    <button type="button" class="arrancar" id="btnArrancar" onclick="arrancar()">Empezar</button>
    <button type="button" class="seguir" id="btnPaso" onclick="avanzar()" hidden>Ya lo noto</button>
    <button type="button" class="mandaEl" id="btnEl" onclick="elegir('el')" hidden>Que mande el globo</button>
    <button type="button" class="mandoYo" id="btnYo" onclick="elegir('yo')" hidden>Mando yo</button>
    <button type="button" onclick="reiniciar()">Reiniciar</button>
  </div>
</div>

<section class="bloque pregunta-sola" id="cajaPregunta" hidden>
  <div class="pregunta" id="pregunta"></div>
</section>
@@js
const $ = Kit.$;

const IMPORTA   = ["Mi familia","Mi trabajo","Mi salud","Mis amistades"];
const DIFICILES = ["No voy a poder","Algo malo va a pasar","No soy suficiente","Un nudo en el pecho"];
const MANDA     = ["Lo dejo para después","Me quedo callado","Le doy vueltas","Me encierro"];

/* La parte neutra: los mismos pasos donde no duele. En los protocolos de
   origen el entrenamiento empieza siempre así —respiración, sensaciones, un
   pensamiento cualquiera, un recuerdo reciente— y solo después pasa a lo que
   la persona evita. */
const NEUTROS = [
  {t:"Tu respiración", sub:"Nótala entrar y salir, sin cambiarla.", corto:"La respiración"},
  {t:"Un sonido de este lugar", sub:"El que haya. Solo nótalo.", corto:"Un sonido"},
  {t:"Lo que estás pensando ahora mismo", sub:"Lo primero que pase, sea lo que sea.",
   corto:"Un pensamiento", palabra:true},
  {t:"Algo que hiciste hace unos días", sub:"Deja que llegue el recuerdo.",
   corto:"Un recuerdo", palabra:true}
];

const FX = 230, SUELO = 252, CABEZA = 150;
const TONOS = ["#c26a4e","#c9962f","#8a6a9c","#b0503f","#5f77b8"];
const TONO_NEUTRO = "#9fc3d6";

/* fase: espera · notar · alla · quien · elegir · tras · fin */
let fase = "espera", cola = [], idx = -1, ultimo = null, pausa = 0;
let llevados = [];            /* {txt, dificil, mando: "yo" | "el" | null} */
let conNeutros = true;
let globo = null;             /* el que se está trabajando */
let halo = 0, haloMeta = 0, mundo = 0, mundoMeta = 0, vaiven = 0, zancada = 0;

const importa = () => Kit.activas("importa")[0] || "";
const corta = (s, n) => s.length > n ? s.slice(0, n - 1) + "…" : s;
const cuenta = q => llevados.filter(g => g.mando === q).length;

/* Dónde queda cada globo en el ramo que se lleva en la mano de atrás. */
function ranura(i){
  const fila = Math.floor(i / 4), col = i % 4;
  return {x: FX - 62 - col * 27 + (fila % 2) * 13, y: 106 - (fila % 3) * 31 + (col % 2) * 7};
}
const tono = (g, i) => g.dificil ? TONOS[i % TONOS.length] : TONO_NEUTRO;

/* ====================== EL CICLO DE CADA ENSAYO ======================
   Tres movimientos sobre lo mismo, siempre en este orden:
   1. enfrente: yo aquí, eso allá;
   2. quién lo mira, y que hay sitio para ese y para todos;
   3. con lo difícil, quién manda en lo que se hace ahora.
   El tercero solo va con lo difícil: con la respiración no hay nada que
   decidir. */
function arrancar(){
  if(fase !== "espera" && fase !== "fin") return;
  if(!importa()){ Kit.brindis("Marca primero hacia dónde vas"); return; }
  const dif = Kit.activas("dificiles");
  if(!dif.length){ Kit.brindis("Marca primero al menos una cosa de las que aparecen"); return; }
  cola = (conNeutros ? NEUTROS.map(n => Object.assign({dificil:false}, n)) : [])
    .concat(dif.map(t => ({t:"«" + t + "»", sub:"Apareció solo. Nótalo.", corto:t, dificil:true})));
  idx = -1;
  escena.andar();
  siguiente();
}

function siguiente(){
  idx++;
  ultimo = null;
  if(idx >= cola.length){
    fase = "fin"; globo = null; haloMeta = 1;
    pintar();
    Kit.guardar();
    return;
  }
  /* aparece encima de la cabeza: por un momento se mira desde adentro */
  fase = "notar";
  haloMeta = 0;
  globo = {x:FX, y:CABEZA, tx:FX, ty:CABEZA, r:34, rt:34, item:cola[idx], guardado:false};
  pintar();
}

function avanzar(){
  if(!globo) return;
  if(fase === "notar"){
    fase = "alla";
    globo.tx = FX + 122; globo.ty = 116; globo.rt = 24;
  } else if(fase === "alla"){
    const it = globo.item;
    if(it.palabra){
      const p = $("palabra").value.trim();
      if(p) it.corto = p;
      $("palabra").value = "";
    }
    fase = "quien";
    haloMeta = 1;
  } else if(fase === "quien"){
    if(globo.item.dificil) fase = "elegir";
    else { alRamo(null); fase = "tras"; pausa = 1.6; }
  }
  pintar();
}

function alRamo(quien){
  llevados.push({txt:globo.item.corto, dificil:!!globo.item.dificil, mando:quien});
  ultimo = quien || "neutro";
}

/* Las dos respuestas valen. Si manda el globo no se corrige ni se repite: se
   ve un momento cómo queda, y viene el siguiente. */
function elegir(quien){
  if(fase !== "elegir" || !globo) return;
  alRamo(quien);
  fase = "tras";
  if(quien === "yo"){ mundoMeta += 150; pausa = 2.8; }
  else { globo.tx = FX; globo.ty = CABEZA; globo.rt = 34; pausa = 3.2; }
  pintar();
  Kit.guardar();
}

function reiniciar(){
  escena.parar();
  fase = "espera"; cola = []; idx = -1; ultimo = null; globo = null;
  llevados = []; halo = haloMeta = 0; mundo = mundoMeta = 0;
  $("palabra").value = "";
  pintar();
  Kit.guardar();
}

function ponerNeutros(hay){
  conNeutros = hay;
  $("cNeutros").classList.toggle("activa", conNeutros);
  Kit.guardar();
}

/* ====================== EL LATIDO ====================== */
const escena = Kit.reloj(latido);

function latido(dt){
  vaiven += dt;
  const k = Math.min(1, dt * 4);
  halo += (haloMeta - halo) * Math.min(1, dt * 2.5);

  const falta = mundoMeta - mundo;
  if(falta > 1){ mundo += Math.min(falta, 62 * dt); zancada += dt * 8; }

  if(globo){
    /* el que mandó la persona se va al ramo; el que mandó él vuelve a la cabeza */
    if(fase === "tras" && ultimo !== "el" && !globo.guardado){
      const r = ranura(llevados.length - 1);
      globo.tx = r.x; globo.ty = r.y; globo.rt = 13; globo.guardado = true;
    }
    globo.x += (globo.tx - globo.x) * k;
    globo.y += (globo.ty - globo.y) * k;
    globo.r += (globo.rt - globo.r) * k;
  }

  if(fase === "tras"){
    pausa -= dt;
    if(pausa <= 0 && falta <= 1) siguiente();
  }
  dibujar();
  if(fase === "fin" && Math.abs(haloMeta - halo) < .02) escena.parar();
}

/* ====================== LA ESCENA ====================== */
function dibujar(){
  const svg = $("camino");
  svg.innerHTML = "";
  const g = (t, a) => svg.appendChild(Kit.svg(t, a));
  const letra = (x, y, s, estilo) => {
    const t = g("text", {x:x, y:y, "text-anchor":"middle", style:estilo});
    t.textContent = s;
    return t;
  };
  const ROTULO = "font:600 13px system-ui,sans-serif;fill:#3f5163;paint-order:stroke;" +
                 "stroke:#f3f7f9;stroke-width:3.5;stroke-linejoin:round";
  const MENUDA = "font:11.5px system-ui,sans-serif;fill:#6d7f8f";

  g("rect", {x:0, y:0, width:700, height:300, fill:"#f3f7f9"});

  /* el sitio: cabe la figura, el globo de enfrente y todo el ramo */
  if(halo > .02){
    g("ellipse", {cx:FX + 14, cy:150, rx:224, ry:140, fill:"#e3eff6", opacity:halo});
    g("ellipse", {cx:FX + 14, cy:150, rx:224, ry:140, fill:"none", stroke:"#8fbfdc",
      "stroke-width":1.5, "stroke-dasharray":"3 6", opacity:halo});
  }

  /* el suelo corre hacia atrás cuando se camina; el letrero siempre queda adelante */
  g("path", {d:`M0 ${SUELO} L700 ${SUELO} L700 300 L0 300 Z`, fill:"#dbe6d8"});
  for(let n = 0; n < 11; n++){
    const x = ((n * 70 - mundo) % 770 + 770) % 770 - 35;
    g("path", {d:`M${x} ${SUELO + 14} l26 0`, stroke:"#b9cdb4", "stroke-width":3,
      "stroke-linecap":"round"});
  }
  g("path", {d:`M632 ${SUELO} L632 150`, stroke:"#8a9a86", "stroke-width":4, "stroke-linecap":"round"});
  g("path", {d:"M548 128 L642 128 L664 146 L642 164 L548 164 Z", fill:"#fff", stroke:"#3f7d5a",
    "stroke-width":1.6, "stroke-linejoin":"round"});
  letra(598, 142, "hacia", "font:10.5px system-ui,sans-serif;fill:#6d7f8f;letter-spacing:.6px");
  letra(598, 157, corta(importa() || "lo que importa", 15),
    "font:700 12.5px system-ui,sans-serif;fill:#2f5f45");

  /* el ramo, en la mano de atrás */
  const enRamo = llevados.length - (globo && fase === "tras" ? 1 : 0);
  const atras = {x:FX - 16, y:198};
  for(let i = 0; i < enRamo; i++){
    const r = ranura(i), y = r.y + Math.sin(vaiven * 1.3 + i) * 2;
    g("path", {d:`M${atras.x} ${atras.y} L${r.x} ${y + 14}`, stroke:"#a9b6c2", "stroke-width":1});
    g("circle", {cx:r.x, cy:y, r:13, fill:tono(llevados[i], i), opacity:.9});
    g("path", {d:`M${r.x - 3} ${y + 15} L${r.x + 3} ${y + 15} L${r.x} ${y + 12} Z`,
      fill:tono(llevados[i], i)});
  }

  /* la figura */
  const apagada = fase === "tras" && ultimo === "el";
  const c = apagada ? "#9aa8b5" : "#2f6f8f";
  const camina = mundoMeta - mundo > 1;
  const abre = camina ? Math.sin(zancada) * 13 : 5;
  const enfrente = globo && !globo.guardado && globo.x > FX + 40;
  const mano = enfrente ? {x:FX + 24, y:186} : {x:FX + 14, y:198};
  const trazo = (d, w) => g("path", {d:d, stroke:c, "stroke-width":w, "stroke-linecap":"round", fill:"none"});
  trazo(`M${FX} 214 L${FX + abre} ${SUELO}`, 6);
  trazo(`M${FX} 214 L${FX - abre} ${SUELO}`, 6);
  trazo(`M${FX} 168 L${FX} 214`, 9);
  trazo(`M${FX} 177 L${atras.x} ${atras.y}`, 5);
  trazo(`M${FX} 177 L${mano.x} ${mano.y}`, 5);
  g("circle", {cx:FX, cy:CABEZA, r:14, fill:c});
  if(fase === "quien" || fase === "elegir")
    g("circle", {cx:FX, cy:CABEZA, r:21, fill:"none", stroke:"#3f9b86", "stroke-width":2});

  /* el globo que se está trabajando */
  if(globo){
    const i = globo.guardado || fase === "tras" ? llevados.length - 1 : llevados.length;
    const col = tono(globo.item, i);
    const y = globo.y + (globo.guardado ? 0 : Math.sin(vaiven * 1.3) * 2);
    if(globo.guardado)
      g("path", {d:`M${atras.x} ${atras.y} L${globo.x} ${y + globo.r}`, stroke:"#a9b6c2", "stroke-width":1});
    else if(enfrente)
      g("path", {d:`M${mano.x} ${mano.y} L${globo.x} ${y + globo.r}`, stroke:"#a9b6c2", "stroke-width":1.2});
    g("circle", {cx:globo.x, cy:y, r:globo.r, fill:col, opacity:.92});
    g("path", {d:`M${globo.x - 4} ${y + globo.r + 3} L${globo.x + 4} ${y + globo.r + 3} ` +
      `L${globo.x} ${y + globo.r - 1} Z`, fill:col});
    if(!globo.guardado){
      /* sobre la cabeza el rótulo va al costado, para no tapar el ramo */
      const encima = globo.x < FX + 40;
      const t = letra(encima ? globo.x + globo.r + 10 : globo.x,
        encima ? y - globo.r + 12 : y - globo.r - 9,
        corta(fase === "notar" ? globo.item.t : globo.item.corto, 36), ROTULO);
      if(encima) t.setAttribute("text-anchor", "start");
    }
    if(fase === "alla" || fase === "quien" || fase === "elegir"){
      letra(FX, 288, "tú, aquí", MENUDA);
      letra(globo.x, 288, "eso, allá", MENUDA);
    }
  }

  if(fase === "espera")
    letra(360, 96, "Lo que aparece empieza a llegar cuando arranques.",
      "font:14.5px system-ui,sans-serif;fill:#7fa0b2");
}

/* ====================== LO QUE SE LEE DEBAJO ====================== */
function leyenda(){
  const hacia = importa() ? "«" + importa() + "»" : "lo que importa";
  if(fase === "espera") return ["", ""];
  if(fase === "notar") return [globo.item.t, globo.item.sub];
  if(fase === "alla") return ["Pon eso en el globo, enfrente",
    "Mira el globo como se mira un cuadro. No hay que hacer nada con él."];
  if(fase === "quien") return ["¿Quién está mirando ese globo?",
    "Tú estás aquí y eso está allá. Y hay sitio para este y para todos los de hoy."];
  if(fase === "elegir") return ["¿Quién manda en lo que haces ahora?",
    "Con el globo en la mano, hacia " + hacia + "."];
  if(fase === "tras"){
    if(ultimo === "yo") return ["Vas tú, con el globo en la mano", "No se fue. Tampoco hizo falta."];
    if(ultimo === "el"){
      const suele = Kit.activas("manda")[0];
      return ["Esta vez mandó el globo",
        suele ? "Y con él, lo de siempre: " + suele.toLowerCase() + "." : "Se mira adónde lleva, y viene el siguiente."];
    }
    return ["Va contigo", "Hay sitio para este también."];
  }
  return ["Mira todo lo que llevas", "Todos son tuyos, y ninguno es todo lo que eres."];
}

function pintar(){
  const [titulo, sub] = leyenda();
  $("fase").textContent = titulo;
  $("faseSub").textContent = sub;

  const enCurso = fase !== "espera" && fase !== "fin";
  $("btnArrancar").hidden = enCurso;
  $("btnArrancar").textContent = fase === "fin" ? "Otra ronda" : "Empezar";
  $("btnPaso").hidden = !(fase === "notar" || fase === "alla" || fase === "quien");
  $("btnPaso").textContent = fase === "notar" ? "Ya lo noto"
                           : fase === "alla" ? "Ya está enfrente" : "Soy yo";
  $("btnEl").hidden = $("btnYo").hidden = fase !== "elegir";
  $("cajaPalabra").hidden = !(fase === "alla" && globo && globo.item.palabra);

  $("mGlobos").textContent = llevados.length;
  $("mYo").textContent = cuenta("yo");
  $("mEl").textContent = cuenta("el");
  pregunta();
  if(!escena.anda()) dibujar();
}

/* Una sola pregunta, y solo cuando terminó la ronda. */
function pregunta(){
  const yo = cuenta("yo"), el = cuenta("el");
  const visible = fase === "fin" && yo + el > 0;
  $("cajaPregunta").hidden = !visible;
  if(!visible) return;
  const hacia = importa() ? "«" + importa() + "»" : "lo que importa";
  $("pregunta").textContent =
    el === 0 ? `Ninguno de los globos se fue, y caminaste igual. Afuera de esta hoja, ¿cuál sería el primer paso hacia ${hacia} con ellos en la mano?`
    : yo === 0 ? `Mandaron los globos todas las veces. Si siguieran mandando ellos un año más, ¿dónde estaría ${hacia}?`
    : "Con unos mandaste tú y con otros mandaron ellos. ¿En qué se parecen los que mandaron?";
}

function resumen(){
  const l = [];
  l.push("HACIA DÓNDE");
  l.push(Kit.activas("importa").join(" · ") || "(sin marcar)");
  const suele = Kit.activas("manda");
  if(suele.length) l.push("", "CUANDO ESO MANDA, SUELE", suele.join(" · "));

  const dif = llevados.filter(g => g.dificil), neu = llevados.length - dif.length;
  l.push("", `ENSAYOS (${llevados.length}: ${neu} neutros, ${dif.length} con lo difícil)`);
  if(!dif.length) l.push("(sin ensayos con lo difícil)");
  dif.forEach(g => l.push(`«${g.txt}» — al mando: ${g.mando === "yo" ? "la persona" : "el globo"}`));
  if(dif.length)
    l.push("", `Eligió mandar en ${cuenta("yo")} de ${dif.length}. Los globos quedaron en la mano en todos los casos.`);
  return l.join("\n");
}

Kit.chips("importa", IMPORTA, pintar);
Kit.chips("dificiles", DIFICILES);
Kit.chips("manda", MANDA);
$("cNeutros").onclick = () => { if(fase === "espera" || fase === "fin") ponerNeutros(!conNeutros); };

Kit.iniciar({
  clave: "act-quien-lleva-los-globos",
  extra: () => ({llevados, conNeutros, mundo:mundoMeta}),
  restaurar: d => {
    llevados = d.llevados || [];
    conNeutros = d.conNeutros === undefined ? true : !!d.conNeutros;
    mundo = mundoMeta = d.mundo || 0;
    if(llevados.length){ fase = "fin"; halo = haloMeta = 1; }
  },
  alCambiar: () => { $("cNeutros").classList.toggle("activa", conNeutros); pintar(); },
  resumen: resumen
});
