@@meta
archivo: act-piloto-automatico.html
titulo: Salir del piloto automático
enfoque: ACT
etiqueta: Momento presente
sub: Elige una acción cotidiana que sueles hacer sin darte cuenta y pásala del modo rumia al contacto directo por los cinco sentidos.
fuente: Salir del piloto automático en actividades cotidianas (Kabat-Zinn, 1990; Segal, Williams y Teasdale, 2013; Harris, 2019).
resumen: Contrastar una rutina vivida en piloto automático con el anclaje sensorial directo y el retorno amable cuando la mente se va.
@@css
  .pa-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;margin-top:12px}
  .pa-sentido{border:1px solid var(--linea);border-top:3px solid var(--acento);border-radius:9px;padding:11px 13px;background:#fff}
  .pa-sentido b{display:block;font-size:13.5px;margin-bottom:4px;color:var(--acento)}
@@html
<section class="paso">
  <h2><span class="num">1</span>Qué momento cotidiano quieres habitar hoy</h2>
  <div class="cuerpo">
    <div class="chips" id="rutina">
      <button class="chip" data-v="El primer café o bebida de la mañana">El primer café o bebida de la mañana</button>
      <button class="chip" data-v="Caminar las primeras dos cuadras al salir">Caminar las primeras dos cuadras al salir</button>
      <button class="chip" data-v="El agua sobre el cuerpo al ducharme o lavarme las manos">El agua sobre el cuerpo al ducharme o lavarme las manos</button>
      <button class="chip" data-v="Los primeros minutos al llegar a casa y saludar">Los primeros minutos al llegar a casa y saludar</button>
    </div>
    <label class="etiqueta">Adónde se suele ir el piloto automático mientras tu cuerpo hace eso</label>
    <div class="chips" id="fuga">
      <button class="chip" data-v="A adelantar pendientes y problemas del día">A adelantar pendientes y problemas del día</button>
      <button class="chip" data-v="A repasar una conversación que ya pasó">A repasar una conversación que ya pasó</button>
      <button class="chip" data-v="A saltar de pantalla en pantalla en el teléfono">A saltar de pantalla en pantalla en el teléfono</button>
    </div>
  </div>
</section>

<section class="paso">
  <h2><span class="num">2</span>Anclar la acción en tres canales sensoriales</h2>
  <p class="ayuda">No hace falta tardar más tiempo ni poner la mente en blanco: basta con notar tres detalles directos cada vez que notes que te fuiste.</p>
  <div class="pa-grid">
    <div class="pa-sentido">
      <b>1 · Temperatura y tacto</b>
      <input type="text" id="sTacto" placeholder="Ej. El calor de la taza en las palmas o el piso bajo los pies">
    </div>
    <div class="pa-sentido">
      <b>2 · Sonido o aroma directo</b>
      <input type="text" id="sAroma" placeholder="Ej. El sonido del agua, de mis pasos o el olor del café">
    </div>
    <div class="pa-sentido">
      <b>3 · Ritmo del cuerpo</b>
      <input type="text" id="sRitmo" placeholder="Ej. Soltar los hombros al exhalar antes del primer sorbo">
    </div>
  </div>
</section>

<section class="bloque pregunta-sola" id="cierre">
  <div class="pregunta">La mente se va a ir diez veces durante esa rutina, porque ese es su oficio. ¿Cómo quieres tratarte en el instante exacto en que notes que te habías ido al piloto automático?</div>
  <details class="apunte">
    <summary>Anotar lo conversado</summary>
    <textarea id="apunte" placeholder="Acuerdo concreto para practicar hoy o mañana..."></textarea>
  </details>
</section>
@@js
const $ = Kit.$;
Kit.chips("rutina", {multiple:false, libre:true});
Kit.chips("fuga", {multiple:false, libre:true});

Kit.iniciar({
  clave: "act-piloto-automatico",
  alCambiar: () => {},
  resumen: () => [
    "SALIR DEL PILOTO AUTOMÁTICO",
    `Rutina elegida: ${Kit.activas("rutina")[0] || "—"}`,
    `Adónde se va el piloto automático: ${Kit.activas("fuga")[0] || "—"}`,
    `Ancla de tacto/temperatura: ${$("sTacto").value.trim() || "—"}`,
    `Ancla de sonido/aroma: ${$("sAroma").value.trim() || "—"}`,
    `Ancla corporal: ${$("sRitmo").value.trim() || "—"}`,
    $("apunte").value.trim() ? `Notas: ${$("apunte").value.trim()}` : ""
  ].filter(Boolean).join("\n")
});
