@@meta
archivo: met-jardin-de-valores.html
titulo: El jardín de valores
orden: 02
enfoque: Metáforas vivas
etiqueta: Valores
sub: Un jardín tiene espacio para seis surcos, y aquí hay veinticuatro semillas. Aquí se siembra eligiendo qué entra y qué se queda afuera, se enraíza nombrando qué cuida cada surco, se riega con la acción de esta semana, y el jardín responde: lo que se riega crece y lo que no, se dobla. El jardinero no puede hacer crecer nada; solo puede regar.
fuente: Clarificación de valores y metáfora del jardín, en Díaz Corbobés, MANUAL ACT §2.1 y §3.6. El procedimiento —elegir unas pocas direcciones de una lista mayor y calificar después la consistencia del último periodo— viene del values card sort y del VLQ de Wilson. Las veinticuatro semillas no son un instrumento: son un repertorio de partida redactado para esta hoja, y por eso está el botón «+». Lo mismo vale para lo que cada semilla cuida: son direcciones frecuentes, puestas ahí para que la persona encuentre la suya, no para clasificarla. El paso de enraizar existe porque toda semilla está redactada como conducta, y una conducta sin lo que protege debajo es una meta.
resumen: Se siembran seis direcciones de veinticuatro posibles, cada surco dice qué cuida por debajo y se renombra con las palabras de la persona, y el riego lo hace crecer o marchitarse en pantalla. Las malezas se plantan sobre los surcos concretos en los que crecen: una sola puede cubrir varios o el jardín entero.
campo3: Momento
campo3ph: Ej. Sesión 3
@@css
  .panel-jardin{background:var(--papel);border:1px solid var(--linea);border-radius:var(--radio);
    padding:14px 12px 10px;margin-bottom:16px}
  .lienzo{position:relative;max-width:700px;margin:0 auto;border-radius:8px;overflow:hidden}
  .jardin{display:block;width:100%;height:auto;position:relative}
  .lienzo .capa{position:absolute;left:0;top:0;pointer-events:none}
  .clima{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-top:10px;
    padding-top:11px;border-top:1px dashed var(--linea)}
  .clima div{text-align:center;min-width:88px}
  .clima .n{font-size:21px;font-weight:700;display:block;color:#4aa070}
  .clima .r{font-size:10.5px;text-transform:uppercase;letter-spacing:.6px;color:var(--tinta-suave)}
  .avisoRegadera{text-align:center;font-size:12.5px;color:var(--tinta-suave);margin:8px 0 0}

  /* ---------- enraizar: lo que cada surco cuida por debajo ---------- */
  .raices{display:flex;flex-direction:column;gap:10px}
  .raiz{border:1px solid var(--linea);border-left-width:5px;border-radius:9px;
    padding:10px 14px 12px;background:#fdfefe}
  .raiz .semilla{font-size:10.5px;text-transform:uppercase;letter-spacing:.5px;font-weight:700}
  .raiz input.nombre{font:inherit;font-size:15px;font-weight:600;color:var(--tinta);width:100%;
    border:0;border-bottom:1px dashed var(--linea);border-radius:0;background:transparent;
    padding:2px 0 4px;margin:2px 0 10px}
  .raiz input.nombre:focus{outline:none;border-bottom-color:var(--acento);
    border-bottom-style:solid}
  .raiz .pregunta{margin:0 0 7px;font-size:12.5px;color:var(--tinta-suave)}
  .raizChips{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
  .raizChip{font:inherit;font-size:12.5px;line-height:1.3;border:1px solid var(--linea);
    border-radius:999px;padding:4px 11px;background:#fff;color:var(--tinta);cursor:pointer}
  .raizChip:hover{border-color:var(--acento)}
  .raizChip.marcada{color:#fff;font-weight:600}
  .raizChip.mas{border-style:dashed;color:var(--acento);font-weight:700;padding:4px 12px}
  .raizChip.mas:hover{background:var(--acento-claro)}

  .surcos{grid-template-columns:1fr 1fr}
  .riegos{display:flex;flex-direction:column;gap:9px}
  .riego{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;
    border:1px solid var(--linea);border-left-width:5px;border-radius:9px;padding:10px 14px;
    background:#fdfefe}
  .riego .quien{font-size:14.5px;font-weight:600}
  .riego .surco{font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700}
  .riego .mando{display:flex;align-items:center;gap:10px;min-width:230px}
  .riego input[type=range]{flex:1;min-width:100px;height:22px;accent-color:#3f9b5c}
  .riego .gota{flex:0 0 auto;display:block}
  .riego .estado{font-size:11.5px;font-weight:700;border-radius:999px;padding:2px 10px;
    white-space:nowrap;min-width:86px;text-align:center}

  /* ---------- malezas: recuadros que se plantan sobre una flor ---------- */
  .malezas{display:grid;grid-template-columns:repeat(auto-fill,minmax(252px,1fr));gap:9px;
    align-items:start}
  .maleza{border:1px solid var(--linea);border-radius:9px;padding:9px 12px;cursor:pointer;
    background:#fdfefe;transition:border-color .12s,background .12s}
  .maleza:hover{border-color:#8d9478}
  .maleza.activa{border-color:#7d8a63;background:#f4f6ee;cursor:default}
  .maleza .nom{font-size:13.5px;font-weight:600;display:flex;align-items:center;gap:7px}
  .maleza .nom::before{content:"";flex:0 0 auto;width:13px;height:15px;
    background:no-repeat center/contain url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 14 16'><path d='M7 16 V6' stroke='%238d9478' stroke-width='1.6' fill='none'/><path d='M7 11 Q1 9 2 3 Q7 4 7 11' fill='%238d9478' opacity='.75'/><path d='M7 9 Q13 7 12 1 Q7 2 7 9' fill='%238d9478' opacity='.55'/></svg>")}
  /* una maleza puede crecer en varios surcos a la vez: uno, algunos o todos */
  .surquitos{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
  .surquito{font:inherit;font-size:11.5px;line-height:1.3;border:1px solid var(--linea);
    border-radius:999px;padding:3px 9px;background:#fff;color:var(--tinta-suave);cursor:pointer}
  .surquito:hover{border-color:#8d9478}
  .surquito.marcado{color:#fff;font-weight:600}
  .surquito.todo{border-style:dashed;font-weight:700;color:#5f6b4a}
  .surquito.todo.marcado{background:#6f7d54;border-color:#6f7d54;border-style:solid;color:#fff}
  .maleza .quitar{float:right;border:0;background:transparent;color:var(--tinta-suave);
    font-size:17px;line-height:1;padding:0 3px;cursor:pointer}
  .maleza .quitar:hover{color:var(--alerta)}

  /* ---------- el semillero: cada semilla en su matera ----------
     El recuadro es el cuerpo de la matera: el borde de arriba, el contenido
     y su orden no cambian. Encima asoma la flor del ámbito, la misma especie
     que crece en el jardín; al sembrarla, la matera queda vacía. Las filas van
     juntas para que el semillero entero quepa en una pantalla: la primera fila
     de cada ámbito crece al lado de su rótulo, que va a la izquierda. */
  #semillero .tarjetas{row-gap:28px;column-gap:22px;padding-top:0}
  #semillero .pieza.matera{position:relative;z-index:0;border:0;background:transparent;
    padding:14px 16px 8px;border-radius:0}
  #semillero .pieza.matera::after{content:"";position:absolute;inset:6px 4px 0;z-index:-1;
    background:linear-gradient(180deg,var(--amb-s),var(--amb-t) 70%),#fdfbf8;
    border:1.5px solid var(--amb-b);border-top:0;border-radius:2px 2px 15px 15px;
    transform:perspective(320px) rotateX(5deg);transform-origin:50% 0;
    transition:border-color .12s}
  #semillero .pieza.matera::before{content:"";position:absolute;left:0;right:0;top:0;
    height:11px;z-index:2;border-radius:5px;background:var(--amb);
    box-shadow:inset 0 -3px 0 #00000014}
  #semillero .pieza.matera:hover::after{border-color:var(--amb)}
  #semillero .pieza .planta{position:absolute;right:-22px;top:-34px;z-index:4;
    width:94px;height:66px;pointer-events:none}
  /* la enredadera trepa por un costado, corre por el borde y baja por el otro;
     va por los márgenes de la matera y no tapa el texto */
  #semillero .pieza .enredadera{position:absolute;left:-16px;top:-16px;z-index:3;
    pointer-events:none}
  #semillero .pieza.usada .planta{visibility:hidden}
  #surcos .ranura .florcita{flex:0 0 auto;width:30px;height:30px;overflow:visible}

  @media (max-width:640px){
    .surcos{grid-template-columns:1fr}
    .riego{grid-template-columns:1fr}
  }
@@html
<section class="paso">
  <h2><span class="num">1</span>Sembrar</h2>
  <p class="ayuda">Veinticuatro direcciones y seis surcos. Lo que se queda afuera dice tanto como lo
  que entra.</p>
  <p class="pista-arrastre">Arrastra una semilla hasta un surco. En el celular, tócala.</p>
  <div class="cuerpo">
    <div class="ranuras surcos" id="surcos"></div>
    <div style="margin-top:16px"><div id="semillero"></div></div>
  </div>
</section>

<section class="paso" id="pasoRaiz">
  <h2><span class="num">2</span>Enraizar</h2>
  <p class="ayuda">Lo que se sembró es una conducta. ¿Qué está cuidando por debajo?</p>
  <div class="cuerpo">
    <div class="raices" id="raices"></div>
    <div class="velo" id="veloRaiz">Siembra al menos una semilla y aparecerá aquí su raíz.</div>
  </div>
</section>

<section class="paso" id="pasoRiego">
  <h2><span class="num">3</span>Regar</h2>
  <p class="ayuda">Cuánta agua le cayó de verdad a cada surco <b>durante la última semana</b>.</p>
  <div class="cuerpo">
    <div class="riegos" id="riegos"></div>
    <div class="velo" id="veloRiego">Siembra al menos una semilla y aparecerá aquí su riego.</div>

    <div id="cajaMalezas" style="margin-top:22px" hidden>
      <label class="etiqueta">Las malezas</label>
      <p class="ayuda" style="margin-bottom:9px">Crecen solas donde no se riega. Marca la que
      reconozcas y señala en qué surcos crece: uno, varios o todos.</p>
      <div class="malezas" id="malezas"></div>
      <div class="chips" id="malezasMas" style="margin-top:9px"></div>
      <div id="lecturaMalezas"></div>
    </div>
  </div>
</section>

<div class="panel-jardin">
  <div class="lienzo">
    <svg class="jardin capa" id="jardinFondo" viewBox="0 0 700 530" aria-hidden="true"></svg>
    <svg class="jardin" id="jardin" viewBox="0 0 700 530" role="img"
      aria-label="Jardín con los surcos sembrados, lo que cuida cada uno bajo tierra, su estado según el riego y las malezas"></svg>
    <svg class="jardin capa" id="jardinPapel" viewBox="0 0 700 530" aria-hidden="true"></svg>
  </div>
  <p class="avisoRegadera" id="avisoRegadera"></p>
  <div class="clima">
    <div><span class="n" id="cSembradas">0</span><span class="r">surcos sembrados</span></div>
    <div><span class="n" id="cSinRaiz" style="color:#8a6a45">0</span><span class="r">sin raíz</span></div>
    <div><span class="n" id="cFlor">0</span><span class="r">en flor</span></div>
    <div><span class="n" id="cSecas" style="color:#a8834e">0</span><span class="r">secas</span></div>
    <div><span class="n" id="cMalezas" style="color:#7d8a63">0</span><span class="r">malezas</span></div>
  </div>
</div>
@@js
const $ = Kit.$;

/* Cinco ámbitos, cada uno con su color: el recuadro de la semilla, la ranura
   del surco y la fila de riego llevan el mismo. */
const AMBITOS = {
  "Vínculos": "#c26a4e",
  "Cuerpo":   "#6ea24f",
  "Hacer":    "#5f77b8",
  "Sentido":  "#3f9b86",
  "Gozo":     "#d1a52c"
};

/* Lo que cada semilla cuida por debajo. La semilla es la puerta —siempre está
   redactada como conducta, porque por ahí entra quien no sabe nombrar valores—
   y esto es la dirección que la conducta hace visible. Tres o cuatro frecuentes
   y un «+»: la que vale es la que la persona diga con sus palabras. */
const CUIDA = {
  s1: ["Que el otro se sienta acompañado","Cercanía de verdad","No vivir en automático"],
  s2: ["Que el otro se sienta entendido","Respeto por lo que piensa","Dejar de tener la razón"],
  s3: ["Respeto por mí","Honestidad","Cuidar el vínculo sin perderme"],
  s4: ["Reciprocidad","Que el vínculo importe","No esperar a ser buscado"],
  s5: ["Que el vínculo pese más que el orgullo","Hacerme cargo","No dejar heridas abiertas"],
  s21:["Ser alguien con quien se puede contar","Proteger","Devolver lo que recibí"],
  s22:["Intimidad","Complicidad","Volver a elegirnos"],

  s6: ["Cuidarme","Tener con qué responder","Tratarme con respeto"],
  s7: ["Sentirme capaz de mi cuerpo","Vitalidad","Habitarme","Gusto de moverme"],
  s8: ["Amabilidad conmigo","Nutrirme","Paz con mi cuerpo"],
  s9: ["Tranquilidad","Control sobre lo mío","Libertad","No acumular"],

  s10:["Curiosidad","Crecer","Entender el mundo"],
  s11:["Confianza en mi palabra","Integridad","Alivio","Ser alguien que cumple"],
  s12:["Equilibrio","Que mi vida no sea solo esto","Dignidad en lo que hago"],
  s13:["Expresarme","Dejar algo hecho","Oficio","Gusto de hacer"],

  s14:["Generosidad","Que mi presencia sume","Compasión"],
  s15:["Calma","Perspectiva","Sentirme parte de algo"],
  s16:["Coherencia","Integridad","Poder mirarme a la cara"],
  s17:["Notar lo que sí está","Humildad","No dar por sentado"],
  s23:["Pertenecer","Dejar algo mejor","Compromiso","Que no sea solo lo mío"],
  s24:["Conexión","Sentido","Paz interior"],

  s18:["Autonomía","Disfrute","Curiosidad","Libertad"],
  s19:["Permiso para parar","Amabilidad conmigo","Valgo sin producir"],
  s20:["Alegría","Espontaneidad","Ligereza","Reencontrarme"]
};

const SEMILLAS = [
 {id:"s1",  grupo:"Vínculos", titulo:"Estar presente",            desc:"Estar de verdad cuando estoy con alguien."},
 {id:"s2",  grupo:"Vínculos", titulo:"Escuchar sin corregir",     desc:"Dejar que el otro termine antes de responder."},
 {id:"s3",  grupo:"Vínculos", titulo:"Poner límites con cariño",  desc:"Decir que no sin romper el vínculo."},
 {id:"s4",  grupo:"Vínculos", titulo:"Buscar yo también",         desc:"No esperar siempre a que el otro escriba."},
 {id:"s5",  grupo:"Vínculos", titulo:"Reparar después de pelear", desc:"Volver rápido en vez de dejar que se enfríe."},

 {id:"s21", grupo:"Vínculos", titulo:"Cuidar a quien depende de mí", desc:"Hijos, padres, quien esté a mi cargo."},
 {id:"s22", grupo:"Vínculos", titulo:"Cuidar la pareja",       desc:"Que no se nos vuelva pura logística."},

 {id:"s6",  grupo:"Cuerpo",   titulo:"Dormir como si importara",  desc:"Tratar el sueño como algo que sostiene todo lo demás."},
 {id:"s7",  grupo:"Cuerpo",   titulo:"Mover el cuerpo",           desc:"Caminar, bailar, jugar."},
 {id:"s8",  grupo:"Cuerpo",   titulo:"Comer sin castigarme",      desc:"Alimentarme de una forma que me sostenga."},
 {id:"s9",  grupo:"Cuerpo",   titulo:"Bajarle al consumo",        desc:"Menos de lo que me está saliendo caro."},

 {id:"s10", grupo:"Hacer",    titulo:"Aprender algo",             desc:"Entender, no solo pasar."},
 {id:"s11", grupo:"Hacer",    titulo:"Terminar lo que empiezo",   desc:"Cerrar en vez de acumular cosas a medias."},
 {id:"s12", grupo:"Hacer",    titulo:"Trabajar sin dejarme la vida", desc:"Cumplir sin que se lleve todo lo demás."},
 {id:"s13", grupo:"Hacer",    titulo:"Crear con las manos",       desc:"Hacer algo que quede: escribir, cocinar, armar."},

 {id:"s14", grupo:"Sentido",  titulo:"Ayudar a alguien",          desc:"Aportarle a alguien que no tiene por qué devolverme nada."},
 {id:"s15", grupo:"Sentido",  titulo:"Estar en la naturaleza",    desc:"Salir a donde no haya paredes."},
 {id:"s16", grupo:"Sentido",  titulo:"Vivir según lo que creo",   desc:"Que lo que hago se parezca a lo que digo."},
 {id:"s17", grupo:"Sentido",  titulo:"Agradecer",                 desc:"Notar lo que sí está, no solo lo que falta."},

 {id:"s23", grupo:"Sentido",  titulo:"Aportar a algo más grande", desc:"Un grupo, un barrio, una causa."},
 {id:"s24", grupo:"Sentido",  titulo:"Cultivar lo espiritual",  desc:"Lo que me conecta con algo que me excede."},

 {id:"s18", grupo:"Gozo",     titulo:"Hacer algo por gusto",      desc:"Que no rinda para nada y esté bien así."},
 {id:"s19", grupo:"Gozo",     titulo:"Descansar sin culpa",       desc:"Parar sin tener que justificarlo."},
 {id:"s20", grupo:"Gozo",     titulo:"Jugar",                     desc:"Lo que hacía antes de que todo tuviera que servir."}
].map(s => Object.assign(s, {color: AMBITOS[s.grupo], cuida: CUIDA[s.id] || []}));

const MALEZAS = ["No hay tiempo","Pereza","Cansancio","El celular","«mañana empiezo»",
  "Miedo a fallar","Culpa","«no vale la pena»"];

const CUPO = 6;
let huerta;                  // control devuelto por Kit.mostrador
let riego = {};              // id de semilla -> 0..10
let raiz = {};               // id de semilla -> qué cuida ese surco
let nombre = {};             // id de semilla -> cómo lo llama la persona
let raicesPropias = {};      // id de semilla -> [raíces escritas por la persona]
let malezas = {};            // texto de la maleza -> [ids de los surcos donde crece]
let propias = [];            // malezas puestas por la persona
let regadera = "";           // id del surco elegido para esta semana

const sembradas = () => huerta ? huerta.elegidas() : [];
const aguaDe = s => riego[s.id] === undefined ? 5 : riego[s.id];
const surcoPorId = id => sembradas().find(s => s.id === id);

/* El surco se llama como lo llame la persona; la semilla queda como origen. */
const tituloDe = s => nombre[s.id] || s.titulo;
const raizDe = s => raiz[s.id] || "";
const propio = s => !!nombre[s.id] && nombre[s.id] !== s.titulo;
const rotuloSemilla = s => s.grupo + (propio(s) ? " · de «" + s.titulo + "»" : "");

/* Una maleza puede crecer en varios surcos. Lo guardado antes era un solo id
   suelto, así que se lee igual y se devuelve siempre como lista. */
const surcosDe = m => Array.isArray(malezas[m]) ? malezas[m]
                    : (malezas[m] ? [malezas[m]] : []);
const cortar = t => t.length > 22 ? t.slice(0, 21) + "…" : t;

/* ---------- una sola escala, la misma en todas partes ---------- */
const NIVELES = [
  {min:8, nombre:"En flor",      fondo:"#e6f4ec", tinta:"#2f6b4c"},
  {min:6, nombre:"Bien regada",  fondo:"#eef6f1", tinta:"#4a8a68"},
  {min:4, nombre:"Le falta agua",fondo:"#fdf6e8", tinta:"#8a6a2c"},
  {min:2, nombre:"Casi seca",    fondo:"#faf1e6", tinta:"#a8834e"},
  {min:0, nombre:"Seca",         fondo:"#f6efe6", tinta:"#8a6a45"}
];
const nivelDe = a => NIVELES.find(n => a >= n.min);

/* Un campo que aparece donde estaba el botón y se cierra con Enter, con
   Escape o al salir. Lo usan las raíces y las malezas. */
function campoNuevo(caja, boton, alAceptar){
  const campo = document.createElement("input");
  campo.type = "text";
  campo.className = "chipNuevo";
  campo.placeholder = "En tus palabras…";
  caja.insertBefore(campo, boton);
  boton.style.display = "none";
  let cerrado = false;
  const cerrar = ok => {
    if(cerrado) return;
    cerrado = true;
    const txt = campo.value.trim();
    campo.remove();
    boton.style.display = "";
    if(ok && txt) alAceptar(txt);
  };
  campo.addEventListener("keydown", e => {
    if(e.key === "Enter"){ e.preventDefault(); cerrar(true); }
    if(e.key === "Escape"){ e.preventDefault(); cerrar(false); }
  });
  campo.addEventListener("blur", () => cerrar(true));
  campo.focus();
}

/* ====================== ENRAIZAR ====================== */
function pintarRaices(){
  const lista = sembradas();
  $("veloRaiz").style.display = lista.length ? "none" : "block";
  $("raices").innerHTML = lista.map(s => {
    const fichas = (s.cuida || []).concat(raicesPropias[s.id] || []).map(c => {
      const puesta = raizDe(s) === c;
      return `<button type="button" class="raizChip${puesta ? " marcada" : ""}" data-c="${Kit.escapar(c)}"` +
             (puesta ? ` style="background:${s.color};border-color:${s.color}"` : "") +
             `>${Kit.escapar(c)}</button>`;
    }).join("");
    return `<div class="raiz" data-s="${s.id}" style="border-left-color:${s.color}">
      <div class="semilla" style="color:${s.color}">${Kit.escapar(rotuloSemilla(s))}</div>
      <input type="text" class="nombre" value="${Kit.escapar(tituloDe(s))}"
        placeholder="${Kit.escapar(s.titulo)}" aria-label="Cómo se llama este surco">
      <p class="pregunta">¿Qué cuida?</p>
      <div class="raizChips">${fichas}<button type="button" class="raizChip mas">+ otra</button></div>
    </div>`;
  }).join("");

  $("raices").querySelectorAll(".raiz").forEach(caja => {
    const s = surcoPorId(caja.dataset.s);
    if(!s) return;

    /* Renombrar en vivo. Mientras se escribe no se rehace ninguna caja: se
       retocan los rótulos donde está el mismo nombre, o el cursor se pierde. */
    const inp = caja.querySelector("input.nombre");
    inp.addEventListener("input", () => {
      const txt = inp.value.trim();
      if(txt && txt !== s.titulo) nombre[s.id] = txt; else delete nombre[s.id];
      caja.querySelector(".semilla").textContent = rotuloSemilla(s);
      const fila = $("fila-" + s.id);
      if(fila) fila.querySelector(".quien").textContent = tituloDe(s);
      document.querySelectorAll(`#malezas button[data-surco="${s.id}"]`)
        .forEach(b => { b.textContent = cortar(tituloDe(s)); });
      refrescar();
      Kit.guardar();
    });

    /* Una sola raíz por surco: la que se vuelve a tocar se suelta. */
    caja.querySelectorAll("button[data-c]").forEach(b => {
      b.addEventListener("click", () => {
        if(raizDe(s) === b.dataset.c) delete raiz[s.id]; else raiz[s.id] = b.dataset.c;
        pintarRaices();
        refrescar();
        Kit.guardar();
      });
    });

    const mas = caja.querySelector(".raizChip.mas");
    mas.addEventListener("click", () => campoNuevo(mas.parentElement, mas, txt => {
      const suyas = raicesPropias[s.id] || (raicesPropias[s.id] = []);
      if(suyas.indexOf(txt) < 0 && (s.cuida || []).indexOf(txt) < 0) suyas.push(txt);
      raiz[s.id] = txt;
      pintarRaices();
      refrescar();
      Kit.guardar();
    }));
  });
}

/* ====================== RIEGOS ====================== */
function pintarRiegos(){
  const lista = sembradas();
  $("veloRiego").style.display = lista.length ? "none" : "block";
  $("cajaMalezas").hidden = !lista.length;
  $("riegos").innerHTML = lista.map(s => {
    const a = aguaDe(s);
    return `<div class="riego" id="fila-${s.id}" style="border-left-color:${s.color}">
      <div>
        <div class="quien">${Kit.escapar(tituloDe(s))}</div>
        <div class="surco" style="color:${s.color}">${Kit.escapar(s.grupo)}</div>
      </div>
      <div class="mando">
        <span id="gota-${s.id}">${Kit.gota(a, 24)}</span>
        <input type="range" min="0" max="10" value="${a}" data-s="${s.id}">
        <span class="estado" id="est-${s.id}"></span>
      </div>
    </div>`;
  }).join("");

  $("riegos").querySelectorAll("input[data-s]").forEach(inp => {
    inp.addEventListener("input", () => {
      riego[inp.dataset.s] = +inp.value;
      pintarEstado(inp.dataset.s);
      refrescar();
      Kit.guardar();
    });
  });
  lista.forEach(s => pintarEstado(s.id));
}

/* La etiqueta y la gota se rehacen con el mismo dato en el mismo momento:
   antes la etiqueta se quedaba con el valor viejo al mover el calibrador. */
function pintarEstado(id){
  const s = surcoPorId(id);
  if(!s) return;
  const a = aguaDe(s), n = nivelDe(a), et = $("est-" + id), g = $("gota-" + id);
  if(et){
    et.textContent = n.nombre;
    et.style.background = n.fondo;
    et.style.color = n.tinta;
  }
  if(g) g.innerHTML = Kit.gota(a, 24);
}

/* ====================== MALEZAS ====================== */
function pintarMalezas(){
  const lista = sembradas();
  const todas = MALEZAS.concat(propias);
  $("malezas").innerHTML = todas.map(m => {
    const donde = surcosDe(m), puesta = donde.length > 0;
    const enTodos = puesta && donde.length === lista.length;
    const surquitos = lista.map(s => {
      const marcado = donde.indexOf(s.id) >= 0;
      return `<button type="button" class="surquito${marcado ? " marcado" : ""}" data-surco="${s.id}"` +
             (marcado ? ` style="background:${s.color};border-color:${s.color}"` : "") +
             `>${Kit.escapar(cortar(tituloDe(s)))}</button>`;
    }).join("");
    return `<div class="maleza${puesta ? " activa" : ""}" data-m="${Kit.escapar(m)}">
      ${puesta ? `<button type="button" class="quitar" data-quita="${Kit.escapar(m)}" title="Quitar">×</button>` : ""}
      <div class="nom">${Kit.escapar(m)}</div>
      ${puesta ? `<div class="surquitos">${surquitos}<button type="button"
        class="surquito todo${enTodos ? " marcado" : ""}" data-todo="1">todo el jardín</button></div>` : ""}
    </div>`;
  }).join("");

  /* nace donde hay menos agua, que es donde suelen crecer */
  const masSeco = () => lista.slice().sort((a, b) => aguaDe(a) - aguaDe(b))[0];

  $("malezas").querySelectorAll(".maleza").forEach(caja => {
    const m = caja.dataset.m;
    caja.addEventListener("click", ev => {
      if(ev.target.closest("button")) return;
      if(surcosDe(m).length) return;
      const seco = masSeco();
      malezas[m] = seco ? [seco.id] : [];
      pintarMalezas();
      refrescar();
      Kit.guardar();
    });
    /* cada surco se enciende y se apaga por su cuenta: la misma maleza puede
       estar en dos, en tres o en los seis */
    caja.querySelectorAll("button[data-surco]").forEach(b => {
      b.addEventListener("click", ev => {
        ev.stopPropagation();
        const donde = surcosDe(m).slice(), i = donde.indexOf(b.dataset.surco);
        if(i >= 0) donde.splice(i, 1); else donde.push(b.dataset.surco);
        if(donde.length) malezas[m] = donde; else delete malezas[m];
        pintarMalezas();
        refrescar();
        Kit.guardar();
      });
    });
    const todo = caja.querySelector("button[data-todo]");
    if(todo) todo.addEventListener("click", ev => {
      ev.stopPropagation();
      /* si ya cubre el jardín entero, vuelve a donde nació: el surco más seco */
      if(surcosDe(m).length === lista.length){
        const seco = masSeco();
        malezas[m] = seco ? [seco.id] : [];
      } else {
        malezas[m] = lista.map(s => s.id);
      }
      pintarMalezas();
      refrescar();
      Kit.guardar();
    });
  });

  $("malezas").querySelectorAll("button[data-quita]").forEach(b => {
    b.addEventListener("click", ev => {
      ev.stopPropagation();
      delete malezas[b.dataset.quita];
      pintarMalezas();
      refrescar();
      Kit.guardar();
    });
  });
}

/* El "+" para poner una maleza con sus propias palabras. */
function cablearMasMalezas(){
  Kit.chips("malezasMas", [], () => {});
  const caja = $("malezasMas");
  const mas = caja.querySelector(".chip.mas");
  if(!mas) return;
  mas.textContent = "+ otra maleza";
  mas.onclick = () => {
    const campo = document.createElement("input");
    campo.type = "text";
    campo.className = "chipNuevo";
    campo.placeholder = "En tus palabras…";
    caja.insertBefore(campo, mas);
    mas.style.display = "none";
    let cerrado = false;
    const cerrar = ok => {
      if(cerrado) return;
      cerrado = true;
      const t = campo.value.trim();
      campo.remove();
      mas.style.display = "";
      if(ok && t && propias.indexOf(t) < 0 && MALEZAS.indexOf(t) < 0){
        propias.push(t);
        pintarMalezas();
        refrescar();
        Kit.guardar();
      }
    };
    campo.addEventListener("keydown", e => {
      if(e.key === "Enter"){ e.preventDefault(); cerrar(true); }
      if(e.key === "Escape"){ e.preventDefault(); cerrar(false); }
    });
    campo.addEventListener("blur", () => cerrar(true));
    campo.focus();
  };
}

const malezasDe = id => Object.keys(malezas).filter(m => surcosDe(m).indexOf(id) >= 0);

/* ====================== EL JARDÍN ====================== */
/* Acuarela. El papel, el cielo y las colinas se pintan una sola vez, cada uno
   en su capa; al regar solo se rehace la capa de las plantas, y el filtro del
   papel, que es el más pesado, no se recalcula a cada paso del calibrador. */
const SUELO = 300, ALTO_J = 530;
/* Bajo tierra: arriba el rótulo del surco; al fondo, donde llegan las raíces,
   lo que ese surco cuida. Todos a la misma hondura, en una sola fila. */
const HONDO = ALTO_J - 82;
const HALO = "paint-order:stroke;stroke:#f6eee2;stroke-width:3.2px;stroke-linejoin:round";

/* Cada ámbito florece con su especie. El rótulo del surco conserva el color
   del ámbito; la flor tiene el suyo. */
const ESPECIE = {
  "Vínculos":{forma:"redondo", n:5,  L:17, W:14, capas:2, pet:"#e8806e", osc:"#b9544a", cen:"#f3c457"},
  "Cuerpo":  {forma:"estrecho",n:14, L:19, W:6,  pet:"#f4b93a", osc:"#c9861c", cen:"#6b4226", rc:8, semillas:"#4a2c18"},
  "Hacer":   {forma:"flecos",  n:8,  L:18, W:9,  pet:"#5d86d9", osc:"#3c5fae", cen:"#2e3f7a", rc:5},
  "Sentido": {forma:"muesca",  n:8,  L:18, W:10, pet:"#a98cdb", osc:"#7a5fb3", cen:"#f3c457"},
  "Gozo":    {forma:"estrecho",n:16, L:18, W:5,  pet:"#fffaf0", osc:"#cfc2a6", cen:"#f2b632", rc:6}
};
function formaPetalo(f, L, W){
  if(f === "redondo") return `M0 0 C${-W} ${-L*.25} ${-W*1.05} ${-L} 0 ${-L} C${W*1.05} ${-L} ${W} ${-L*.25} 0 0Z`;
  if(f === "estrecho") return `M0 0 C${-W} ${-L*.3} ${-W*.8} ${-L*.9} 0 ${-L} C${W*.8} ${-L*.9} ${W} ${-L*.3} 0 0Z`;
  if(f === "flecos") return `M0 0 C${-W*.6} ${-L*.3} ${-W} ${-L*.7} ${-W} ${-L*.86} L${-W*.62} ${-L*.95} L${-W*.3} ${-L*.87} L0 ${-L} L${W*.3} ${-L*.87} L${W*.62} ${-L*.95} L${W} ${-L*.86} C${W} ${-L*.7} ${W*.6} ${-L*.3} 0 0Z`;
  return `M0 0 C${-W*.9} ${-L*.3} ${-W*1.05} ${-L*.8} ${-W*.55} ${-L} Q${-W*.2} ${-L*1.02} 0 ${-L*.86} Q${W*.2} ${-L*1.02} ${W*.55} ${-L} C${W*1.05} ${-L*.8} ${W*.9} ${-L*.3} 0 0Z`;
}
const formaHoja = (L, W) => `M0 0 C${L*.3} ${-W} ${L*.72} ${-W*1.05} ${L} 0 C${L*.7} ${W*.55} ${L*.3} ${W*.6} 0 0Z`;
const ACUA = "url(#jv-acua)";

/* ---------- el papel y el paisaje: una sola vez ---------- */
function pintarFondo(){
  const svg = $("jardinFondo"), papel = $("jardinPapel");
  const g = (t, a, p) => (p || svg).appendChild(Kit.svg(t, a));
  const defs = g("defs", {});

  /* el borde tembloroso del pincel */
  const f = g("filter", {id:"jv-acua", x:"-20%", y:"-20%", width:"140%", height:"140%"}, defs);
  g("feTurbulence", {type:"fractalNoise", baseFrequency:.045, numOctaves:2, seed:4, result:"r"}, f);
  g("feDisplacementMap", {in:"SourceGraphic", in2:"r", scale:3.2}, f);
  /* las aguadas del fondo, más sueltas y difusas */
  /* el mismo pincel, más suave, para las hojas menudas de las enredaderas */
  const ff = g("filter", {id:"jv-acua-fino", x:"-20%", y:"-20%", width:"140%", height:"140%"}, defs);
  g("feTurbulence", {type:"fractalNoise", baseFrequency:.09, numOctaves:2, seed:6, result:"r"}, ff);
  g("feDisplacementMap", {in:"SourceGraphic", in2:"r", scale:1.3}, ff);
  const w = g("filter", {id:"jv-lavado", x:"-20%", y:"-50%", width:"140%", height:"200%"}, defs);
  g("feTurbulence", {type:"fractalNoise", baseFrequency:.018, numOctaves:3, seed:9, result:"r"}, w);
  g("feDisplacementMap", {in:"SourceGraphic", in2:"r", scale:16, result:"d"}, w);
  g("feGaussianBlur", {in:"d", stdDeviation:4}, w);

  g("rect", {x:0, y:0, width:700, height:ALTO_J, fill:"#fbf6ec"});
  g("ellipse", {cx:190, cy:70, rx:280, ry:95, fill:"#bcdcee", opacity:.32, filter:"url(#jv-lavado)"});
  g("ellipse", {cx:430, cy:40, rx:190, ry:60, fill:"#cfe6f1", opacity:.3, filter:"url(#jv-lavado)"});
  g("ellipse", {cx:590, cy:130, rx:200, ry:85, fill:"#f7d2b4", opacity:.34, filter:"url(#jv-lavado)"});
  g("circle", {cx:606, cy:78, r:30, fill:"#fbd98c", opacity:.55, filter:"url(#jv-lavado)"});
  g("path", {d:`M-20 ${SUELO-52} Q140 ${SUELO-102} 300 ${SUELO-66} T720 ${SUELO-82} V${SUELO+10} H-20Z`,
    fill:"#a9cf94", opacity:.32, filter:"url(#jv-lavado)"});
  g("path", {d:`M-20 ${SUELO-24} Q180 ${SUELO-56} 360 ${SUELO-32} T720 ${SUELO-42} V${SUELO+10} H-20Z`,
    fill:"#8fbf7a", opacity:.34, filter:"url(#jv-lavado)"});
  /* la tierra en corte, para que se vea lo que hay debajo */
  g("rect", {x:-20, y:SUELO + 12, width:740, height:ALTO_J, fill:"#c9a37c", opacity:.13,
    filter:"url(#jv-lavado)"});
  g("rect", {x:-20, y:HONDO - 14, width:740, height:ALTO_J, fill:"#a9825c", opacity:.08,
    filter:"url(#jv-lavado)"});
  g("path", {d:`M-20 ${SUELO+1} Q200 ${SUELO-7} 380 ${SUELO+2} T720 ${SUELO-1} V${SUELO+24} H-20Z`,
    fill:"#b98f68", opacity:.5, filter:"url(#jv-lavado)"});

  /* el grano del papel, encima de todo y sin atrapar los toques */
  const gp = (t, a, p) => (p || papel).appendChild(Kit.svg(t, a));
  const dp = gp("defs", {});
  const fp = gp("filter", {id:"jv-grano", x:0, y:0, width:"100%", height:"100%"}, dp);
  gp("feTurbulence", {type:"fractalNoise", baseFrequency:.85, numOctaves:2, seed:2}, fp);
  gp("feColorMatrix", {values:"0 0 0 0 .45  0 0 0 0 .38  0 0 0 0 .3  0 0 0 .08 0"}, fp);
  gp("rect", {x:0, y:0, width:700, height:ALTO_J, filter:"url(#jv-grano)"});
}

/* ---------- las piezas de la planta ---------- */
function flor(p, x, y, E, esc, rot, trazo){
  const f = p.appendChild(Kit.svg("g", {filter:ACUA,
    transform:`translate(${x} ${y}) rotate(${rot || 0}) scale(${esc})`}));
  const anillo = (L, W, desf, fill) => {
    for(let i = 0; i < E.n; i++)
      f.appendChild(Kit.svg("path", {d:formaPetalo(E.forma, L, W), transform:`rotate(${desf + i * 360 / E.n})`,
        fill, opacity:.8, stroke:E.osc, "stroke-width":.8, "stroke-opacity":trazo || .45}));
  };
  anillo(E.L, E.W, 0, E.pet);
  if(E.capas === 2) anillo(E.L * .64, E.W * .72, 36, E.osc);
  const rc = E.rc || 5;
  f.appendChild(Kit.svg("circle", {r:rc, fill:E.cen}));
  if(E.semillas) for(let i = 0; i < 10; i++){
    const an = i * 2.4, rr = 1.8 + i * .55;
    f.appendChild(Kit.svg("circle", {cx:Math.cos(an) * rr, cy:Math.sin(an) * rr, r:.9, fill:E.semillas}));
  }
  f.appendChild(Kit.svg("circle", {r:rc * .45, cx:-rc * .25, cy:-rc * .25, fill:"#fff", opacity:.35}));
}
function capullo(p, x, y, E, abierto, rot, seco, esc){
  const c = p.appendChild(Kit.svg("g", {filter:ACUA,
    transform:`translate(${x} ${y}) rotate(${rot || 0}) scale(${esc || 1})`}));
  const col = seco ? Kit.mezcla(E.pet, "#a58a64", .7) : E.pet;
  if(abierto){
    [-22, 0, 22].forEach(r => c.appendChild(Kit.svg("path", {
      d:formaPetalo(E.forma === "flecos" ? "flecos" : "redondo", 15, 7), transform:`rotate(${r})`,
      fill:col, opacity:.85, stroke:E.osc, "stroke-width":.7, "stroke-opacity":.4})));
  } else {
    c.appendChild(Kit.svg("path", {d:"M0 0 C-7 -4 -6 -14 0 -18 C6 -14 7 -4 0 0Z", fill:col, opacity:.85}));
  }
  const v = seco ? "#9a8a5c" : "#4f9a5c";
  c.appendChild(Kit.svg("path", {d:"M0 1 C-6 -1 -9 -6 -8 -10 C-5 -6 -2 -4 0 -3Z", fill:v}));
  c.appendChild(Kit.svg("path", {d:"M0 1 C6 -1 9 -6 8 -10 C5 -6 2 -4 0 -3Z", fill:v}));
}
function mariposa(p, x, y){
  const m = p.appendChild(Kit.svg("g", {filter:ACUA, transform:`translate(${x} ${y}) rotate(-14)`}));
  const q = (t, a) => m.appendChild(Kit.svg(t, a));
  q("path", {d:"M0 0 C-10 -14 -20 -6 -14 2 C-18 8 -8 12 0 2Z", fill:"#f09a6b", opacity:.9});
  q("path", {d:"M0 0 C10 -14 20 -6 14 2 C18 8 8 12 0 2Z", fill:"#f4b183", opacity:.9});
  q("circle", {cx:-9, cy:-4, r:2, fill:"#fff", opacity:.8});
  q("circle", {cx:9, cy:-4, r:2, fill:"#fff", opacity:.8});
  q("path", {d:"M0 -4 V6", stroke:"#5a4632", "stroke-width":2, "stroke-linecap":"round"});
  q("path", {d:"M0 -4 q -3 -6 -6 -7 M0 -4 q 3 -6 6 -7", stroke:"#5a4632", "stroke-width":.9, fill:"none"});
}
function cardo(p, x, k){
  const c = p.appendChild(Kit.svg("g", {filter:ACUA, transform:`translate(${x} ${SUELO})`}));
  [[-22, .9, "#7b8a5a"], [0, 1.15, "#6a7a4c"], [20, .85, "#8d9a68"]].forEach(([r, e, col]) => {
    c.appendChild(Kit.svg("path", {
      d:"M0 0 L-4 -9 L-1 -8 L-6 -18 L-2 -16 L-5 -27 L0 -38 L5 -27 L2 -16 L6 -18 L1 -8 L4 -9Z",
      fill:col, opacity:.9, transform:`rotate(${r + k * 6}) scale(${e})`}));
  });
  c.appendChild(Kit.svg("path", {d:"M2 -40 V-30", stroke:"#6a7a4c", "stroke-width":1.5}));
  c.appendChild(Kit.svg("circle", {cx:2, cy:-44, r:4, fill:"#a98ab0", opacity:.9}));
}

/* ---------- el rótulo cabe entero: se reparte en líneas ---------- */
function partir(svg, txt, estilo, ancho, maxLineas){
  const prueba = svg.appendChild(Kit.svg("text", {style:estilo}));
  const mide = s => { prueba.textContent = s; return prueba.getComputedTextLength() || s.length * 7; };
  const lineas = [];
  let l = "";
  txt.split(/\s+/).filter(Boolean).forEach(w => {
    const junta = l ? l + " " + w : w;
    if(l && mide(junta) > ancho){ lineas.push(l); l = w; } else l = junta;
  });
  if(l) lineas.push(l);
  prueba.remove();
  if(lineas.length > maxLineas){
    lineas.length = maxLineas;
    lineas[maxLineas - 1] += "…";
  }
  return lineas;
}
function rotulo(p, x, y, lineas, estilo, salto){
  const t = p.appendChild(Kit.svg("text", {x, y, "text-anchor":"middle", style:estilo}));
  lineas.forEach((l, i) => {
    const s = t.appendChild(Kit.svg("tspan", {x, dy:i ? salto : 0}));
    s.textContent = l;
  });
  return y + (lineas.length - 1) * salto;
}

/* ---------- una planta por surco ---------- */
function plantar(svg, s, cx, ancho){
  const a = aguaDe(s), E = ESPECIE[s.grupo] || ESPECIE["Vínculos"];

  /* toda la planta va dentro de un grupo que se puede tocar: al tocarla se
     le pone la regadera de la semana */
  const mata = svg.appendChild(Kit.svg("g", {style:"cursor:pointer"}));
  mata.addEventListener("click", () => {
    regadera = (regadera === s.id) ? "" : s.id;
    refrescar();
    Kit.guardar();
  });
  const g = (t, at, p) => (p || mata).appendChild(Kit.svg(t, at));
  g("rect", {x:cx - ancho / 2, y:0, width:ancho, height:ALTO_J, fill:"transparent"});

  const vivo = Math.pow(a / 10, .7);
  const verde = Kit.mezcla("#b39a6e", "#4f9a5c", vivo), verdeO = Kit.mezcla("#9a805a", "#3d7f4b", vivo);

  /* la tierra del surco: oscura y húmeda si se riega, pálida y agrietada si no */
  g("ellipse", {cx, cy:SUELO + 6, rx:38, ry:8, fill:Kit.mezcla("#d9bb8c", "#5e412b", a / 10),
    opacity:.8, filter:ACUA});
  if(a <= 3) g("path", {d:`M${cx-20} ${SUELO+6} l6 3 l5 -2 l6 3 M${cx+6} ${SUELO+4} l5 3 l7 -1`,
    stroke:"#a78458", "stroke-width":1.1, fill:"none"});

  /* Lo que se sembró sin nombrar qué cuida se sostiene sobre una línea plana;
     en cuanto se enraíza, las raíces bajan hasta lo hondo y allí, envuelto
     por ellas, queda escrito lo que ese surco cuida. */
  const cuida = raizDe(s), anchoR = Math.min(ancho - 12, 150);
  if(cuida){
    const y0 = SUELO + 8, y1 = HONDO, abre = Math.min(ancho * .4, 58);
    const rz = g("g", {filter:ACUA, stroke:s.color, fill:"none", "stroke-linecap":"round", opacity:.62});
    /* punto de una curva cúbica, para colgar de ella las raicillas */
    const sobre = (p0, p1, p2, p3, t) => {
      const u = 1 - t;
      return [0, 1].map(k => u*u*u*p0[k] + 3*u*u*t*p1[k] + 3*u*t*t*p2[k] + t*t*t*p3[k]);
    };
    [-1, 1].forEach(l => {
      const P = [[cx, y0], [cx + l * abre * .95, y0 + 34], [cx + l * abre, y1 - 62], [cx + l * 12, y1 + 2]];
      g("path", {d:`M${P[0]} C${P[1]} ${P[2]} ${P[3]}`, "stroke-width":2.6}, rz);
      [[.2, 15], [.42, 13], [.64, 11], [.84, 8]].forEach(([t, L], k) => {
        const [px, py] = sobre(P[0], P[1], P[2], P[3], t);
        g("path", {d:`M${px} ${py} q ${l * L * .6} ${L * .2} ${l * L} ${L * (.55 + k * .1)}`,
          "stroke-width":1.1, opacity:.85}, rz);
      });
    });
    g("path", {d:`M${cx} ${y0} C${cx - 4} ${y0 + 60} ${cx + 4} ${y1 - 60} ${cx} ${y1}`,
      "stroke-width":1.5, opacity:.55}, rz);

    const estC = `font:italic 700 11.5px Georgia,'Times New Roman',serif;fill:${Kit.mezcla(s.color, "#1d2733", .38)}`;
    const lineas = partir(svg, cuida, estC, anchoR - 16, 4);
    const altoR = 15 + lineas.length * 13;
    g("rect", {x:cx - anchoR / 2, y:y1, width:anchoR, height:altoR, rx:Math.min(altoR / 2, 15),
      fill:Kit.mezcla(s.color, "#ffffff", .8), stroke:s.color, "stroke-width":1.5,
      "stroke-opacity":.7, filter:ACUA});
    rotulo(mata, cx, y1 + 17, lineas, estC, 13);
  } else {
    g("rect", {x:cx - 36, y:SUELO + 18, width:72, height:3, rx:1.5, fill:s.color, opacity:.3});
    g("rect", {x:cx - anchoR / 2, y:HONDO, width:anchoR, height:28, rx:14, fill:"none",
      stroke:"#b6a58c", "stroke-width":1.2, "stroke-dasharray":"4 4"});
    rotulo(mata, cx, HONDO + 18, ["sin raíz"],
      "font:italic 11px Georgia,'Times New Roman',serif;fill:#a3937a", 0);
  }

  /* el tallo y las hojas: lo seco se dobla. El tallo ondula en S; cada surco
     se mece hacia su lado y con su amplitud, para que no salgan en serie. */
  const alto = 44 + a * 12.5;
  const caida = a <= 3 ? (4 - a) * 16 : 0;
  const num = parseInt(s.id.slice(1), 10) || 0;
  const l = num % 2 ? 1 : -1;
  const amp = (16 + (num % 3) * 5) * (a <= 3 ? .55 : 1) * Math.min(1, .45 + a / 10);
  const tx = cx + l * amp * .45 + caida, ty = SUELO - alto + caida * .45;
  const c1 = [cx - l * amp, SUELO - alto * .32];
  const c2 = [cx + l * amp * 1.25 + caida * .25, SUELO - alto * .7];
  const B = t => {
    const u = 1 - t;
    return [u*u*u*cx + 3*u*u*t*c1[0] + 3*u*t*t*c2[0] + t*t*t*tx,
            u*u*u*SUELO + 3*u*u*t*c1[1] + 3*u*t*t*c2[1] + t*t*t*ty];
  };

  const cuerpo = g("g", {filter:ACUA});
  g("path", {d:`M${cx} ${SUELO} C${c1} ${c2} ${tx} ${ty}`, stroke:verde, "stroke-width":4.2,
    fill:"none", "stroke-linecap":"round"}, cuerpo);
  const nh = Math.max(2, Math.round(a / 2) + 1);
  for(let h = 0; h < nh; h++){
    const [hx, hy] = B(.16 + h * (.62 / nh)), lado = h % 2 ? 1 : -1;
    const L = 30 - h * 1.6, ang = a <= 3 ? -40 + h * 4 : 28 + h * 3;
    const hg = g("g", {transform:`translate(${hx} ${hy}) scale(${lado} 1) rotate(${-ang})`}, cuerpo);
    g("path", {d:formaHoja(L, 9.5), fill:verde, opacity:.85, stroke:verdeO, "stroke-width":.7,
      "stroke-opacity":.5}, hg);
    g("path", {d:`M1 0 Q${L*.5} -1.5 ${L*.92} 0`, stroke:verdeO, "stroke-width":1, fill:"none",
      opacity:.6}, hg);
  }

  /* la cabeza: flor, capullo, brote o nada, según el agua */
  if(a >= 8){
    if(a >= 9){
      const [bx, by] = B(.55);
      /* la rama sale hacia el lado contrario al que se mece el tallo */
      g("path", {d:`M${bx} ${by} c ${-l * 14} -1 ${-l * 26} -11 ${-l * 24} -30`, stroke:verde,
        "stroke-width":2.6, fill:"none", "stroke-linecap":"round"}, cuerpo);
      if(a >= 10) flor(mata, bx - l * 24, by - 30, E, .85, -l * 20);
      else capullo(mata, bx - l * 24, by - 28, E, false, -l * 22, false, 1.2);
    }
    flor(mata, tx, ty, E, 1.55, 0);
    if(a >= 10) mariposa(mata, tx + 40, regadera === s.id ? ty + 16 : ty - 36);
  } else if(a >= 6){
    capullo(mata, tx, ty + 2, E, a >= 7, 0, false, 1.5);
  } else if(a >= 4){
    g("circle", {cx:tx, cy:ty - 4, r:6, fill:"#6fae6a", opacity:.9}, cuerpo);
  } else if(a >= 2){
    capullo(mata, tx + 2, ty + 3, E, false, 150, true, 1.35);
  } else {
    g("circle", {cx:tx, cy:ty, r:3.5, fill:"#8a6a45"}, cuerpo);
  }

  /* las malezas puestas en ESTE surco */
  const malas = malezasDe(s.id);
  malas.slice(0, 3).forEach((m, k) => cardo(mata, cx + (k % 2 ? 1 : -1) * (30 + k * 6), k));

  /* los rótulos, enteros */
  const util = ancho - 10;
  const estNom = `font:700 12px Georgia,'Times New Roman',serif;fill:${s.color};${HALO}`;
  let y = rotulo(mata, cx, SUELO + 42, partir(svg, tituloDe(s), estNom, util, 3), estNom, 14);
  y = rotulo(mata, cx, y + 17, [nivelDe(a).nombre.toLowerCase()],
    `font:600 11px system-ui,sans-serif;fill:#8a7458;letter-spacing:.3px;${HALO}`, 0);
  if(malas.length){
    const estMal = `font:italic 600 10.5px system-ui,sans-serif;fill:#6a7a4c;${HALO}`;
    /* cada maleza en su línea, hasta donde empieza lo hondo */
    const cabe = Math.max(1, Math.floor((HONDO - 12 - (y + 16)) / 13) + 1);
    let lineas = [];
    malas.forEach(m => { lineas = lineas.concat(partir(svg, m, estMal, util, 2)); });
    if(lineas.length > cabe){ lineas.length = cabe; lineas[cabe - 1] += " …"; }
    rotulo(mata, cx, y + 16, lineas, estMal, 13);
  }

  /* la regadera de la semana, encima de la flor elegida */
  if(regadera === s.id) dibujarRegadera(mata, cx, Math.max(40, ty - 92));
}

function dibujar(){
  const svg = $("jardin");
  svg.innerHTML = "";
  const lista = sembradas();
  if(!lista.length){
    const t = svg.appendChild(Kit.svg("text", {x:350, y:180, "text-anchor":"middle",
      style:"font:italic 16px Georgia,'Times New Roman',serif;fill:#a3998a"}));
    t.textContent = "El jardín está sin sembrar.";
    return;
  }
  const ancho = 700 / lista.length;
  lista.forEach((s, i) => plantar(svg, s, ancho * (i + .5), ancho));
}

function dibujarRegadera(padre, cx, cy){
  const R = padre.appendChild(Kit.svg("g", {filter:ACUA, transform:`translate(${cx - 26},${cy})`}));
  const p = (t, a) => R.appendChild(Kit.svg(t, a));
  p("rect", {x:8, y:8, width:34, height:26, rx:5, fill:"#8fb3c9", opacity:.9, stroke:"#4f7891", "stroke-width":1.4});
  p("path", {d:"M14 8 q 8 -12 20 -2", stroke:"#4f7891", "stroke-width":3, fill:"none", "stroke-linecap":"round"});
  p("path", {d:"M42 14 l 16 -7 l 4 5 l -14 10 Z", fill:"#8fb3c9", opacity:.9, stroke:"#4f7891",
    "stroke-width":1.3, "stroke-linejoin":"round"});
  p("rect", {x:14, y:2, width:18, height:5, rx:2.5, fill:"#4f7891"});
  /* el chorro */
  for(let k = 0; k < 4; k++)
    p("path", {d:`M${26 + k * 4} 30 q 2 12 ${-2 + k} 26`, stroke:"#7fbfd8",
      "stroke-width":2, fill:"none", "stroke-linecap":"round", opacity:.75});
  const t = padre.appendChild(Kit.svg("text", {x:cx, y:cy - 6, "text-anchor":"middle",
    style:"font:700 10.5px system-ui,sans-serif;fill:#2f6f8f;letter-spacing:.5px"}));
  t.textContent = "ESTA SEMANA";
}

/* ====================== LAS MATERAS ====================== */
/* El mostrador pinta recuadros; aquí cada uno se vuelve matera: asoman tres
   flores de su ámbito sobre una mata de hojas, y una enredadera la recubre por
   los bordes. Cada matera varía —qué tallo lleva la flor, por dónde trepa la
   enredadera— con una semilla fija, para que no cambie al recargar. */
const semillaPorTitulo = t => SEMILLAS.find(s => s.titulo === t);
const azarCon = k => {
  let sem = ((k + 1) * 2654435761) >>> 0;
  return () => { sem = (Math.imul(sem, 1664525) + 1013904223) >>> 0; return sem / 4294967296; };
};
const VERDES = ["#4f9a5c", "#5fa865", "#7fb86a", "#3f8a52"];

function plantaDeMatera(s, k){
  /* Las flores se recuestan sobre la esquina de arriba a la derecha: no se
     elevan sobre el centro, dejan libre el rótulo y todas las materas quedan
     alineadas por el mismo lado. El origen es esa esquina, en píxeles. */
  const E = ESPECIE[s.grupo] || ESPECIE["Vínculos"];
  const svg = Kit.svg("svg", {});
  const g = (t, a, p) => (p || svg).appendChild(Kit.svg(t, a));
  const verde = "#4f9a5c", verdeO = "#3d7f4b";
  const azar = azarCon(k);
  const hoja = (x, y, lado, ang, L, W, col) => {
    const h = g("g", {transform:`translate(${x} ${y}) scale(${lado} 1) rotate(${-ang})`});
    g("path", {d:formaHoja(L, W), fill:col || verde, opacity:.88, stroke:verdeO, "stroke-width":.6,
      "stroke-opacity":.5}, h);
    g("path", {d:`M1 0 Q${L*.5} -1 ${L*.9} 0`, stroke:verdeO, "stroke-width":.7, fill:"none", opacity:.55}, h);
  };
  /* la mata baja, que nace del borde junto a la esquina */
  for(let i = 0; i < 9; i++){
    const u = i / 8;                                   // 0 = adentro, 1 = la esquina
    hoja(-48 + u * 44 + (azar() - .5) * 4, 0, u < .45 ? -1 : 1, 18 + azar() * 40,
      11 + azar() * 6, 4.6 + azar() * 1.6, VERDES[i % 4]);
  }
  /* los tallos: uno erguido, uno que se asoma por la esquina, uno hacia adentro */
  const tallos = g("g", {fill:"none", stroke:verde, "stroke-linecap":"round"});
  g("path", {d:"M-16 1 C-19 -6 -10 -10 -12 -17", "stroke-width":1.9}, tallos);
  g("path", {d:"M-7 1 C-3 -5 3 -7 9 -6", "stroke-width":1.6}, tallos);
  g("path", {d:"M-28 1 C-29 -4 -34 -6 -37 -10", "stroke-width":1.5}, tallos);
  /* y una rama que cae por el costado */
  g("path", {d:"M-1 1 C5 3 6 10 4 19", "stroke-width":1.3}, tallos);
  hoja(-1, 1, 1, -28, 15, 5.6);
  hoja(4, 8, 1, -62, 12, 4.8, VERDES[2]);
  hoja(5, 14, -1, 70, 10, 4.2, VERDES[1]);
  hoja(-20, -8, -1, 40, 10, 4.2, VERDES[3]);
  hoja(-11, -9, 1, 48, 9, 4, VERDES[2]);

  const cual = k % 3;
  flor(svg, -12, -17, E, .56, (azar() - .5) * 20, .9);
  if(cual === 1) capullo(svg, 9, -6, E, true, 62, false, .8);
  else flor(svg, 9, -6, E, .42, 38, .9);
  if(cual === 0) capullo(svg, -37, -10, E, false, -30, false, .8);
  else flor(svg, -37, -10, E, .36, -20, .9);
  capullo(svg, 4, 20, E, false, 170, false, .62);
  return svg;
}

/* ---------- la enredadera ----------
   Se dibuja en los píxeles reales de la matera, así que se rehace cuando la
   matera cambia de tamaño (otra ventana, otro teléfono). */
function curvaPor(pts){                        // Catmull-Rom a cúbicas
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for(let i = 0; i < pts.length - 1; i++){
    const p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2;
    d += ` C${p1[0] + (p2[0] - p0[0]) / 6} ${p1[1] + (p2[1] - p0[1]) / 6}` +
         ` ${p2[0] - (p3[0] - p1[0]) / 6} ${p2[1] - (p3[1] - p1[1]) / 6} ${p2[0]} ${p2[1]}`;
  }
  return d;
}
function aLoLargo(pts, paso, fn){              // un punto cada `paso` px, con su dirección
  let resto = paso * .5;
  for(let i = 0; i < pts.length - 1; i++){
    const [x0, y0] = pts[i], [x1, y1] = pts[i + 1];
    const L = Math.hypot(x1 - x0, y1 - y0), ang = Math.atan2(y1 - y0, x1 - x0) * 180 / Math.PI;
    let t = resto;
    while(t < L){ fn(x0 + (x1 - x0) * t / L, y0 + (y1 - y0) * t / L, ang); t += paso; }
    resto = t - L;
  }
}
function enredadera(svg, w, h, s, k){
  const E = ESPECIE[s.grupo] || ESPECIE["Vínculos"];
  const azar = azarCon(k + 31);
  svg.innerHTML = "";
  svg.setAttribute("width", w);
  svg.setAttribute("height", h);
  svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
  const g = (t, a, p) => (p || svg).appendChild(Kit.svg(t, a));
  const lado = -1;                             // trepa por la izquierda, hacia las flores de la esquina
  const X = x => lado < 0 ? x : w - x;
  const ond = azar() * 6;

  /* la rama larga: sube por un costado y corre por el borde de arriba */
  const larga = [];
  for(let y = h + 3; y > 12; y -= 12) larga.push([X(4 + Math.sin(y * .32 + ond) * 3.2), y]);
  larga.push([X(9), 5]);
  for(let x = 22, fin = w * (.5 + azar() * .18); x < fin; x += 15)
    larga.push([X(x), 5 + Math.sin(x * .21 + ond) * 3]);
  /* la corta: entra por la esquina de abajo del otro lado y trepa un poco */
  const corta = [];
  for(let x = w * (.22 + azar() * .1); x > 14; x -= 15)
    corta.push([w - X(x), h - 2 + Math.sin(x * .3 + ond) * 2]);
  for(let y = h - 6, fin = h * (.5 + azar() * .15); y > fin; y -= 12)
    corta.push([w - X(4 + Math.sin(y * .3 + ond) * 3), y]);

  const ramas = g("g", {filter:"url(#jv-acua-fino)"});
  [larga, corta].forEach(pts => {
    if(pts.length < 2) return;
    g("path", {d:curvaPor(pts), fill:"none", stroke:"#5b8f4e", "stroke-width":1.5,
      "stroke-linecap":"round", opacity:.9}, ramas);
    let n = 0;
    aLoLargo(pts, 10.5, (x, y, ang) => {
      const sale = n % 2 ? 1 : -1;
      const L = 8 + azar() * 4;
      const hg = g("g", {transform:`translate(${x} ${y}) rotate(${ang + sale * (50 + azar() * 20)})`}, ramas);
      g("path", {d:formaHoja(L, 4 + azar() * 1.4), fill:VERDES[n % 4], opacity:.9,
        stroke:"#3d7f4b", "stroke-width":.5, "stroke-opacity":.5}, hg);
      /* de vez en cuando, un zarcillo enroscado */
      if(n % 7 === 3) g("path", {d:"M0 0 c 3 -1 6 1 5 4 c -1 2 -3 2 -3 0", fill:"none",
        stroke:"#6a9a58", "stroke-width":.8}, hg);
      n++;
    });
  });
  /* unas pocas flores menudas de su ámbito, sobre la rama larga */
  const sitios = [];
  aLoLargo(larga, 34 + azar() * 10, (x, y) => sitios.push([x, y]));
  sitios.filter((_, i) => i % 2 === 1).slice(0, 3)
    .forEach(([x, y], i) => flor(svg, x, y, E, .24 + azar() * .06, i * 30, .9));
}

/* ---------- cada matera se pinta una vez ----------
   Una matera lleva decenas de hojas y flores, cada una con su pincel de
   acuarela; dibujadas en vivo, cada clic en una semilla obligaba a repintar
   cientos de filtros. Aquí cada dibujo se pinta una sola vez, con un único
   pincel para todo, y se guarda como imagen: al tocar una semilla solo se
   vuelven a poner las imágenes ya hechas. */
const PINCEL = {
  grueso: '<filter id="p" x="-10%" y="-10%" width="120%" height="120%">' +
    '<feTurbulence type="fractalNoise" baseFrequency=".045" numOctaves="2" seed="4" result="r"/>' +
    '<feDisplacementMap in="SourceGraphic" in2="r" scale="3.2"/></filter>',
  fino: '<filter id="p" x="-10%" y="-10%" width="120%" height="120%">' +
    '<feTurbulence type="fractalNoise" baseFrequency=".09" numOctaves="2" seed="6" result="r"/>' +
    '<feDisplacementMap in="SourceGraphic" in2="r" scale="1.3"/></filter>'
};
const hechas = {};
function aImagen(clave, dibujar, caja, ancho, alto, pincel){
  if(hechas[clave]) return hechas[clave];
  const svg = dibujar();
  svg.querySelectorAll("[filter]").forEach(e => e.removeAttribute("filter"));
  const ser = new XMLSerializer();
  const dentro = [].map.call(svg.childNodes, n => ser.serializeToString(n)).join("");
  const txt = `<svg xmlns="http://www.w3.org/2000/svg" width="${ancho}" height="${alto}" ` +
    `viewBox="${caja}"><defs>${PINCEL[pincel]}</defs><g filter="url(#p)">${dentro}</g></svg>`;
  return hechas[clave] = URL.createObjectURL(new Blob([txt], {type:"image/svg+xml"}));
}
function imagen(clase, src){
  const i = document.createElement("img");
  i.className = clase;
  i.alt = "";
  i.draggable = false;
  i.setAttribute("aria-hidden", "true");
  if(src) i.src = src;
  return i;
}
/* la enredadera depende del tamaño de la matera: se guarda la última de cada
   una y se suelta la anterior cuando la ventana cambia */
const ENR = 16, enredaderaDe = {};
function ponerEnredadera(img, w, h, s, k){
  const clave = "e" + k + "|" + w + "x" + h;
  if(enredaderaDe[k] && enredaderaDe[k] !== clave){
    URL.revokeObjectURL(hechas[enredaderaDe[k]]);
    delete hechas[enredaderaDe[k]];
  }
  enredaderaDe[k] = clave;
  img.style.width = (w + 2 * ENR) + "px";
  img.style.height = (h + 2 * ENR) + "px";
  img.src = aImagen(clave, () => { const v = Kit.svg("svg", {}); enredadera(v, w, h, s, k); return v; },
    `${-ENR} ${-ENR} ${w + 2 * ENR} ${h + 2 * ENR}`, w + 2 * ENR, h + 2 * ENR, "fino");
}

/* una sola vigilancia para todas las materas */
const vigiaMateras = typeof ResizeObserver === "function" ? new ResizeObserver(cambios => {
  cambios.forEach(c => {
    const e = c.target, w = e.offsetWidth, h = e.offsetHeight;
    if(!w || !h || e._tam === w + "x" + h) return;
    e._tam = w + "x" + h;
    const v = e.querySelector(".enredadera");
    if(v && e._semilla) ponerEnredadera(v, w, h, e._semilla, e._k);
  });
}) : null;

function vestirMateras(){
  document.querySelectorAll("#semillero .pieza").forEach((e, k) => {
    if(e.querySelector(".planta")) return;
    const b = e.querySelector("b"), s = b && semillaPorTitulo(b.textContent);
    if(!s) return;
    e.classList.add("matera");
    e.style.borderLeft = "";
    e.style.background = "";
    e.style.setProperty("--amb", s.color);
    e.style.setProperty("--amb-b", s.color + "8c");
    e.style.setProperty("--amb-s", s.color + "0a");
    e.style.setProperty("--amb-t", s.color + "1f");
    e.appendChild(imagen("planta", aImagen("p" + k, () => plantaDeMatera(s, k),
      "-72 -34 94 66", 94, 66, "grueso")));
    const v = e.appendChild(imagen("enredadera"));
    e._semilla = s;
    e._k = k;
    if(e.offsetWidth){
      e._tam = e.offsetWidth + "x" + e.offsetHeight;
      ponerEnredadera(v, e.offsetWidth, e.offsetHeight, s, k);
    }
  });
  if(vigiaMateras){
    vigiaMateras.disconnect();
    document.querySelectorAll("#semillero .pieza.matera").forEach(e => vigiaMateras.observe(e));
  }
  /* el surco sembrado lleva, junto a su número, la flor de lo que se sembró */
  document.querySelectorAll("#surcos .ranura.llena").forEach(r => {
    if(r.querySelector(".florcita")) return;
    const b = r.querySelector(".puesto b"), s = b && semillaPorTitulo(b.textContent);
    if(!s) return;
    const f = Kit.svg("svg", {class:"florcita", viewBox:"-15 -15 30 30", "aria-hidden":"true"});
    flor(f, 0, 0, ESPECIE[s.grupo] || ESPECIE["Vínculos"], .62, 0, .9);
    r.insertBefore(f, r.querySelector(".puesto"));
  });
}

/* ====================== REFRESCO ====================== */
const enFlor = () => sembradas().filter(s => aguaDe(s) >= 8);
const secas  = () => sembradas().filter(s => aguaDe(s) <= 3);

function refrescar(){
  const lista = sembradas();
  if(regadera && !lista.some(s => s.id === regadera)) regadera = "";
  /* se sueltan los surcos que ya no están sembrados; si no le queda ninguno,
     la maleza se recoloca sola en el más seco */
  const seco = lista.slice().sort((a, b) => aguaDe(a) - aguaDe(b))[0];
  Object.keys(malezas).forEach(m => {
    const vivos = surcosDe(m).filter(id => lista.some(s => s.id === id));
    if(vivos.length) malezas[m] = vivos;
    else if(seco) malezas[m] = [seco.id];
    else delete malezas[m];
  });

  $("cSembradas").textContent = lista.length;
  $("cSinRaiz").textContent = lista.filter(s => !raizDe(s)).length;
  $("cFlor").textContent = enFlor().length;
  $("cSecas").textContent = secas().length;
  $("cMalezas").textContent = Object.keys(malezas).length;

  dibujar();
  leerMalezas();

  const sel = surcoPorId(regadera);
  $("avisoRegadera").innerHTML = !lista.length ? ""
    : sel
    ? `La regadera está sobre <b>${Kit.escapar(tituloDe(sel).toLowerCase())}</b>. Una flor por semana; la próxima, otra.`
    : "Toca la flor que se riega esta semana. Una sola: la regadera no alcanza para seis.";
}

function leerMalezas(){
  const todas = Object.keys(malezas), n = todas.length, lista = sembradas();
  const enSecas = todas.filter(m => surcosDe(m).some(id => {
    const s = surcoPorId(id);
    return s && aguaDe(s) <= 3;
  })).length;
  const enTodo = todas.filter(m => lista.length > 1 && surcosDe(m).length === lista.length).length;
  const cruzan = todas.filter(m => surcosDe(m).length > 1).length - enTodo;
  const cruce = enTodo
    ? ` ${enTodo} cubre${enTodo > 1 ? "n" : ""} el jardín entero.`
    : cruzan ? ` ${cruzan} crece${cruzan > 1 ? "n" : ""} en varios surcos a la vez.` : "";
  $("lecturaMalezas").innerHTML = !n ? ""
    : `<div class="pistas" style="margin-top:12px"><b>${n} maleza${n > 1 ? "s" : ""} puesta${n > 1 ? "s" : ""}</b>` +
      (enSecas ? `, ${enSecas} sobre surcos secos.` : ", ninguna sobre un surco seco.") + cruce +
      ` Crecen igual todas las semanas: la pregunta no es cómo quitarlas, sino qué se riega mientras están ahí.</div>`;
}

/* ====================== RESUMEN ====================== */
function resumen(){
  const l = [], lista = sembradas();
  l.push(`SEMBRADO (${lista.length} de ${CUPO} surcos)`);
  lista.forEach(s => {
    const mal = malezasDe(s.id);
    l.push(`- [${s.grupo}] ${tituloDe(s)}`);
    if(propio(s)) l.push(`    semilla: ${s.titulo}`);
    l.push(`    cuida: ${raizDe(s) || "sin nombrar"}`);
    l.push(`    riego ${aguaDe(s)}/10 (${nivelDe(aguaDe(s)).nombre.toLowerCase()})`);
    if(mal.length) l.push(`    malezas: ${mal.join(", ")}`);
  });
  const anchas = Object.keys(malezas).filter(m => surcosDe(m).length > 1);
  if(anchas.length) l.push("", "MALEZAS EN VARIOS SURCOS", ...anchas.map(m => {
    const donde = surcosDe(m);
    return `- ${m}: ` + (donde.length === lista.length && lista.length > 1
      ? "todo el jardín"
      : donde.map(id => { const s = surcoPorId(id); return s ? tituloDe(s) : ""; })
              .filter(Boolean).join(", "));
  }));
  const fuera = SEMILLAS.filter(s => !lista.some(x => x.id === s.id));
  if(lista.length) l.push("", "Quedó afuera: " + fuera.map(s => s.titulo).join(", "));
  l.push("", `En flor: ${enFlor().length}   Secas: ${secas().length}   ` +
             `Sin raíz: ${lista.filter(s => !raizDe(s)).length}   ` +
             `Malezas: ${Object.keys(malezas).length}`);
  const sel = surcoPorId(regadera);
  l.push("", "LA REGADERA DE ESTA SEMANA: " + (sel ? tituloDe(sel) : "sin elegir"));
  return l.join("\n");
}

/* ====================== ARRANQUE ====================== */
pintarFondo();
cablearMasMalezas();

huerta = Kit.mostrador({
  bancoId:"semillero", ranurasId:"surcos", cupo:CUPO, items:SEMILLAS,
  etiquetas:["Primer surco","Segundo surco","Tercer surco","Cuarto surco","Quinto surco","Sexto surco"],
  alCambiar: () => { vestirMateras(); pintarRaices(); pintarRiegos(); pintarMalezas(); refrescar(); }
});

Kit.iniciar({
  clave: "met-jardin-de-valores",
  extra: () => ({surcos: huerta.ids(), riego, raiz, nombre, raicesPropias,
                 malezas, propias, regadera}),
  restaurar: d => {
    riego = d.riego || {};
    raiz = d.raiz || {};
    nombre = d.nombre || {};
    raicesPropias = d.raicesPropias || {};
    malezas = {};
    Object.keys(d.malezas || {}).forEach(m => {
      const v = d.malezas[m];
      const donde = Array.isArray(v) ? v.slice() : (v ? [v] : []);
      if(donde.length) malezas[m] = donde;
    });
    propias = d.propias || [];
    regadera = d.regadera || "";
    if(d.surcos) huerta.cargar(d.surcos);
  },
  alCambiar: () => { vestirMateras(); pintarRaices(); pintarRiegos(); pintarMalezas(); refrescar(); },
  resumen: resumen
});
