@@meta
archivo: act-diana-de-valores.html
titulo: La diana de valores (Bull's-Eye)
enfoque: ACT
etiqueta: Valores y acción
sub: Una diana de madera con cuatro cuadrantes de vida. Cada dardo se clava tocando la diana: más cerca del centro, más parecido fue lo que hiciste esta semana a quien quieres ser en esa área.
fuente: Bull's-Eye Values Survey (BEVS) de Lundgren, Luoma, Dahl, Strosahl y Melin (2012, Cognitive and Behavioral Practice) y Harris (2009, ACT Made Simple).
resumen: Los cuatro dardos se clavan tocando la diana, uno por cuadrante. Al elegir un paso, el dardo más alejado muestra hacia dónde se movería un anillo. El anillo de cada dardo (1 a 7) queda en el resumen.
@@css
  .dv-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}
  #lienzo{cursor:crosshair;touch-action:manipulation}
  .dv-oculto{display:none}
@@html
<section class="paso">
  <h2><span class="num">1</span>Lo que te importa en cada área</h2>
  <div class="cuerpo">
    <div class="dv-grid">
      <div><label class="etiqueta" for="dvVal1">Trabajo y contribución</label><input type="text" id="dvVal1" placeholder="Ej. dedicación, honestidad"></div>
      <div><label class="etiqueta" for="dvVal2">Relaciones</label><input type="text" id="dvVal2" placeholder="Ej. presencia, ternura"></div>
      <div><label class="etiqueta" for="dvVal3">Salud y cuidado personal</label><input type="text" id="dvVal3" placeholder="Ej. vitalidad, descanso"></div>
      <div><label class="etiqueta" for="dvVal4">Tiempo libre y comunidad</label><input type="text" id="dvVal4" placeholder="Ej. curiosidad, juego"></div>
    </div>
    <div class="dv-oculto">
      <input type="range" id="dvR1" min="1" max="7" value="4"><input type="range" id="dvR2" min="1" max="7" value="4">
      <input type="range" id="dvR3" min="1" max="7" value="4"><input type="range" id="dvR4" min="1" max="7" value="4">
      <input type="text" id="dvP1"><input type="text" id="dvP2"><input type="text" id="dvP3"><input type="text" id="dvP4">
    </div>
  </div>
</section>

<div class="escenario">
  <svg id="lienzo" viewBox="0 0 700 467" role="img" aria-label="Diana de madera con cuatro cuadrantes; toca cada cuadrante para clavar su dardo"></svg>
</div>

<section class="paso">
  <h2><span class="num">2</span>Un paso para acercar el dardo más lejano</h2>
  <div class="cuerpo">
    <div class="chips" id="pasoDiana">
      <button class="chip" data-v="Veinte minutos sin pantallas para conversar">Veinte minutos sin pantallas para conversar</button>
      <button class="chip" data-v="Quince minutos de la tarea postergada">Quince minutos de la tarea postergada</button>
      <button class="chip" data-v="Salir a caminar o cuidar mi descanso">Salir a caminar o cuidar mi descanso</button>
      <button class="chip" data-v="Reservar un rato para algo que me nutra">Reservar un rato para algo que me nutra</button>
    </div>
  </div>
</section>

<section class="bloque pregunta-sola" id="cierre">
  <div class="pregunta" id="textoPregunta">¿A qué pensamiento o incomodidad estarías dispuesto a hacerle espacio para que ese dardo se acerque un anillo al centro?</div>
  <details class="apunte">
    <summary>Anotar lo conversado</summary>
    <textarea id="apunte" placeholder="Obstáculo interno observado y compromiso concreto..."></textarea>
  </details>
</section>
@@js
const $ = Kit.$;
Kit.chips("pasoDiana", {multiple:false, libre:true});

/* ----- geometría de la diana en acuarela (700 x 350) ----- */
const CX = 351, CY = 214, RADIO = 182;
const AREAS = [
  {n:1, sx:-1, sy:-1, nombre:"Trabajo y contribución", color:"#b4553c"},
  {n:2, sx: 1, sy:-1, nombre:"Relaciones",             color:"#3f6189"},
  {n:3, sx:-1, sy: 1, nombre:"Salud y cuidado",        color:"#b0842a"},
  {n:4, sx: 1, sy: 1, nombre:"Tiempo libre y comunidad", color:"#4d7d5e"},
];

/* posición del dardo: guardada como "dx,dy" en radios; si solo hay anillo (datos viejos), va en la diagonal */
function dardo(a){
  const p = ($("dvP" + a.n).value || "").split(",").map(Number);
  if(p.length === 2 && isFinite(p[0]) && isFinite(p[1]) && (p[0] || p[1])) return {dx:p[0], dy:p[1]};
  if(!$("dvP" + a.n).dataset.puesto && !$("dvP" + a.n).value) return null;
  const d = (7 - (parseInt($("dvR" + a.n).value, 10) || 4) + 0.5) / 7 * Math.SQRT1_2;
  return {dx:a.sx * d, dy:a.sy * d};
}
const anillo = p => Math.max(1, Math.min(7, 7 - Math.floor(Math.hypot(p.dx, p.dy) * 7)));

let fondo = null;
function dibujar(){
  const svg = $("lienzo");
  svg.innerHTML = "";
  const g = (tg, a, p) => (p || svg).appendChild(Kit.svg(tg, a));
  const texto = (x, y, s, estilo, ancla) => {
    const e = Kit.svg("text", {x, y, "text-anchor":ancla, style:estilo});
    e.textContent = s; svg.appendChild(e);
  };
  if(!fondo) fondo = Kit.svg("image", {href:"[[imagen:diana-acuarela.jpg]]", x:0, y:0, width:700, height:467, preserveAspectRatio:"none"});
  svg.appendChild(fondo);

  const puestos = [];
  AREAS.forEach(a => {
    const izq = a.sx < 0, x = izq ? 14 : 686, y = a.sy < 0 ? 30 : 432;
    const base = "paint-order:stroke;stroke:#fffaf0;stroke-width:4px;stroke-linejoin:round";
    texto(x, y, a.nombre, `font:700 13.5px system-ui,sans-serif;fill:${a.color};${base}`, izq ? "start" : "end");
    const v = $("dvVal" + a.n).value.trim();
    if(v) texto(x, y + 18, v.length > 26 ? v.slice(0, 24) + "…" : v, `font:600 12.5px Georgia,serif;font-style:italic;fill:#3b3128;${base}`, izq ? "start" : "end");
    const p = dardo(a);
    if(p) puestos.push({a, p});
  });

  /* el paso elegido: hacia dónde se movería un anillo el dardo más lejano */
  if(Kit.activas("pasoDiana")[0] && puestos.length){
    const lejos = puestos.reduce((m, q) => Math.hypot(q.p.dx, q.p.dy) > Math.hypot(m.p.dx, m.p.dy) ? q : m);
    const d = Math.hypot(lejos.p.dx, lejos.p.dy);
    if(d > 0.16){
      const k = (d - 1 / 7) / d, x1 = CX + lejos.p.dx * RADIO, y1 = CY + lejos.p.dy * RADIO, x2 = CX + lejos.p.dx * k * RADIO, y2 = CY + lejos.p.dy * k * RADIO;
      g("line", {x1, y1, x2, y2, stroke:"#fff3c9", "stroke-width":4, "stroke-linecap":"round", "stroke-dasharray":"1 7"});
      g("circle", {cx:x2, cy:y2, r:7, fill:"none", stroke:"#fff3c9", "stroke-width":2.5});
    }
  }

  /* los dardos: sombra, astil y pluma del color del área */
  puestos.forEach(({a, p}) => {
    const x = CX + p.dx * RADIO, y = CY + p.dy * RADIO;
    const gd = Kit.svg("g", {filter:Kit.acuarela(svg)});
    svg.appendChild(gd);
    g("ellipse", {cx:x + 5, cy:y + 6, rx:9, ry:4, fill:"#2b241c", opacity:.3}, gd);
    g("line", {x1:x, y1:y, x2:x + 15, y2:y - 24, stroke:"#4a3b2a", "stroke-width":3, "stroke-linecap":"round"}, gd);
    g("path", {d:`M${x + 15} ${y - 24} l12 -4 l-3 -11 l-12 6 Z`, fill:a.color}, gd);
    g("circle", {cx:x, cy:y, r:3.2, fill:"#2b241c"}, gd);
  });
}

$("lienzo").addEventListener("click", ev => {
  const svg = $("lienzo"), pt = svg.createSVGPoint();
  pt.x = ev.clientX; pt.y = ev.clientY;
  const q = pt.matrixTransform(svg.getScreenCTM().inverse());
  const dx = (q.x - CX) / RADIO, dy = (q.y - CY) / RADIO;
  if(Math.hypot(dx, dy) > 1.04) return;                      // fuera de la diana
  const a = AREAS.find(a => (dx < 0 ? -1 : 1) === a.sx && (dy < 0 ? -1 : 1) === a.sy);
  const k = Math.min(1, 0.985 / Math.max(0.001, Math.hypot(dx, dy)));
  const p = {dx:dx * k, dy:dy * k};
  $("dvP" + a.n).value = p.dx.toFixed(3) + "," + p.dy.toFixed(3);
  $("dvR" + a.n).value = anillo(p);
  dibujar();
  Kit.guardar();
});
["dvVal1", "dvVal2", "dvVal3", "dvVal4"].forEach(id => $(id).addEventListener("input", dibujar));

Kit.iniciar({
  clave: "act-diana-de-valores",
  alCambiar: dibujar,
  resumen: () => {
    const fila = a => {
      const p = dardo(a), v = $("dvVal" + a.n).value.trim();
      return `${a.n}. ${a.nombre}${v ? " (" + v + ")" : ""}: ${p ? anillo(p) + "/7" : "sin dardo"}`;
    };
    const a = $("apunte").value.trim();
    return ["LA DIANA DE VALORES (BULL'S EYE)"].concat(AREAS.map(fila), [
      `Paso concreto de aproximación: ${Kit.activas("pasoDiana")[0] || "—"}`,
      a ? `Lo conversado: ${a}` : ""
    ]).filter(Boolean).join("\n");
  }
});
dibujar();
