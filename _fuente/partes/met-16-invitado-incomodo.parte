@@meta
archivo: met-invitado-incomodo.html
titulo: El invitado incómodo en la fiesta
enfoque: ACT
etiqueta: Aceptación
sub: La fiesta está en marcha y alguien que no invitaste golpea la puerta. Puedes pasar la noche sosteniéndola o dejarlo entrar y volver a tu mesa aunque siga rondando.
fuente: Metáfora de Joe el vagabundo / El invitado no deseado (Hayes, Strosahl y Wilson, 1999, cap. 8; Oliver, 2011; Harris, 2019).
resumen: El visitante golpea solo, cada tanto y sin aviso. Trancar la puerta deja al anfitrión de espaldas a su fiesta, que se enfría; dejarlo pasar no lo vuelve simpático, pero devuelve al anfitrión a la mesa. El marcador cuenta las veces que se vuelve a la mesa.
@@css
  .marcas div{min-width:120px}
  .mandos button.trancar{background:#7a4b3a;border-color:#7a4b3a;color:#fff;font-weight:600}
  .mandos button.trancar:hover{background:#673e30;border-color:#673e30}
  .mandos button.volver{background:#2f7a5f;border-color:#2f7a5f;color:#fff;font-weight:600}
  .mandos button.volver:hover{background:#27674f;border-color:#27674f}
@@html
<section class="paso">
  <h2><span class="num">1</span>La fiesta y quién toca a la puerta</h2>
  <div class="cuerpo">
    <label class="etiqueta">Lo que está pasando en tu mesa</label>
    <div class="chips" id="fiesta">
      <button class="chip" data-v="Estar con la gente que quiero">Estar con la gente que quiero</button>
      <button class="chip" data-v="Sacar adelante un proyecto propio">Sacar adelante un proyecto propio</button>
      <button class="chip" data-v="Construir confianza en mis vínculos">Construir confianza en mis vínculos</button>
      <button class="chip" data-v="Descansar sin estar en guardia">Descansar sin estar en guardia</button>
    </div>
    <label class="etiqueta">Quién golpea sin invitación</label>
    <div class="chips" id="invitado">
      <button class="chip" data-v="«No soy suficiente»">«No soy suficiente»</button>
      <button class="chip" data-v="El miedo a que algo salga mal">El miedo a que algo salga mal</button>
      <button class="chip" data-v="La tristeza que llega de golpe">La tristeza que llega de golpe</button>
      <button class="chip" data-v="La ansiedad en el cuerpo">La ansiedad en el cuerpo</button>
    </div>
  </div>
</section>

<div class="escenario">
  <svg id="escenaFiesta" viewBox="0 0 700 350" role="img" aria-label="Corte de una casa: el porche con la puerta y la sala donde está la fiesta"></svg>
  <div class="marcas">
    <div><span class="n" id="mVolvi" style="color:#2f7a5f">0</span><span class="r">veces que volví a la mesa</span></div>
  </div>
  <div class="mandos">
    <button type="button" class="trancar" id="bTrancar">Ir a trancar la puerta</button>
    <button type="button" class="volver" id="bVolver">Volver a la mesa aunque toque</button>
    <button type="button" id="bReiniciar">Empezar la noche de nuevo</button>
  </div>
</div>

<section class="bloque pregunta-sola" id="cierre">
  <div class="pregunta" id="qFiesta">Cuando te quedas sosteniendo la puerta con el hombro para que ese invitado no pase, ¿quién se está perdiendo la fiesta?</div>
  <details class="apunte">
    <summary>Anotar lo conversado</summary>
    <textarea id="apunte" placeholder="Cómo sería dejarle un rincón en la sala y volver a la mesa..."></textarea>
  </details>
</section>
@@js
const $ = Kit.$;
Kit.chips("fiesta", {multiple:false, libre:true});
Kit.chips("invitado", {multiple:false, libre:true});

/* ----- geometría del fondo en acuarela (700 x 350) ----- */
const PISO = 293;          // donde apoyan los pies (piso de la sala en el fondo)
const PUERTA = 305;        // muro cortado entre el porche y la sala
const MESA = 462;          // cabecera de la mesa, junto a los amigos
const RINCON = 360;        // junto al sillón, cerca de la entrada
const ALTO = 158;          // alto de las figuras (a escala de los amigos sentados)
/* proporciones (ancho/alto) de cada figura recortada */
const FIG = {
  empuja:  {href:"[[imagen:invitado-anfitrion-empuja.webp]]",  r:0.84},
  mesa:    {href:"[[imagen:invitado-anfitrion-mesa.webp]]",    r:0.453},
  camina:  {href:"[[imagen:invitado-anfitrion-camina.webp]]",  r:0.513},
  toca:    {href:"[[imagen:invitado-toca.webp]]",              r:0.693},
  rezonga: {href:"[[imagen:invitado-rezonga.webp]]",           r:0.36},
  ronda:   {href:"[[imagen:invitado-ronda.webp]]",             r:0.473},
};

const AFUERA = PUERTA - 10 - ALTO * FIG.toca.r / 2;     // el puño llega a la puerta
const EN_PUERTA = PUERTA + 9 + ALTO * FIG.empuja.r / 2;  // las palmas contra la puerta
/* ----- estado de la noche ----- */
let anf, inv, calidez, volvi, golpe, proximoGolpe, t, quejas;
function reiniciar(){
  anf = {x:MESA, meta:MESA, modo:"mesa"};          // mesa | puerta | camino
  inv = {x:AFUERA, meta:AFUERA, modo:"afuera"};          // afuera | entrando | adentro
  calidez = 1; volvi = 0; golpe = 0; t = 0; quejas = [];
  proximoGolpe = 2.5;
  $("qFiesta").textContent = "Cuando te quedas sosteniendo la puerta con el hombro para que ese invitado no pase, ¿quién se está perdiendo la fiesta?";
}
reiniciar();

const escena = Kit.reloj(latido);

function latido(dt){
  t += dt;
  /* el anfitrión camina hacia donde decidió estar */
  if(anf.modo === "camino"){
    const d = anf.meta - anf.x, paso = 120 * dt;
    if(Math.abs(d) <= paso){ anf.x = anf.meta; anf.modo = anf.meta === MESA ? "mesa" : "puerta"; }
    else anf.x += Math.sign(d) * paso;
  }
  /* la fiesta se entibia con el anfitrión en su mesa y se enfría con él en la puerta */
  const objetivo = anf.modo === "mesa" ? 1 : anf.modo === "puerta" ? 0.15 : 0.55;
  calidez += (objetivo - calidez) * Math.min(1, dt * 0.6);

  /* el visitante golpea solo, sin aviso; con la puerta trancada golpea más seguido y más fuerte */
  golpe = Math.max(0, golpe - dt * 1.8);
  if(inv.modo === "afuera"){
    proximoGolpe -= dt;
    if(proximoGolpe <= 0){
      golpe = 1;
      proximoGolpe = anf.modo === "puerta" ? 1.6 + Math.random() * 1.6 : 3.5 + Math.random() * 3;
    }
    /* sin nadie sosteniendo la puerta, termina entrando por su cuenta */
    if(anf.modo === "mesa" && t > 6 && Math.random() < dt * 0.12){ inv.modo = "entrando"; inv.meta = RINCON; }
  } else if(inv.modo === "entrando"){
    const paso = 70 * dt;
    if(inv.x + paso >= inv.meta){ inv.x = inv.meta; inv.modo = "adentro"; }
    else inv.x += paso;
  } else {
    /* adentro ronda por la sala, se acerca de vez en cuando y rezonga */
    if(Math.abs(inv.x - inv.meta) < 2 && Math.random() < dt * 0.35)
      inv.meta = RINCON + Math.random() * (anf.modo === "mesa" ? 30 : 10);
    inv.x += Math.sign(inv.meta - inv.x) * Math.min(Math.abs(inv.meta - inv.x), 34 * dt);
    if(Math.random() < dt * 0.4) quejas.push({x:inv.x + 6, y:PISO - ALTO - 8, v:0});
  }
  quejas.forEach(q => { q.v += dt; q.y -= 14 * dt; });
  quejas = quejas.filter(q => q.v < 2.4);

  dibujar();
}

let fondo = null;
function figura(clave, cual, x, espejo, extra){
  const f = FIG[cual], w = ALTO * f.r;
  const img = Kit.figura(clave + cual, f.href, {x:-w / 2, y:-ALTO, width:w, height:ALTO});
  const g = Kit.svg("g", {transform:`translate(${x} ${PISO + (extra || 0)})${espejo ? " scale(-1 1)" : ""}`});
  g.appendChild(img);
  return g;
}

function dibujar(){
  const svg = $("escenaFiesta");
  svg.innerHTML = "";
  const g = (tg, a, p) => (p || svg).appendChild(Kit.svg(tg, a));
  const texto = (x, y, s, estilo, ancla) => {
    const e = Kit.svg("text", {x, y, "text-anchor":ancla || "middle", style:estilo});
    e.textContent = s; svg.appendChild(e); return e;
  };
  const nomFiesta = Kit.activas("fiesta")[0] || "Lo que te importa";
  const nomInv = Kit.activas("invitado")[0] || "El invitado incómodo";

  if(!fondo) fondo = Kit.svg("image", {href:"[[imagen:invitado-fiesta-acuarela.jpg]]", x:0, y:0, width:700, height:350, preserveAspectRatio:"xMidYMid slice"});
  svg.appendChild(fondo);

  /* la sala se enfría: un velo azul de noche crece cuando el anfitrión no está en su mesa */
  g("rect", {x:PUERTA + 6, y:0, width:700 - PUERTA - 6, height:350, fill:"#1d2f45", opacity:(0.5 * (1 - calidez)).toFixed(3)});
  g("ellipse", {cx:575, cy:210, rx:160, ry:95, fill:"#ffcf7a", opacity:(0.22 * calidez).toFixed(3), style:"mix-blend-mode:soft-light"});

  /* la puerta: cerrada en el vano, o abierta hacia la sala; tiembla con cada golpe */
  const tiembla = golpe > 0 ? Math.sin(t * 60) * 2.2 * golpe : 0;
  const cerrada = inv.modo === "afuera";
  const madera = {fill:"#7b5537", filter:Kit.acuarela(svg)};
  if(cerrada) g("rect", Object.assign({x:PUERTA - 7 + tiembla, y:PISO - 182, width:14, height:168, rx:2}, madera));
  else g("path", Object.assign({d:`M${PUERTA - 7} ${PISO - 182} L${PUERTA + 48} ${PISO - 164} L${PUERTA + 48} ${PISO + 6} L${PUERTA - 7} ${PISO} Z`, opacity:.9}, madera));

  /* los golpes se ven del lado del porche */
  if(golpe > 0 && cerrada){
    const fuerza = anf.modo === "puerta" ? 1.4 : 1;
    for(let k = 0; k < 3; k++){
      const r = (10 + k * 10 + (1 - golpe) * 18) * fuerza;
      g("path", {d:`M${PUERTA - 16} ${PISO - 112 - r} A${r} ${r} 0 0 0 ${PUERTA - 16} ${PISO - 112 + r}`, fill:"none",
        stroke:"#8a3d3d", "stroke-width":2.2, opacity:(golpe * (1 - k * 0.28)).toFixed(2), "stroke-linecap":"round"});
    }
  }

  /* el visitante */
  if(inv.modo === "afuera") svg.appendChild(figura("inv", "toca", inv.x + (golpe > .5 ? 3 : 0), false));
  else svg.appendChild(figura("inv", inv.modo === "entrando" || Math.abs(inv.meta - inv.x) > 2 ? "ronda" : "rezonga", inv.x, inv.meta < inv.x));
  quejas.forEach(q => g("path", {d:`M${q.x - 9} ${q.y} q4 -7 9 0 t9 0`, fill:"none", stroke:"#5b4a46", "stroke-width":2,
    opacity:(1 - q.v / 2.4).toFixed(2), filter:Kit.acuarela(svg)}));
  texto(inv.modo === "afuera" ? inv.x - 10 : inv.x, PISO + 22, nomInv.length > 30 ? nomInv.slice(0, 28) + "…" : nomInv,
    "font:600 12px system-ui,sans-serif;fill:#6b372d;paint-order:stroke;stroke:#fffaf2;stroke-width:4px");

  /* el anfitrión */
  if(anf.modo === "puerta") svg.appendChild(figura("anf", "empuja", EN_PUERTA + tiembla * 0.6, false));
  else if(anf.modo === "camino") svg.appendChild(figura("anf", "camina", anf.x, anf.meta < anf.x));
  else svg.appendChild(figura("anf", "mesa", anf.x, false));

  texto(560, 70, nomFiesta.length > 34 ? nomFiesta.slice(0, 32) + "…" : nomFiesta,
    `font:600 13px Georgia,serif;font-style:italic;fill:#4f3b22;opacity:${(0.35 + 0.65 * calidez).toFixed(2)};paint-order:stroke;stroke:#fffaf2;stroke-width:4px`);

  $("mVolvi").textContent = volvi;
  $("bVolver").disabled = anf.modo === "mesa" || (anf.modo === "camino" && anf.meta === MESA);
  $("bTrancar").disabled = anf.modo === "puerta" || (anf.modo === "camino" && anf.meta !== MESA);
  $("bTrancar").textContent = inv.modo === "afuera" ? "Ir a trancar la puerta" : "Sacarlo y trancar la puerta";
}

$("bTrancar").addEventListener("click", () => {
  if(inv.modo !== "afuera"){ inv.modo = "afuera"; inv.x = inv.meta = AFUERA; quejas = []; }
  anf.meta = EN_PUERTA; anf.modo = "camino";
  Kit.guardar();
});
$("bVolver").addEventListener("click", () => {
  anf.meta = MESA; anf.modo = "camino"; volvi++;
  if(volvi === 1) $("qFiesta").textContent = "No hace falta que el invitado te caiga bien ni que apruebes su visita. ¿Qué puedes hacer hoy en tu propia mesa aunque siga rondando por la sala?";
  Kit.guardar();
});
$("bReiniciar").addEventListener("click", () => { reiniciar(); Kit.guardar(); });

Kit.iniciar({
  clave: "met-invitado-incomodo",
  alCambiar: dibujar,
  resumen: () => [
    "EL INVITADO INCÓMODO EN LA FIESTA",
    `La fiesta que importa: ${Kit.activas("fiesta")[0] || "—"}`,
    `El invitado incómodo: ${Kit.activas("invitado")[0] || "—"}`,
    `Veces que volví a la mesa: ${volvi}`,
    $("apunte").value.trim() ? `Notas: ${$("apunte").value.trim()}` : ""
  ].filter(Boolean).join("\n")
});
escena.andar();
