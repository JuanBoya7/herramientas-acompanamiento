@@meta
archivo: tcc-trap-a-trac.html
titulo: Salir de la trampa: de TRAP a TRAC
orden: 18
enfoque: Cognitivo-conductual
etiqueta: Activación conductual
sub: Ante un mismo disparador (T) y una misma respuesta de desánimo o malestar (R), el patrón de evitación (TRAP) cierra un bucle que achica la vida, mientras que el cambio de aguja hacia un afrontamiento alternativo (TRAC) vuelve a poner el vagón en marcha.
fuente: Análisis funcional de la evitación (TRAP) y afrontamiento alternativo (TRAC), en Martell, Dimidjian y Herman-Dunn, Behavioral Activation for Depression (2010), cap. 6 y apéndice 1g; Jakupcak, Wagner y Martell (2019), caps. 4 y 5.
resumen: Bifurcación ferroviaria interactiva de la Activación Conductual para pasar del bucle de evitación (TRAP) a un paso pequeño de aproximación (TRAC).
@@css
  .rieles-svg{display:block;width:100%;height:auto}
@@html
<div class="escenario">
  <svg class="rieles-svg" id="svgTrap" viewBox="0 0 700 240" role="img"
    aria-label="Bifurcación ferroviaria entre el bucle TRAP de evitación y la vía TRAC de afrontamiento alternativo"></svg>
  <div class="mandos">
    <button type="button" id="btnRielTrap" class="principal" onclick="moverAguja('trap')">Aguja en TRAP (bucle de evitación)</button>
    <button type="button" id="btnRielTrac" onclick="moverAguja('trac')">Cambiar la aguja a TRAC (afrontamiento alternativo)</button>
  </div>
</div>

<section class="paso">
  <h2><span class="num">1</span>T y R · Qué disparó el bajón y qué se sintió adentro</h2>
  <p class="ayuda">Las dos primeras letras son iguales en ambas vías: no hace falta dejar de sentir la R para cambiar de riel.</p>
  <div class="cuerpo">
    <label class="etiqueta">T · Disparador (Trigger)</label>
    <div class="chips" id="trapT"></div>
    <label class="etiqueta">R · Respuesta interna (Response)</label>
    <div class="chips" id="trapR"></div>
  </div>
</section>

<section class="paso">
  <h2><span class="num">2</span>AP frente a AC · El patrón de evitación y el desvío alternativo</h2>
  <p class="ayuda">La acción va primero y el ánimo la alcanza después.</p>
  <div class="cuerpo">
    <label class="etiqueta">AP · Patrón de evitación que me deja en la trampa (TRAP)</label>
    <div class="chips" id="patronTRAP"></div>
    <label class="etiqueta">AC · Afrontamiento alternativo para volver a la vía (TRAC)</label>
    <div class="chips" id="caminoTRAC"></div>
  </div>
</section>

<section class="bloque pregunta-sola">
  <div class="pregunta">Si la acción va primero y las ganas aparecen después, ¿cuál es el cambio de riel más pequeño que puedes hacer hoy?</div>
</section>
@@js
const $ = Kit.$;

const LISTA_T = ["Despertar sin fuerzas o con la semana vacía", "Una dificultad o roce en una relación", "Un pendiente que se acumuló y abruma", "Un recuerdo triste o sensación de fracaso"];
const LISTA_R = ["Pesadez en el cuerpo y ganas de no moverme", "Desánimo o sensación de «para qué»", "Ansiedad o ganas de esconderme"];
const LISTA_AP = ["Quedarme en la cama o mirando el teléfono por horas", "Cancelar el encuentro y no contestar mensajes", "Darle vueltas en silencio a todo lo que anda mal", "Postergar hasta «tener ganas»"];
const LISTA_AC = ["Levantarme y hacer solo los primeros diez minutos de la actividad", "Salir a caminar una cuadra o abrir la ventana aunque siga desganado", "Avisar con honestidad a alguien cercano y vernos un rato corto", "Empezar por la parte más sencilla sin esperar a que vuelva el ánimo"];

let riel = "trap";

function moverAguja(nuevo){
  riel = nuevo;
  $("btnRielTrap").classList.toggle("principal", riel === "trap");
  $("btnRielTrac").classList.toggle("principal", riel === "trac");
  dibujar();
  Kit.guardar();
}

function dibujar(){
  const svg = $("svgTrap");
  svg.innerHTML = "";
  const f = Kit.acuarela(svg);
  const enTrac = riel === "trac";

  svg.appendChild(Kit.svg("rect", {x:8, y:8, width:684, height:224, rx:12, fill:"#f9fbfd", stroke:"#dde6ee"}));

  /* Tramo común T -> R */
  svg.appendChild(Kit.svg("line", {x1:36, y1:130, x2:280, y2:130, stroke:"#4e6b8c", "stroke-width":4}));
  svg.appendChild(Kit.svg("rect", {x:32, y:96, width:104, height:64, rx:9, fill:"#eef4f9", stroke:"#2f6f8f", "stroke-width":2, filter:f}));
  const tT = Kit.svg("text", {x:84, y:125, "text-anchor":"middle", "font-size":12.5, "font-weight":700, fill:"#1d4e66"});
  tT.textContent = "T · Disparador";
  svg.appendChild(tT);

  svg.appendChild(Kit.svg("rect", {x:158, y:96, width:108, height:64, rx:9, fill:"#fdf8ec", stroke:"#c9962f", "stroke-width":2, filter:f}));
  const tR = Kit.svg("text", {x:212, y:125, "text-anchor":"middle", "font-size":12.5, "font-weight":700, fill:"#8f6514"});
  tR.textContent = "R · Malestar";
  svg.appendChild(tR);

  /* Vía superior TRAP (bucle) */
  svg.appendChild(Kit.svg("path", {
    d:"M 280 130 C 340 125, 360 58, 450 58 L 620 58",
    fill:"none", stroke:enTrac ? "#cfdce6" : "#c26a4e", "stroke-width":enTrac ? 2.2 : 4,
    "stroke-dasharray":enTrac ? "5 5" : "none"
  }));
  svg.appendChild(Kit.svg("rect", {x:420, y:24, width:246, height:68, rx:10,
    fill:enTrac ? "#f6f8fa" : "#fdf2ee", stroke:"#c26a4e", "stroke-width":enTrac ? 1.3 : 2.3, filter:f}));
  const tAP = Kit.svg("text", {x:543, y:49, "text-anchor":"middle", "font-size":13, "font-weight":700, fill:"#8a3526"});
  tAP.textContent = "TRAP · Patrón de evitación (AP)";
  svg.appendChild(tAP);
  const sAP = Kit.svg("text", {x:543, y:71, "text-anchor":"middle", "font-size":11, fill:"#5a6a7d"});
  sAP.textContent = (Kit.activas("patronTRAP")[0] || "Alivio corto → más encierro y bajón").slice(0, 36);
  svg.appendChild(sAP);

  /* Vía inferior TRAC (avance) */
  svg.appendChild(Kit.svg("path", {
    d:"M 280 130 C 340 135, 360 184, 450 184 L 620 184",
    fill:"none", stroke:enTrac ? "#3f9b86" : "#cfdce6", "stroke-width":enTrac ? 4 : 2.2,
    "stroke-dasharray":enTrac ? "none" : "5 5"
  }));
  svg.appendChild(Kit.svg("rect", {x:420, y:148, width:246, height:68, rx:10,
    fill:enTrac ? "#eaf6f1" : "#f6f8fa", stroke:"#3f9b86", "stroke-width":enTrac ? 2.4 : 1.3, filter:f}));
  const tAC = Kit.svg("text", {x:543, y:173, "text-anchor":"middle", "font-size":13, "font-weight":700, fill:"#256656"});
  tAC.textContent = "TRAC · Afrontamiento alternativo (AC)";
  svg.appendChild(tAC);
  const sAC = Kit.svg("text", {x:543, y:195, "text-anchor":"middle", "font-size":11, fill:"#5a6a7d"});
  sAC.textContent = (Kit.activas("caminoTRAC")[0] || "Paso pequeño → contacto con la vida").slice(0, 36);
  svg.appendChild(sAC);

  /* Aguja de cambio */
  svg.appendChild(Kit.svg("circle", {cx:280, cy:130, r:8, fill:enTrac ? "#3f9b86" : "#c26a4e", stroke:"#fff", "stroke-width":2}));
}

function resumen(){
  const l = [];
  [["T · Disparador","trapT"],["R · Respuesta interna","trapR"],
   ["AP · Patrón de evitación (TRAP)","patronTRAP"],["AC · Afrontamiento alternativo (TRAC)","caminoTRAC"]].forEach(([rot, id]) => {
    const v = Kit.activas(id);
    if(v.length) l.push(rot + ": " + v.join(", "));
  });
  return l.join("\n");
}

Kit.chips("trapT", LISTA_T, dibujar);
Kit.chips("trapR", LISTA_R, dibujar);
Kit.chips("patronTRAP", LISTA_AP, dibujar);
Kit.chips("caminoTRAC", LISTA_AC, dibujar);
dibujar();

Kit.iniciar({
  clave: "tcc-trap-a-trac",
  extra: () => ({riel}),
  restaurar: d => { riel = (d && d.riel) || "trap"; moverAguja(riel); },
  alCambiar: dibujar,
  resumen: resumen
});
