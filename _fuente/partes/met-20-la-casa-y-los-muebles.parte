@@meta
archivo: met-la-casa-y-los-muebles.html
titulo: La casa y los muebles
enfoque: ACT
etiqueta: Yo como contexto
sub: Una casa amplia con muebles que entran y salen solos. Se puede pasar el día junto al mueble incómodo, sacarlo a empujones (vuelve) o recorrer las demás habitaciones con el mueble en su rincón.
fuente: Metáfora de la casa y los muebles de Wilson y Luciano (2002, Terapia de Aceptación y Compromiso: Un tratamiento conductual orientado a los valores, Pirámide).
resumen: Los muebles llegan y se van solos; la casa no cambia. Vigilar el mueble incómodo deja el resto de la casa a oscuras; sacarlo a empujones lo devuelve a su rincón; recorrer la casa enciende las habitaciones. El marcador cuenta las habitaciones que se volvieron a habitar.
@@css
  .marcas div{min-width:130px}
  .cm-campos{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}
  .cm-campos textarea{min-height:54px}
  .mandos button.sacar{background:#7a4b3a;border-color:#7a4b3a;color:#fff;font-weight:600}
  .mandos button.sacar:hover{background:#673e30;border-color:#673e30}
  .mandos button.recorrer{background:#2f7a5f;border-color:#2f7a5f;color:#fff;font-weight:600}
  .mandos button.recorrer:hover{background:#27674f;border-color:#27674f}
@@html
<section class="paso">
  <h2><span class="num">1</span>Los muebles de hoy</h2>
  <div class="cuerpo">
    <div class="cm-campos">
      <div><label class="etiqueta" for="cmIncomodo">El mueble incómodo</label>
        <textarea id="cmIncomodo" placeholder="La emoción o preocupación que hoy ocupa un rincón"></textarea></div>
      <div><label class="etiqueta" for="cmViejo">El mueble viejo</label>
        <textarea id="cmViejo" placeholder="Una historia antigua sobre ti que lleva años guardada"></textarea></div>
      <div><label class="etiqueta" for="cmValioso">El mueble que sí eliges</label>
        <textarea id="cmValioso" placeholder="Un vínculo, una capacidad, un propósito"></textarea></div>
    </div>
    <label class="etiqueta">La habitación que quieres usar hoy</label>
    <div class="chips" id="habitacion">
      <button class="chip" data-v="Estar con las personas que quiero">Estar con las personas que quiero</button>
      <button class="chip" data-v="Avanzar en mi proyecto">Avanzar en mi proyecto</button>
      <button class="chip" data-v="Cuidar mi cuerpo y mi descanso">Cuidar mi cuerpo y mi descanso</button>
      <button class="chip" data-v="Un rato de curiosidad o juego">Un rato de curiosidad o juego</button>
    </div>
  </div>
</section>

<div class="escenario">
  <svg id="svgCasa" viewBox="0 0 700 350" role="img" aria-label="Corte de una casa de dos pisos con muebles y una persona"></svg>
  <div class="marcas">
    <div><span class="n" id="mVolvi" style="color:#2f7a5f">0</span><span class="r">habitaciones que volví a habitar</span></div>
  </div>
  <div class="mandos">
    <button type="button" class="sacar" id="bSacar">Sacar el mueble a empujones</button>
    <button type="button" class="recorrer" id="bRecorrer">Ir a otra habitación</button>
    <button type="button" id="bReiniciar">Empezar de nuevo</button>
  </div>
</div>

<section class="bloque pregunta-sola" id="cierre">
  <div class="pregunta" id="textoPregunta">Por pesado que sea un mueble, no se vuelve la casa. ¿En qué rincón has pasado estos días?</div>
  <details class="apunte">
    <summary>Anotar lo conversado</summary>
    <textarea id="apunte" placeholder="Cómo vas a habitar hoy el resto de tu casa..."></textarea>
  </details>
</section>
@@js
const $ = Kit.$;
Kit.chips("habitacion", {multiple:false, libre:true});

/* ----- geometría de la casa en acuarela (700 x 350) ----- */
const PISO = [305, 186];                       // línea del suelo: planta baja y piso alto
const PUERTA = 226;                            // por donde entran y salen los muebles (planta baja)
const CUARTOS = [                              // x0, x1, piso, x donde se para la persona
  {x0:92,  x1:250, p:0, x:188}, {x0:250, x1:462, p:0, x:330}, {x0:462, x1:640, p:0, x:520},
  {x0:92,  x1:250, p:1, x:205}, {x0:250, x1:462, p:1, x:320}, {x0:462, x1:640, p:1, x:540},
];
const VALIOSA = 2, RECORRIDO = [2, 5, 4, 3, 1, 0];
const ESCALERA = [[448, 305], [408, 214], [384, 186]];   // pie, descanso, llegada arriba
const F = {
  persona: {href:"[[imagen:invitado-anfitrion-camina.webp]]", r:0.513, h:76},
  sillon:  {href:"[[imagen:casa-sillon.webp]]",  r:0.97,  h:64},
  armario: {href:"[[imagen:casa-armario.webp]]", r:0.7, h:94},
  piano:   {href:"[[imagen:casa-piano.webp]]",   r:1.08,   h:72},
  cajas:   {href:"[[imagen:casa-cajas.webp]]",   r:1.19,   h:54},
  lampara: {href:"[[imagen:casa-lampara.webp]]", r:0.379, h:78},
  espejo:  {href:"[[imagen:casa-espejo.webp]]",  r:0.533,  h:76},
};
const RINCON = 132;                            // rincón del mueble incómodo (planta baja, izquierda)
const PASAJEROS = ["cajas", "lampara", "espejo"], HUECOS = [300, 372, 598];

let yo, sillon, luz, visitas, sigVisita, turno, volvi, t, paso;
function reiniciar(){
  yo = {x:182, y:PISO[0], cuarto:0, ruta:[], mira:-1};       // empieza junto al mueble incómodo
  sillon = {x:RINCON, modo:"quieto", espera:0};              // quieto | sale | fuera | vuelve
  luz = [1, 0, 0, 0, 0, 0];
  visitas = []; sigVisita = 3; turno = 0; volvi = 0; t = 0; paso = 0;
  $("textoPregunta").textContent = "Por pesado que sea un mueble, no se vuelve la casa. ¿En qué rincón has pasado estos días?";
}
reiniciar();

function rutaA(destino){
  const a = CUARTOS[yo.cuarto], b = CUARTOS[destino], r = [];
  if(a.p !== b.p){
    const esc = a.p === 0 ? ESCALERA : ESCALERA.slice().reverse();
    esc.forEach(p => r.push(p));
  }
  r.push([b.x, PISO[b.p]]);
  return r;
}

const escena = Kit.reloj(latido);
function latido(dt){
  t += dt;
  /* la persona camina por su ruta */
  if(yo.ruta.length){
    const [mx, my] = yo.ruta[0], dx = mx - yo.x, dy = my - yo.y, dist = Math.hypot(dx, dy), av = 62 * dt;
    if(Math.abs(dx) > 1) yo.mira = Math.sign(dx);
    if(dist <= av){ yo.x = mx; yo.y = my; yo.ruta.shift(); }
    else { yo.x += dx / dist * av; yo.y += dy / dist * av; }
  }
  /* cada habitación se enciende mientras se la habita y se apaga despacio al dejarla */
  const aqui = yo.ruta.length ? -1 : yo.cuarto;
  luz = luz.map((v, i) => i === aqui ? Math.min(1, v + dt * 1.5) : Math.max(0, v - dt * 0.035));

  /* el mueble incómodo: sale a empujones y vuelve solo a su rincón */
  if(sillon.modo === "espera"){
    if(!yo.ruta.length) sillon.modo = "sale";
  } else if(sillon.modo === "sale"){
    sillon.x += 46 * dt; yo.x = sillon.x - 46; yo.mira = 1;
    if(sillon.x >= PUERTA){ sillon.modo = "fuera"; sillon.espera = 3.2; }
  } else if(sillon.modo === "fuera"){
    sillon.espera -= dt;
    if(sillon.espera <= 0) sillon.modo = "vuelve";
  } else if(sillon.modo === "vuelve"){
    sillon.x -= 30 * dt;
    if(sillon.x <= RINCON){
      sillon.x = RINCON; sillon.modo = "quieto";
      $("textoPregunta").textContent = "El mueble volvió a su rincón sin pedir permiso. ¿Cuánto de tu día se va en sacarlo?";
    }
  }

  /* otros muebles llegan y se van por su cuenta: la casa sigue siendo la misma */
  sigVisita -= dt;
  if(sigVisita <= 0 && visitas.length < 3){
    const libres = HUECOS.filter(h => !visitas.some(v => v.meta === h));
    const usados = visitas.map(v => v.que), que = PASAJEROS.find(q => !usados.includes(q));
    if(libres.length && que) visitas.push({que, x:PUERTA, meta:libres[turno++ % libres.length], modo:"entra", queda:14 + Math.random() * 8});
    sigVisita = 6 + Math.random() * 4;
  }
  visitas.forEach(v => {
    if(v.modo === "entra"){ v.x += 38 * dt; if(v.x >= v.meta){ v.x = v.meta; v.modo = "esta"; } }
    else if(v.modo === "esta"){ v.queda -= dt; if(v.queda <= 0) v.modo = "sale"; }
    else { v.x -= 38 * dt; }
  });
  visitas = visitas.filter(v => !(v.modo === "sale" && v.x <= PUERTA));
  dibujar();
}

let fondo = null;
function dibujar(){
  const svg = $("svgCasa");
  svg.innerHTML = "";
  const g = (tg, a, p) => (p || svg).appendChild(Kit.svg(tg, a));
  const rotulo = (x, y, s, color) => {
    if(!s) return;
    const e = Kit.svg("text", {x, y, "text-anchor":"middle",
      style:`font:600 11px Georgia,serif;font-style:italic;fill:${color || "#3b3128"};paint-order:stroke;stroke:#fffaf0;stroke-width:3.5px;stroke-linejoin:round`});
    e.textContent = s.length > 28 ? s.slice(0, 26) + "…" : s; svg.appendChild(e);
  };
  const mueble = (clave, que, x, piso, op) => {
    const f = F[que], w = f.h * f.r;
    svg.appendChild(Kit.figura(clave, f.href, {x:x - w / 2, y:PISO[piso] - f.h, width:w, height:f.h, opacity:op == null ? 1 : op}));
  };
  if(!fondo) fondo = Kit.svg("image", {href:"[[imagen:casa-acuarela.jpg]]", x:0, y:0, width:700, height:350, preserveAspectRatio:"none"});
  svg.appendChild(fondo);

  /* muebles */
  mueble("armario", "armario", 150, 1);
  rotulo(150, PISO[1] - F.armario.h - 5, $("cmViejo").value.trim());
  mueble("piano", "piano", 572, 0);
  rotulo(572, PISO[0] - F.piano.h - 5, $("cmValioso").value.trim(), "#1f5a45");
  visitas.forEach(v => mueble("v" + v.que, v.que, v.x, 0, Math.min(1, Math.abs(v.x - PUERTA) / 26)));
  if(sillon.modo !== "fuera"){
    mueble("sillon", "sillon", sillon.x, 0, sillon.modo === "quieto" || sillon.modo === "espera" ? 1 : Math.min(1, (PUERTA - sillon.x) / 26 + 0.15));
    rotulo(sillon.x, PISO[0] - F.sillon.h - 5, $("cmIncomodo").value.trim(), "#7a3328");
  }
  const hab = Kit.activas("habitacion")[0];
  if(hab) rotulo(551, 216, hab, "#1f5a45");

  /* la persona */
  const camina = yo.ruta.length || sillon.modo === "sale";
  const f = F.persona, w = f.h * f.r, bote = camina ? Math.abs(Math.sin(t * 9)) * 1.6 : 0;
  const gp = Kit.svg("g", {transform:`translate(${yo.x.toFixed(1)} ${(yo.y - bote).toFixed(1)}) scale(${yo.mira} 1)`});
  gp.appendChild(Kit.figura("yo", f.href, {x:-w / 2, y:-f.h, width:w, height:f.h}));
  svg.appendChild(gp);

  /* la penumbra de las habitaciones que nadie está habitando */
  CUARTOS.forEach((c, i) => {
    const y0 = c.p === 0 ? 198 : 78, sombra = 0.36 * (1 - luz[i]);
    if(sombra > 0.01) g("rect", {x:c.x0, y:y0, width:c.x1 - c.x0, height:118, fill:"#18222e", opacity:sombra.toFixed(3), style:"mix-blend-mode:multiply"});
  });

  const libre = !yo.ruta.length && sillon.modo === "quieto";
  $("mVolvi").textContent = volvi;
  $("bSacar").disabled = !libre;
  $("bRecorrer").disabled = !libre;
}

$("bSacar").addEventListener("click", () => {
  if(yo.ruta.length || sillon.modo !== "quieto") return;
  if(yo.cuarto !== 0){ yo.ruta = rutaA(0); yo.cuarto = 0; }
  yo.ruta.push([RINCON - 46, PISO[0]]);
  sillon.modo = "espera";                     // empieza a empujar al llegar junto al mueble
  Kit.guardar();
});
$("bRecorrer").addEventListener("click", () => {
  if(yo.ruta.length || sillon.modo !== "quieto") return;
  const destino = RECORRIDO[paso++ % RECORRIDO.length];
  yo.ruta = rutaA(destino); yo.cuarto = destino; volvi++;
  if(volvi === 2) $("textoPregunta").textContent = "El mueble incómodo sigue en su rincón y la casa se fue encendiendo. ¿Qué habitación de tu vida quieres habitar hoy con ese mueble donde está?";
  Kit.guardar();
});
$("bReiniciar").addEventListener("click", () => { reiniciar(); Kit.guardar(); });

Kit.iniciar({
  clave: "met-la-casa-y-los-muebles",
  alCambiar: dibujar,
  resumen: () => {
    const inc = $("cmIncomodo").value.trim() || "—", vie = $("cmViejo").value.trim() || "—", val = $("cmValioso").value.trim() || "—";
    const ap = $("apunte").value.trim();
    return [
      "LA CASA Y LOS MUEBLES",
      `Mueble incómodo hoy: ${inc}`,
      `Mueble viejo: ${vie}`,
      `Mueble que sí elijo: ${val}`,
      `Habitación que quiero usar: ${Kit.activas("habitacion")[0] || "—"}`,
      `Habitaciones que volví a habitar: ${volvi}`,
      ap ? `Lo conversado: ${ap}` : ""
    ].filter(Boolean).join("\n");
  }
});
escena.andar();
