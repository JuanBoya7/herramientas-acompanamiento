@@meta
archivo: act-soltar-el-anzuelo.html
titulo: Soltar el anzuelo
orden: 04
enfoque: ACT
etiqueta: Defusión
sub: El pensamiento baja solo al agua, como un anzuelo con su carnada, y engancha. Cinco ejercicios cortos para soltarlo sin discutir si es verdad; el anzuelo sigue ahí y vuelve.
fuente: Defusión cognitiva y desliteralización del lenguaje, en Díaz Corbobés, MANUAL ACT §3.4, con la teoría del marco relacional de §1.2 como fundamento.
resumen: El anzuelo con el pensamiento baja solo y engancha al pez, que queda tirado hacia arriba. Cada ejercicio de defusión hecho en sesión lo suelta; el anzuelo no desaparece y vuelve a bajar. El marcador cuenta las veces que se soltó. Termina eligiendo el ejercicio que se lleva a la semana.
campo3: Sesión
campo3ph: Ej. Sesión 5
@@css
  .marcas div{min-width:130px}
  #pensamiento{min-height:58px}
  .ej-lista{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:12px}
  .ej-panel{max-width:620px;margin:12px auto 0;border:1px solid var(--linea);border-left:4px solid #2f7a5f;border-radius:10px;
    padding:12px 15px;background:#f7faf9}
  .ej-panel b{display:block;font-size:15px;margin-bottom:4px}
  .ej-panel p{margin:0 0 10px;font-size:14.5px;line-height:1.5}
  .ej-panel button{background:#2f7a5f;border-color:#2f7a5f;color:#fff;font-weight:600}
  .ej-panel button:hover{background:#27674f;border-color:#27674f}
  .ej-panel button:disabled{background:#b9d3c8;border-color:#b9d3c8}
@@html
<section class="paso">
  <h2><span class="num">1</span>El pensamiento que engancha</h2>
  <div class="cuerpo">
    <textarea id="pensamiento" placeholder="Uno solo, tal como aparece. Ej. «No sirvo para esto.»"></textarea>
  </div>
</section>

<div class="escenario">
  <svg id="svgLago" viewBox="0 0 700 467" role="img" aria-label="Un lago visto en corte: un pez y un anzuelo que baja con un pensamiento como carnada"></svg>
  <div class="marcas">
    <div><span class="n" id="mVolvi" style="color:#2f7a5f">0</span><span class="r">veces que solté el anzuelo</span></div>
  </div>
  <div class="ej-lista" id="ejLista"></div>
  <div class="ej-panel" id="ejPanel" hidden>
    <b id="ejNombre"></b>
    <p id="ejComo"></p>
    <button type="button" id="bHecho">Lo hicimos</button>
  </div>
</div>

<section class="paso">
  <h2><span class="num">2</span>El que se lleva</h2>
  <div class="cuerpo">
    <label class="etiqueta">Ejercicio elegido</label>
    <div class="chips" id="elegido"></div>
    <label class="etiqueta">¿Cuándo lo va a usar?</label>
    <div class="chips" id="cuando"></div>
  </div>
</section>

<section class="bloque pregunta-sola" id="cierre">
  <div class="pregunta" id="lPregunta">La pregunta no es si el pensamiento es verdad, sino qué pasa contigo cuando lo muerdes. ¿Hacia dónde te lleva cuando tira?</div>
  <details class="apunte">
    <summary>Anotar lo conversado</summary>
    <textarea id="apunte" placeholder="Qué podrías hacer hoy con ese pensamiento todavía ahí..."></textarea>
  </details>
</section>
@@js
const $ = Kit.$;

/* Cinco, los que caben en menos de un minuto y se pueden hacer de pie.
   Los largos —el arroyo y el tablero— tienen hoja propia. */
const EJERCICIOS = [
 {id:"marco", nombre:"«Estoy teniendo el pensamiento de que…»",
  como:"Di la frase tal cual. Después con «estoy teniendo el pensamiento de que…» delante. Y una " +
       "tercera vez: «me doy cuenta de que estoy teniendo el pensamiento de que…»."},
 {id:"gracias", nombre:"Gracias, mente",
  como:"Cuando aparezca, contéstale «gracias, mente». Sin ironía y sin pelea, como quien recibe " +
       "un aviso que ya conocía."},
 {id:"voz", nombre:"Ponerle otra voz",
  como:"Dilo con voz de dibujo animado, de locutor de fútbol, o cantado. En serio y en voz alta, " +
       "aunque dé pena."},
 {id:"historia", nombre:"Ponerle nombre a la historia",
  como:"Titúlala como una película: «ahí está otra vez La historia de que no doy la talla». Y " +
       "anúnciala por su título cada vez que vuelva."},
 {id:"repetir", nombre:"Repetir la palabra hasta vaciarla",
  como:"Toma la palabra más cargada —«inútil», «fracaso»— y repítela rápido y sin parar cuarenta " +
       "y cinco segundos, hasta que suene a ruido."}
];

/* ----- geometría del lago en acuarela (700 x 467) ----- */
const AGUA = 100;                 /* línea de la superficie */
const PEZ = {href:"[[imagen:anzuelo-pez.webp]]", r:2.543, w:118};
const OTROS = [{x:120, y:210, txt:"«¿Y si…?»"}, {x:600, y:250, txt:"«Nunca…»"}];   /* otros anzuelos: siempre hay más */

let pez, anz, t, volvi, hechos, elegidoEj, tiron;
function reiniciar(){
  pez = {x:350, y:310, mira:1};
  anz = {x:430, y:170, fase:"suelto", espera:4};     /* suelto | baja | clavado */
  t = 0; volvi = 0; hechos = {}; elegidoEj = null; tiron = 0;
}
reiniciar();

const escena = Kit.reloj(latido);
function latido(dt){
  t += dt;
  if(anz.fase === "suelto"){
    /* el pez nada a lo suyo; el anzuelo cuelga y, al rato, vuelve a bajar solo */
    const nx = 350 + Math.sin(t * 0.45) * 190, ny = 322 + Math.sin(t * 0.8) * 34;
    pez.mira = nx >= pez.x ? 1 : -1;
    pez.x += (nx - pez.x) * Math.min(1, dt * 1.6); pez.y += (ny - pez.y) * Math.min(1, dt * 1.6);
    anz.y += (176 + Math.sin(t * 1.1) * 6 - anz.y) * Math.min(1, dt * 2);
    anz.espera -= dt;
    if(anz.espera <= 0) anz.fase = "baja";
  } else if(anz.fase === "baja"){
    /* el anzuelo baja con su carnada y el pez, sin pensarlo, va hacia ella y muerde */
    anz.y += (296 - anz.y) * Math.min(1, dt * 1.2);
    pez.mira = anz.x >= pez.x ? 1 : -1;
    const bx = anz.x - pez.mira * PEZ.w * 0.46;
    pez.x += (bx - pez.x) * Math.min(1, dt * 1.4); pez.y += (anz.y - pez.y) * Math.min(1, dt * 1.4);
    if(Math.abs(bx - pez.x) < 6 && Math.abs(anz.y - pez.y) < 6 && anz.y > 280){ anz.fase = "clavado"; tiron = 1; }
  } else {
    /* enganchado: el sedal tira hacia arriba y el pez va detrás, a tirones */
    tiron = Math.max(0, tiron - dt * 1.4);
    if(Math.random() < dt * 0.5) tiron = 1;
    anz.y += (150 - anz.y) * Math.min(1, dt * 0.9);
    anz.x += Math.sin(t * 7) * 14 * dt;
    pez.x = anz.x - pez.mira * PEZ.w * 0.46; pez.y = anz.y + Math.sin(t * 16) * 2.5 * (0.4 + tiron);
  }
  dibujar();
}

function renglones(s, n){
  const out = []; let fila = "";
  s.split(/\s+/).forEach(p => { if((fila + " " + p).trim().length > n){ out.push(fila); fila = p; } else fila = (fila + " " + p).trim(); });
  if(fila) out.push(fila);
  if(out.length > 3){ out.length = 3; out[2] = out[2].replace(/.{0,2}$/, "…"); }
  return out;
}
let fondo = null;
function anzuelo(svg, x, y, texto, grande){
  const g = (tg, a) => svg.appendChild(Kit.svg(tg, a));
  g("line", {x1:x, y1:AGUA + 2, x2:x, y2:y - 16, stroke:"#e9f2f2", "stroke-width":grande ? 1.6 : 1.1, opacity:.9});
  g("path", {d:`M${x} ${y - 16} L${x} ${y} q0 11 -9 11 q-9 0 -9 -9 l4 3`, fill:"none", stroke:"#3a4046", "stroke-width":grande ? 3 : 2.2,
    "stroke-linecap":"round", "stroke-linejoin":"round"});
  /* la carnada: el pensamiento en un papel */
  const filas = renglones(texto, grande ? 18 : 12), alto = filas.length * (grande ? 15 : 12) + 10;
  const ancho = Math.max(...filas.map(s => s.length)) * (grande ? 7.1 : 5.8) + 16;
  const gp = Kit.svg("g", {transform:`translate(${x + 12} ${y - (grande ? 34 : 10)}) rotate(${(Math.sin(t * 1.3 + x) * 4).toFixed(1)})`, opacity:grande ? 1 : .8});
  gp.appendChild(Kit.svg("rect", {x:0, y:-alto / 2, width:ancho, height:alto, rx:3, fill:"#fff6d8", stroke:"#b9a56a", "stroke-width":1}));
  filas.forEach((s, i) => {
    const e = Kit.svg("text", {x:ancho / 2, y:-alto / 2 + (grande ? 17 : 14) + i * (grande ? 15 : 12), "text-anchor":"middle",
      style:`font:600 ${grande ? 12.5 : 10}px Georgia,serif;font-style:italic;fill:#3b3128`});
    e.textContent = s; gp.appendChild(e);
  });
  svg.appendChild(gp);
}
function dibujar(){
  const svg = $("svgLago");
  svg.innerHTML = "";
  if(!fondo) fondo = Kit.svg("image", {href:"[[imagen:anzuelo-acuarela.jpg]]", x:0, y:0, width:700, height:467, preserveAspectRatio:"none"});
  svg.appendChild(fondo);

  OTROS.forEach(o => anzuelo(svg, o.x, o.y + Math.sin(t * 0.9 + o.x) * 5, o.txt, false));

  /* el pez */
  const h = PEZ.w / PEZ.r, clavado = anz.fase === "clavado";
  const gp = Kit.svg("g", {transform:`translate(${pez.x.toFixed(1)} ${pez.y.toFixed(1)}) scale(${pez.mira} 1) rotate(${clavado ? -24 - tiron * 8 : Math.sin(t * 2.2) * 3})`});
  gp.appendChild(Kit.figura("pez", PEZ.href, {x:-PEZ.w / 2, y:-h / 2, width:PEZ.w, height:h}));
  svg.appendChild(gp);

  const pens = $("pensamiento").value.trim() || "«No sirvo para esto»";
  anzuelo(svg, anz.x, anz.y, pens, true);

  $("mVolvi").textContent = volvi;
  $("bHecho").disabled = !clavado;
}

/* ----- los ejercicios: cada uno, hecho en voz alta, suelta el anzuelo ----- */
$("ejLista").innerHTML = EJERCICIOS.map(e => `<button type="button" class="chip" data-ej="${e.id}">${e.nombre}</button>`).join("");
function pintarEj(){
  document.querySelectorAll("#ejLista .chip").forEach(b => {
    const n = hechos[b.dataset.ej] || 0, e = EJERCICIOS.find(x => x.id === b.dataset.ej);
    b.classList.toggle("activa", elegidoEj === b.dataset.ej);
    b.textContent = e.nombre + (n ? " · " + n : "");
  });
  const e = EJERCICIOS.find(x => x.id === elegidoEj);
  $("ejPanel").hidden = !e;
  if(e){ $("ejNombre").textContent = e.nombre; $("ejComo").textContent = e.como; }
}
document.querySelectorAll("#ejLista .chip").forEach(b => b.addEventListener("click", () => { elegidoEj = b.dataset.ej; pintarEj(); }));
$("bHecho").addEventListener("click", () => {
  if(anz.fase !== "clavado" || !elegidoEj) return;
  hechos[elegidoEj] = (hechos[elegidoEj] || 0) + 1;
  volvi++;
  anz.fase = "suelto"; anz.espera = 9;
  if(volvi === 2) $("lPregunta").textContent = "El anzuelo sigue ahí y va a volver a bajar. Con ese pensamiento todavía en el agua, ¿qué podrías hacer hoy que no estabas haciendo?";
  pintarEj();
  Kit.guardar();
});

Kit.chips("elegido", EJERCICIOS.map(e => e.nombre), () => {}, true);
Kit.chips("cuando", ["Cuando empiece la rumia","Antes de dormir","Antes de algo que me da miedo"]);

function resumen(){
  const l = [];
  l.push("PENSAMIENTO TRABAJADO");
  l.push($("pensamiento").value.trim() || "(sin registrar)");
  const usados = EJERCICIOS.filter(e => hechos[e.id]);
  l.push("", `EJERCICIOS HECHOS EN SESIÓN (${usados.length} de ${EJERCICIOS.length})`);
  if(!usados.length) l.push("(ninguno)");
  usados.forEach(e => l.push(`- ${e.nombre}: ${hechos[e.id]} ${hechos[e.id] === 1 ? "vez" : "veces"}`));
  l.push(`Veces que soltó el anzuelo: ${volvi}`);
  const sel = Kit.activas("elegido"), cu = Kit.activas("cuando");
  if(sel.length || cu.length)
    l.push("", "PARA LA SEMANA",
      "Ejercicio: " + (sel.join(", ") || "sin elegir"),
      "Momento: " + (cu.join(", ") || "sin marcar"));
  if($("apunte").value.trim()) l.push("", "Notas: " + $("apunte").value.trim());
  return l.join("\n");
}

Kit.iniciar({
  clave: "act-soltar-el-anzuelo",
  extra: () => ({hechos, volvi}),
  restaurar: d => {
    hechos = (d && d.hechos && !Array.isArray(d.hechos)) ? d.hechos : {};
    volvi = (d && d.volvi) || 0;
  },
  alCambiar: () => { pintarEj(); dibujar(); },
  resumen: resumen
});
pintarEj();
escena.andar();
