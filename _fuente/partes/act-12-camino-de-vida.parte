@@meta
archivo: act-camino-de-vida.html
titulo: El camino de vida y el giro
orden: 15
enfoque: ACT
etiqueta: Formulación breve
sub: En un mismo sendero hay dos direcciones: correr hacia un lado para quitar el dolor o la incomodidad de encima, o caminar hacia el otro para construir una vida con sentido. Cambiar de rumbo no exige llegar hoy al horizonte ni dejar de sentir lo que llevas puesto: empieza por detener la prisa y girar los pies.
fuente: El ejercicio del camino de vida y giro (Life Path and Turnaround) y los cuatro cuadrantes de funcionabilidad, en Strosahl, Robinson y Gustavsson, Brief Interventions for Radical Change: FACT (2012), caps. 4 y 5.
resumen: Se sitúa el momento vital en cuatro pilares, qué se ha intentado quitar del camino y qué costo ha tenido. En la escena del sendero se ensaya el giro de 180° en tres pequeños movimientos de pies hacia lo que importa.
@@css
  .sendero-giro{display:block;width:100%;height:auto;max-width:700px;margin:0 auto}
  .fase{font-size:19px;font-weight:700;text-align:center;margin:8px auto 2px;color:var(--acento);
    min-height:28px;max-width:600px;line-height:1.35}
  .fase-sub{text-align:center;font-size:14px;color:var(--tinta-suave);max-width:560px;margin:0 auto;
    min-height:22px;line-height:1.5}
@@html
<section class="paso">
  <h2><span class="num">1</span>Los cuatro pilares hoy y el costo del alivio</h2>
  <p class="ayuda">Dónde pesa más el momento actual, qué has estado intentando quitar del medio para
  sentir alivio rápido y cómo ha resultado eso con el tiempo.</p>
  <div class="cuerpo">
    <label class="etiqueta">En qué pilares de tu vida se nota más hoy</label>
    <div class="chips" id="pilares"></div>
    <label class="etiqueta">Qué intentas quitar del camino antes de avanzar</label>
    <div class="chips" id="buscadoQuitar"></div>
    <label class="etiqueta">Qué ha pasado al buscar ese alivio inmediato</label>
    <div class="chips" id="efectosCortoLargo"></div>
  </div>
</section>

<div class="escenario">
  <svg class="sendero-giro" id="svgGiro" viewBox="0 0 700 250" role="img"
    aria-label="Un sendero entre el alivio inmediato a la izquierda y la vida con sentido a la derecha, donde una figura gira 180 grados en tres pasos"></svg>
  <div class="fase" id="fase">Mirando hacia el alivio inmediato (0°)</div>
  <div class="fase-sub" id="faseSub">Los pies apuntan a controlar o evitar el malestar antes de vivir.</div>
  <div class="duracion" id="pasosGiro">
    <button type="button" class="chip activa" id="g0" onclick="irGiro(0)">0 · En la huida automática</button>
    <button type="button" class="chip" id="g1" onclick="irGiro(1)">1 · Detener la marcha automática</button>
    <button type="button" class="chip" id="g2" onclick="irGiro(2)">2 · Girar medio cuerpo hacia lo que importa</button>
    <button type="button" class="chip" id="g3" onclick="irGiro(3)">3 · Dar el primer paso corto con lo que llevo puesto</button>
  </div>
</div>

<section class="bloque pregunta-sola">
  <div class="pregunta" id="pregunta">Sin pretender llegar hoy al final del camino, ¿qué gesto pequeño mostraría que ya diste vuelta los pies?</div>
  <div class="cuerpo" style="padding:10px 0 0">
    <div class="chips" id="primerGiro"></div>
  </div>
</section>
@@js
const $ = Kit.$;

const PILARES = [
  "Vínculos y familia",
  "Trabajo u ocupación diaria",
  "Descanso y recreación",
  "Cuidado de la salud"
];
const QUITAR = [
  "La tristeza o el vacío",
  "La incertidumbre",
  "Los recuerdos dolorosos",
  "La tensión en las relaciones"
];
const EFECTOS = [
  "Alivia un rato y después pesa más",
  "Me ha ido dejando más solo",
  "Mi vida se volvió más pequeña",
  "Siento que camino en círculos"
];
const PRIMER_GIRO = [
  "Quedarme cinco minutos más sin huir de la situación",
  "Responder con honestidad en vez de dar excusas",
  "Hacer una sola cosa de cuidado hoy aunque no tenga ganas",
  "Acercarme a alguien importante llevando mi incomodidad"
];

let etapa = 0;        /* 0, 1, 2, 3 -> 0°, 60°, 120°, 180° */
let angulo = 0;       /* de 0 (izquierda) a 180 (derecha) */
let fondoColinas = null;

const ETAPAS_INFO = [
  ["Mirando hacia el alivio inmediato (0°)",
   "Los pies apuntan a controlar o evitar el malestar antes de vivir."],
  ["1 · Detener la marcha automática (60°)",
   "Notas el tirón de escapar y haces una pausa sin dar un paso más en esa dirección."],
  ["2 · Girar medio cuerpo hacia lo que importa (120°)",
   "Reconoces qué pilar de tu vida quieres cuidar y orientas la mirada hacia allá."],
  ["3 · Primer paso corto en la dirección valiosa (180°)",
   "Tus pies ya miran hacia una vida con sentido, llevando contigo lo que hoy sientes."]
];

function dibujar(){
  const svg = $("svgGiro");
  svg.innerHTML = "";
  const g = (tag, a) => svg.appendChild(Kit.svg(tag, a));

  g("rect", {x:0, y:0, width:700, height:250, fill:"#f2f6f8"});
  if(!fondoColinas) fondoColinas = Kit.svg("image", {
    href:"[[imagen:colinas-acuarela.jpg]]", x:0, y:-20, width:700, height:270,
    preserveAspectRatio:"none", opacity:.8
  });
  svg.appendChild(fondoColinas);

  /* el sendero horizontal */
  g("path", {
    d:"M0 158 Q 175 150 350 158 T 700 156 L700 222 Q 525 228 350 220 T 0 224 Z",
    fill:"#dfd5c3", stroke:"#b8aa93", "stroke-width":1.8
  });

  /* cartel izquierdo: Alivio inmediato (controlar y evitar) */
  g("rect", {x:16, y:26, width:218, height:56, rx:9, fill:"#fdf3ef", stroke:"#d99b8c", "stroke-width":1.6});
  const ti1 = g("text", {x:125, y:46, "text-anchor":"middle", style:"font:700 11.5px system-ui,sans-serif;fill:#9e3c2c"});
  ti1.textContent = "← el alivio inmediato";
  const ti2 = g("text", {x:125, y:66, "text-anchor":"middle", style:"font:600 11.5px system-ui,sans-serif;fill:#6e433b"});
  const q = Kit.activas("buscadoQuitar")[0] || "Controlar y evitar sentir";
  ti2.textContent = q.length > 30 ? q.slice(0, 29) + "…" : q;

  /* cartel derecho: Construir una vida con sentido */
  g("rect", {x:466, y:26, width:218, height:56, rx:9, fill:"#f1faf5", stroke:"#88bfa0", "stroke-width":1.8});
  const td1 = g("text", {x:575, y:46, "text-anchor":"middle", style:"font:700 11.5px system-ui,sans-serif;fill:#2c6647"});
  td1.textContent = "una vida con sentido →";
  const td2 = g("text", {x:575, y:66, "text-anchor":"middle", style:"font:600 11.5px system-ui,sans-serif;fill:#2c523d"});
  const p = Kit.activas("pilares")[0] || "Lo que importa cuidar";
  td2.textContent = p.length > 30 ? p.slice(0, 29) + "…" : p;

  /* huella de la vuelta en U sobre el sendero */
  g("path", {
    d:"M285 186 L245 186 A 24 20 0 0 1 245 148 L435 148",
    fill:"none", stroke:"#3f7d5a", "stroke-width":2.5, "stroke-dasharray":"5 5",
    opacity:(0.25 + 0.75 * (angulo / 180)).toFixed(2)
  });

  /* huella del primer paso corto cuando llega a la etapa 3 */
  if(angulo > 150){
    const gh = Kit.svg("g", {transform:"translate(432 186)", opacity:((angulo - 150) / 30).toFixed(2)});
    gh.appendChild(Kit.svg("ellipse", {cx:0, cy:-5, rx:11, ry:4.5, fill:"#3f7d5a"}));
    gh.appendChild(Kit.svg("ellipse", {cx:8, cy:6, rx:11, ry:4.5, fill:"#3f7d5a"}));
    const th = Kit.svg("text", {
      x:4, y:26, "text-anchor":"middle",
      style:"font:700 11.5px system-ui,sans-serif;fill:#24523a;paint-order:stroke;stroke:#f2f6f8;stroke-width:3"
    });
    th.textContent = "Huella del primer paso";
    gh.appendChild(th);
    svg.appendChild(gh);
  }

  /* los pies, vistos desde arriba, giran sobre el sendero: de mirar al alivio a mirar a lo que importa */
  const cx = 335 + (angulo / 180) * 45, cy = 184, lado = 74;
  g("ellipse", {cx:cx + 3, cy:cy + 6, rx:36, ry:24, fill:"#3a2f22", opacity:.18});
  const gf = Kit.svg("g", {transform:`translate(${cx.toFixed(1)} ${cy.toFixed(1)}) rotate(${(angulo - 90).toFixed(1)})`});
  gf.appendChild(Kit.figura("pies", "[[imagen:camino-pies.webp]]", {x:-lado * 1.023 / 2, y:-lado / 2, width:lado * 1.023, height:lado}));
  svg.appendChild(gf);
}

const reloj = Kit.reloj(dt => {
  const meta = etapa * 60;
  angulo += (meta - angulo) * Math.min(1, dt * 6);
  if(Math.abs(meta - angulo) < 0.4){
    angulo = meta;
    reloj.parar();
  }
  dibujar();
});

function actualizarUI(){
  [0, 1, 2, 3].forEach(i => $("g" + i).classList.toggle("activa", etapa === i));
  const [tit, sub] = ETAPAS_INFO[etapa];
  $("fase").textContent = tit;
  $("faseSub").textContent = sub;
}

function irGiro(n){
  etapa = n;
  if(etapa === 3) Kit.brindis("180°: los pies ya apuntan hacia lo que importa");
  actualizarUI();
  reloj.andar();
  Kit.guardar();
}

function leer(){
  actualizarUI();
  dibujar();
}

function resumen(){
  const l = [];
  const p = Kit.activas("pilares");
  if(p.length) l.push("Pilares implicados hoy: " + p.join(", "));
  const q = Kit.activas("buscadoQuitar");
  if(q.length) l.push("Qué se intenta quitar del camino: " + q.join(", "));
  const e = Kit.activas("efectosCortoLargo");
  if(e.length) l.push("Efecto de buscar el alivio inmediato: " + e.join(", "));
  l.push(`Giro ensayado en el sendero: ${etapa * 60}° (${ETAPAS_INFO[etapa][0]})`);
  const g = Kit.activas("primerGiro");
  if(g.length) l.push("Gesto pequeño que muestra que ya giró los pies: " + g.join(", "));
  return l.join("\n");
}

Kit.chips("pilares", PILARES, leer);
Kit.chips("buscadoQuitar", QUITAR, leer);
Kit.chips("efectosCortoLargo", EFECTOS, leer);
Kit.chips("primerGiro", PRIMER_GIRO);
dibujar();

Kit.iniciar({
  clave: "act-camino-de-vida",
  alCambiar: leer,
  resumen: resumen,
  extra: () => ({etapa}),
  restaurar: d => {
    etapa = Math.min(3, Math.max(0, (d && d.etapa) || 0));
    angulo = etapa * 60;
  }
});
