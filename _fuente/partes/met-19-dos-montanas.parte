@@meta
archivo: met-dos-montanas.html
titulo: Las dos montañas
enfoque: ACT
etiqueta: Yo como contexto
sub: La escaladora sube sola hasta quedar bajo un techo de roca y ahí insiste. Con la cara pegada a la piedra no se ve otra cosa; desde la montaña de enfrente se ve la cornisa que la rodea.
fuente: Metáfora de las dos montañas (Two Mountains Metaphor) de Hayes, Strosahl y Wilson (1999, cap. 1; 2012) y Luoma, Hayes y Walser (2017).
resumen: De cerca, la escaladora choca una y otra vez contra el techo de roca. Mirar desde la montaña de enfrente abre el encuadre y deja ver la cornisa; solo entonces se puede seguir por ella hasta la cima. El marcador cuenta las veces que se volvió a mirar desde enfrente.
@@css
  .marcas div{min-width:130px}
  .mandos button.enfrente{background:#3c5a78;border-color:#3c5a78;color:#fff;font-weight:600}
  .mandos button.enfrente:hover{background:#324c66;border-color:#324c66}
  .mandos button.cornisa{background:#2f7a5f;border-color:#2f7a5f;color:#fff;font-weight:600}
  .mandos button.cornisa:hover{background:#27674f;border-color:#27674f}
  .mandos button.cornisa:disabled{background:#b9d3c8;border-color:#b9d3c8}
@@html
<section class="paso">
  <h2><span class="num">1</span>La roca de cerca y la subida vista desde enfrente</h2>
  <div class="cuerpo">
    <label class="etiqueta">La roca que hoy tienes pegada a la cara</label>
    <div class="chips" id="roca">
      <button class="chip" data-v="El temor a equivocarme">El temor a equivocarme</button>
      <button class="chip" data-v="Sentirme estancado y cansado">Sentirme estancado y cansado</button>
      <button class="chip" data-v="Una herida que me dolió">Una herida que me dolió</button>
      <button class="chip" data-v="No saber si resultará">No saber si resultará</button>
    </div>
    <label class="etiqueta">Lo que se ve de tu subida desde la montaña de enfrente</label>
    <div class="chips" id="sendero">
      <button class="chip" data-v="Ya superé tramos difíciles antes">Ya superé tramos difíciles antes</button>
      <button class="chip" data-v="Hay un sendero que rodea esta roca">Hay un sendero que rodea esta roca</button>
      <button class="chip" data-v="Un tropiezo no borra lo subido">Un tropiezo no borra lo subido</button>
      <button class="chip" data-v="Basta con el siguiente escalón">Basta con el siguiente escalón</button>
    </div>
  </div>
</section>

<div class="escenario">
  <svg id="lienzo" viewBox="0 0 700 350" role="img" aria-label="Dos montañas: una escaladora bajo un techo de roca y alguien que la mira desde la cima vecina"></svg>
  <div class="marcas">
    <div><span class="n" id="mVolvi" style="color:#3c5a78">0</span><span class="r">veces que miré desde enfrente</span></div>
  </div>
  <div class="mandos">
    <button type="button" id="bCerca">Volver a la roca</button>
    <button type="button" class="enfrente" id="bEnfrente">Mirar desde la montaña de enfrente</button>
    <button type="button" class="cornisa" id="bSeguir" disabled>Seguir por la cornisa</button>
    <button type="button" id="bReiniciar">Empezar la subida de nuevo</button>
  </div>
</div>

<section class="bloque pregunta-sola" id="cierre">
  <div class="pregunta" id="textoPregunta">Con la frente apoyada en la roca, la roca es toda la montaña. ¿Qué es lo único que alcanzas a ver hoy desde donde estás parado?</div>
  <details class="apunte">
    <summary>Anotar lo conversado</summary>
    <textarea id="apunte" placeholder="La indicación que te darías desde esa mirada amplia..."></textarea>
  </details>
</section>
@@js
const $ = Kit.$;
Kit.chips("roca", {multiple:false, libre:true});
Kit.chips("sendero", {multiple:false, libre:true});

/* ----- geometría de la acuarela (700 x 350) ----- */
const SUBIDA = [[150,318],[185,292],[200,262],[190,248],[215,228],[222,202],[224,184]];             // escalones hasta el techo
const RODEO = [[224,184],[200,177],[160,172],[110,166],[66,160],[100,150],[150,132],[198,104],[160,90],[200,66],[185,48],[218,30]];
const TECHO = {x:222, y:160};       // donde está el techo de roca
const VIGIA = {x:545, y:180};       // quien mira desde la otra cima
const ZOOM = 3;
const ALTO = 30;
const ESC = {href:"[[imagen:montanas-escaladora.webp]]", r:0.445};

function largo(pts){ let s = 0; for(let i = 1; i < pts.length; i++) s += Math.hypot(pts[i][0] - pts[i-1][0], pts[i][1] - pts[i-1][1]); return s; }
function punto(pts, d){
  for(let i = 1; i < pts.length; i++){
    const l = Math.hypot(pts[i][0] - pts[i-1][0], pts[i][1] - pts[i-1][1]);
    if(d <= l){ const k = d / l; return [pts[i-1][0] + (pts[i][0] - pts[i-1][0]) * k, pts[i-1][1] + (pts[i][1] - pts[i-1][1]) * k]; }
    d -= l;
  }
  return pts[pts.length - 1];
}
const L1 = largo(SUBIDA), L2 = largo(RODEO);

let tramo, d, vista, zoom, t, volvi, vio, cima, golpe;
function reiniciar(){
  tramo = "subida"; d = L1 * 0.35;     // subida | rodeo
  vista = "cerca"; zoom = ZOOM; t = 0; volvi = 0; vio = false; cima = false; golpe = 0;
  $("textoPregunta").textContent = "Con la frente apoyada en la roca, la roca es toda la montaña. ¿Qué es lo único que alcanzas a ver hoy desde donde estás parado?";
}
reiniciar();

const escena = Kit.reloj(latido);
function latido(dt){
  t += dt;
  zoom += ((vista === "cerca" ? ZOOM : 1) - zoom) * Math.min(1, dt * 2.2);
  golpe = Math.max(0, golpe - dt * 1.6);
  if(tramo === "subida"){
    /* sube sola hasta el techo, choca, resbala un poco y vuelve a intentar */
    d += 16 * dt;
    if(d >= L1){ d = L1 - 14; golpe = 1; }
  } else if(!cima){
    d += 20 * dt;
    if(d >= L2){
      d = L2; cima = true;
      $("textoPregunta").textContent = "La roca sigue en su sitio y la subida continuó por otro lado. Si hoy te miraras desde la montaña de enfrente, ¿qué indicación amable te darías para el siguiente paso?";
    }
  }
  dibujar();
}

let fondo = null;
function dibujar(){
  const svg = $("lienzo");
  svg.innerHTML = "";
  const [px, py] = punto(tramo === "subida" ? SUBIDA : RODEO, d);
  /* la cámara: pegada a la escaladora o abierta a las dos montañas */
  const k = (zoom - 1) / (ZOOM - 1);
  const cx = Math.min(700 - 350 / zoom, Math.max(350 / zoom, 350 + (px - 350) * k));
  const cy = Math.min(350 - 175 / zoom, Math.max(175 / zoom, 175 + (py - 22 - 175) * k));
  const mundo = Kit.svg("g", {transform:`translate(350 175) scale(${zoom.toFixed(3)}) translate(${(-cx).toFixed(1)} ${(-cy).toFixed(1)})`});
  svg.appendChild(mundo);
  const g = (tg, a, p) => (p || mundo).appendChild(Kit.svg(tg, a));
  const texto = (x, y, s, estilo, ancla, p) => {
    const e = Kit.svg("text", {x, y, "text-anchor":ancla || "middle", style:estilo});
    e.textContent = s; (p || mundo).appendChild(e); return e;
  };

  if(!fondo) fondo = Kit.svg("image", {href:"[[imagen:montanas-acuarela.jpg]]", x:0, y:0, width:700, height:350, preserveAspectRatio:"none"});
  mundo.appendChild(fondo);

  /* desde enfrente se ve por dónde sigue la subida */
  if(vio && k < 0.6){
    g("polyline", {points:RODEO.map(p => p.join(",")).join(" "), fill:"none", stroke:"#f3d27a", "stroke-width":2.4,
      "stroke-dasharray":"1 6", "stroke-linecap":"round", opacity:(0.9 * (1 - k / 0.6)).toFixed(2)});
    const s = Kit.activas("sendero")[0];
    if(s) texto(VIGIA.x, VIGIA.y - 34, s.length > 38 ? s.slice(0, 36) + "…" : s,
      `font:600 12.5px Georgia,serif;font-style:italic;fill:#2c4257;opacity:${(1 - k / 0.6).toFixed(2)};paint-order:stroke;stroke:#fdfcf7;stroke-width:4px;stroke-linejoin:round`);
  }

  /* la escaladora */
  const w = ALTO * ESC.r, sacude = golpe > 0 ? Math.sin(t * 50) * 1.2 * golpe : 0;
  mundo.appendChild(Kit.figura("esc", ESC.href, {x:px - w / 2 + sacude, y:py - ALTO + 4 + golpe * 3, width:w, height:ALTO}));

  const roca = Kit.activas("roca")[0];
  if(roca) texto(TECHO.x, TECHO.y, roca.length > 30 ? roca.slice(0, 28) + "…" : roca,
    `font:600 ${(5 + 7 / zoom).toFixed(1)}px Georgia,serif;font-style:italic;fill:#f6efe2;paint-order:stroke;stroke:#2e2f33;stroke-width:${(3 / zoom + 1).toFixed(1)}px;stroke-linejoin:round`);

  /* de cerca, los bordes se cierran: no hay más mundo que la piedra */
  if(k > 0.02){
    const dd = Kit.svg("defs", {});
    dd.innerHTML = '<radialGradient id="dmTunel" cx="50%" cy="50%" r="62%"><stop offset="52%" stop-color="#14181d" stop-opacity="0"/><stop offset="100%" stop-color="#14181d" stop-opacity=".88"/></radialGradient>';
    svg.appendChild(dd);
    svg.appendChild(Kit.svg("rect", {x:0, y:0, width:700, height:350, fill:"url(#dmTunel)", opacity:k.toFixed(2)}));
  }

  $("mVolvi").textContent = volvi;
  $("bCerca").disabled = vista === "cerca";
  $("bEnfrente").disabled = vista === "enfrente";
  $("bSeguir").disabled = !vio || tramo === "rodeo";
}

$("bCerca").addEventListener("click", () => { vista = "cerca"; Kit.guardar(); });
$("bEnfrente").addEventListener("click", () => { vista = "enfrente"; vio = true; volvi++; Kit.guardar(); });
$("bSeguir").addEventListener("click", () => { if(!vio) return; tramo = "rodeo"; d = 0; Kit.guardar(); });
$("bReiniciar").addEventListener("click", () => { reiniciar(); Kit.guardar(); });

Kit.iniciar({
  clave: "met-dos-montanas",
  alCambiar: dibujar,
  resumen: () => [
    "LAS DOS MONTAÑAS",
    `Roca que hoy tapa el camino: ${Kit.activas("roca")[0] || "—"}`,
    `Lo que se ve desde enfrente: ${Kit.activas("sendero")[0] || "—"}`,
    `Veces que miré desde enfrente: ${volvi}`,
    $("apunte").value.trim() ? `Lo conversado: ${$("apunte").value.trim()}` : ""
  ].filter(Boolean).join("\n")
});
escena.andar();
