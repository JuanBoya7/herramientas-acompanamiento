@@meta
archivo: met-hojas-en-el-arroyo.html
titulo: Hojas en el arroyo
orden: 04
enfoque: Metáforas vivas
etiqueta: Defusión
sub: Un arroyo que baja, hojas que pasan solas y un pensamiento sobre cada hoja. No hay que producirlas: llegan sin avisar, se repiten, a veces vienen dos juntas. El ejercicio no consiste en que dejen de venir ni en mirar para otro lado: consiste en verlas pasar sin subirse a ninguna. Y cuando notes que te fuiste con la corriente, volver. Darse cuenta es el ejercicio, no el error.
fuente: Defusión cognitiva y meditación para desliteralizar el lenguaje, en Díaz Corbobés, MANUAL ACT §3.4, dentro del estilo abierto de respuesta.
resumen: Práctica de defusión guiada y cronometrada, de minuto y medio o de tres minutos. La corriente trae los pensamientos sola, barajados, y hacia el final llegan en racimo. El botón para marcar el enganche se puede quitar, si conviene preguntarlo hablando. Cuenta retornos, no fallos.
campo3: Sesión
campo3ph: Ej. Sesión 5
@@css
  button.soltar{background:#2f6f8f;border-color:#2f6f8f;color:#fff;font-weight:600}
  button.soltar:hover{background:#28607c;border-color:#28607c}
  button.enganche{background:#c9962f;border-color:#c9962f;color:#fff;font-weight:600}
  button.enganche:hover{background:#b0821f;border-color:#b0821f}
  .marcas div{min-width:96px}
  .marcas .n{font-size:24px}
  .guion{counter-reset:paso}
  .guion p{position:relative;padding-left:30px;margin:0 0 11px;font-size:14.5px;line-height:1.55}
  .guion p::before{counter-increment:paso;content:counter(paso);position:absolute;left:0;top:1px;
    width:21px;height:21px;border-radius:50%;background:var(--acento-claro);color:var(--acento);
    font-size:11.5px;font-weight:700;display:flex;align-items:center;justify-content:center}
@@html
<section class="paso">
  <h2><span class="num">1</span>Qué va a bajar por el agua</h2>
  <p class="ayuda">Los que aparecen todos los días sirven mejor que los más graves. La corriente
  los trae sola, los repite y los baraja.</p>
  <div class="cuerpo">
    <div class="chips" id="pensamientos"></div>
  </div>
</section>

<section class="bloque">
  <h2><span class="num">2</span>El guion</h2>
  <div class="cuerpo guion">
    <p>Imagina que estás sentado junto a un arroyo que baja despacio. El agua es clara y arrastra
    hojas que caen de los árboles. No tienes que hacer nada con el agua.</p>
    <p>Sobre cada hoja viene un pensamiento. No los eliges tú: llegan solos, y a veces vuelve el
    mismo. Míralo, léelo, y deja que la corriente se lo lleve.</p>
    <p>No empujes las hojas, no las retengas y tampoco mires el agua para no verlas. Se trata de
    mirarlas de frente y dejarlas ir igual: los feos, los aburridos y también este de «lo estoy
    haciendo bien».</p>
    <p>En algún momento vas a notar que dejaste de mirar el arroyo, que te fuiste con una hoja
    corriente abajo. <b>Eso va a pasar, y no es una falla.</b> Cuando lo notes, vuelve a sentarte
    junto al arroyo. Si el botón naranja está puesto, marcarlo es parte de volver.</p>
  </div>
</section>

<div class="escenario">
  <svg id="arroyo" viewBox="0 0 700 300" role="img"
    aria-label="Arroyo con hojas que llevan pensamientos corriente abajo"></svg>
  <div class="marcas">
    <div><span class="n" id="mReloj" style="color:#2f6f8f">3:00</span><span class="r">quedan</span></div>
    <div><span class="n" id="mHojas" style="color:#3f7d5a">0</span><span class="r">hojas que pasaron</span></div>
    <div id="cajaEnganches"><span class="n" id="mEnganches" style="color:#c9962f">0</span><span class="r">veces que volví</span></div>
  </div>
  <div class="duracion" id="duracion">
    <button type="button" class="chip" id="d90">Minuto y medio</button>
    <button type="button" class="chip activa" id="d180">Tres minutos</button>
    <button type="button" class="chip" id="vLento">Corriente lenta</button>
    <button type="button" class="chip activa" id="vNormal">Corriente normal</button>
    <button type="button" class="chip" id="cMarcar">Botón de enganche</button>
  </div>
  <div class="mandos">
    <button type="button" class="soltar" id="btnArrancar" onclick="arrancar()">Empezar la práctica</button>
    <button type="button" class="enganche" id="btnEnganche" onclick="engancharse()">Me enganché</button>
    <button type="button" onclick="detenerPractica()">Terminar y conversar</button>
    <button type="button" onclick="reiniciar()">Reiniciar</button>
  </div>
</div>

<section class="bloque pregunta-sola" id="cajaPregunta" hidden>
  <div class="pregunta" id="pregunta"></div>
</section>
@@js
const $ = Kit.$;

const PENSAMIENTOS = ["No sirvo para esto","Voy a fallar","No soy suficiente","¿Y si me pasa algo?"];

let hojas = [], pasadas = 0, enganches = 0;
let total = 180, restante = 180;
let corriendo = false, animacion = null;
let baraja = [], proxima = 0, lenta = false, conBoton = false;

const elegidos = () => Kit.activas("pensamientos");

/* ====================== EL RITMO DE LA CORRIENTE ======================
   El intervalo entre hojas va emparejado con lo que tarda una en cruzar, de
   modo que lo normal sea ver una sola en el agua y el solapamiento sea la
   excepción.

   La excepción es lo interesante: de vez en cuando la siguiente entra antes de
   que salga la anterior y se ven dos o tres juntas. Eso es raro al principio y
   frecuente al final, porque así se comporta el bucle. Los pensamientos no se
   agolpan porque sí: se agolpan cuando uno ya lleva rato dándoles importancia,
   y cada uno trae al siguiente. */
const INTERVALO = () => {
  const avance = total ? (total - restante) / total : 0;
  /* el racimo aparece casi nunca al empezar y a menudo al terminar */
  if(Math.random() < avance * avance * .6)
    return (lenta ? 3.4 : 2.3) + Math.random() * (lenta ? 1.2 : .9);
  return (lenta ? 10.5 : 6.3) + Math.random() * (lenta ? 2.5 : 1.5);
};

/* Se sirven barajados y no en orden fijo: un ciclo predecible se vuelve
   mueble y deja de notarse. Cada vuelta se remezcla. */
function siguientePensamiento(){
  const lista = elegidos();
  if(!lista.length) return null;
  if(!baraja.length){
    baraja = lista.slice();
    for(let i = baraja.length - 1; i > 0; i--){
      const j = Math.floor(Math.random() * (i + 1));
      [baraja[i], baraja[j]] = [baraja[j], baraja[i]];
    }
    /* con un solo pensamiento la baraja es él mismo: vuelve una y otra vez,
       que es exactamente lo que hacen los pensamientos que pesan */
  }
  return baraja.shift();
}

function nuevaHoja(texto){
  hojas.push({texto, x:-90, y:104 + Math.random() * 96, giro:-10 + Math.random() * 20,
    vel:(lenta ? .62 : .95) + Math.random() * (lenta ? .22 : .3)});
}

/* ====================== EL LATIDO ====================== */
const escena = Kit.reloj(latido);
let sobrante = 0;

function latido(dt){
  /* el agua trae hojas sola mientras la práctica está corriendo */
  if(corriendo){
    proxima -= dt;
    if(proxima <= 0){
      const t = siguientePensamiento();
      if(t){ nuevaHoja(t); }
      proxima = INTERVALO();
    }
    sobrante += dt;
    while(sobrante >= 1){
      sobrante -= 1;
      restante--;
      if(restante <= 0){ terminar(); break; }
    }
  }

  const antes = hojas.length;
  hojas.forEach(h => { h.x += h.vel * 100 * dt; h.giro += h.vel * 7 * dt; });
  hojas = hojas.filter(h => h.x < anchoArroyo() + 90);
  pasadas += antes - hojas.length;

  marcar();
  dibujar();
}

/* ====================== DURACIÓN Y RITMO ====================== */
function ponerDuracion(seg){
  if(corriendo) return;
  total = seg;
  restante = seg;
  $("d90").classList.toggle("activa", seg === 90);
  $("d180").classList.toggle("activa", seg === 180);
  marcar();
  Kit.guardar();
}

function ponerRitmo(esLenta){
  lenta = esLenta;
  $("vLento").classList.toggle("activa", lenta);
  $("vNormal").classList.toggle("activa", !lenta);
  Kit.guardar();
}

/* El botón de enganche se puede quitar. Con él, marcar es el acto de volver y
   queda el rastro de cuándo ocurrió; sin él, la práctica queda limpia y el
   enganche se pregunta después, hablando. Es decisión de quien acompaña. */
function ponerBoton(hay){
  conBoton = hay;
  $("cMarcar").classList.toggle("activa", conBoton);
  $("btnEnganche").hidden = !conBoton;
  $("cajaEnganches").hidden = !conBoton;
  Kit.guardar();
}

/* ====================== EL ARROYO ====================== */
// El fondo permanece montado: solo se actualizan las hojas, sin repintar la imagen.
let capaHojas = null, fondoArroyo = null;
const anchoArroyo = () => window.innerWidth < 540 ? 420 : 700;
function dibujar(){
  const svg = $("arroyo");
  if(!capaHojas){
    fondoArroyo=Kit.svg("image", {href:"[[imagen:arroyo-acuarela.png]]", x:0,y:0,width:700,height:300,preserveAspectRatio:"xMidYMid slice"}); svg.appendChild(fondoArroyo);
    capaHojas = Kit.svg("g", {}); svg.appendChild(capaHojas);
  }
  const ancho=anchoArroyo();
  svg.setAttribute("viewBox", `0 0 ${ancho} 300`); fondoArroyo.setAttribute("width", ancho);
  capaHojas.replaceChildren();
  hojas.forEach(h => {
    const gr = Kit.svg("g", {transform:`translate(${h.x},${h.y})`});
    capaHojas.appendChild(gr);
    const hoja = Kit.svg("g", {transform:`rotate(${Math.sin(h.giro / 12)*12})`});
    gr.appendChild(hoja);
    hoja.appendChild(Kit.svg("ellipse", {cx:22,cy:5,rx:31,ry:7,fill:"#294f4c",opacity:.12}));
    hoja.appendChild(Kit.svg("path", {d:"M-7 2 C4 -23 38 -24 55 -4 C44 1 41 15 26 17 C10 19 0 12 -7 2 Z",fill:"#b99848",stroke:"#786532","stroke-width":1}));
    hoja.appendChild(Kit.svg("path", {d:"M-12 5 Q18 -3 48 -4 M9 0 L13 -11 M19 -1 L27 10 M31 -3 L37 -13",fill:"none",stroke:"#786532","stroke-width":1,opacity:.65}));
    // Todo el pensamiento, en líneas: no se corta el contenido significativo.
    const palabras=h.texto.split(/\s+/); const lineas=[]; let linea="";
    palabras.forEach(p=>{if((linea+" "+p).trim().length>28 && linea){lineas.push(linea);linea=p;}else linea=(linea+" "+p).trim();});
    if(linea) lineas.push(linea);
    const t=Kit.svg("text",{x:22,y:-24-(lineas.length-1)*17,"text-anchor":"middle",style:"font:600 14px system-ui;fill:#24483f;paint-order:stroke;stroke:#fffdf3;stroke-width:4;stroke-linejoin:round"});
    lineas.forEach((l,i)=>{const span=Kit.svg("tspan",{x:22,dy:i?17:0});span.textContent=l;t.appendChild(span);});gr.appendChild(t);
  });
  if(!hojas.length && !corriendo){
    const t=Kit.svg("text",{x:ancho/2,y:154,"text-anchor":"middle",style:"font:14px system-ui;fill:#345e55;paint-order:stroke;stroke:#f7fbec;stroke-width:4"});
    t.textContent=restante===0?"¿Qué notaste durante la práctica?":(elegidos().length?"Cuando quieras, empieza la práctica":"Elige un pensamiento para empezar");capaHojas.appendChild(t);
  }
}
function detenerPractica(){
  corriendo=false; escena.parar(); $("btnArrancar").disabled=false;
  $("cajaPregunta").hidden=false; $("pregunta").textContent="¿Qué notaste durante la práctica?";
  Kit.guardar();
}

/* ====================== PRÁCTICA ====================== */
/* La corriente trae los pensamientos sola. Este botón es para el que aparece
   en plena práctica y no estaba en la lista: se pone en una hoja y se va. */
function ponerLaMia(){
  const lista = elegidos();
  if(!lista.length){ Kit.brindis("Marca primero al menos un pensamiento"); return; }
  nuevaHoja(lista[Math.floor(Math.random() * lista.length)]);
  escena.andar();
  Kit.guardar();
}

function engancharse(){
  if(!conBoton) return;
  enganches++;
  marcar();
  Kit.brindis("Lo notaste. Vuelve al arroyo y sigue.");
  Kit.guardar();
}

function arrancar(){
  if(corriendo) return;
  if(!elegidos().length){ Kit.brindis("Marca primero al menos un pensamiento"); return; }
  if(restante <= 0) restante = total;
  corriendo = true;
  sobrante = 0;
  proxima = .8;                 /* la primera llega casi enseguida */
  baraja = [];
  $("btnArrancar").disabled = true;
  escena.andar();
  marcar();
}

function terminar(){
  corriendo = false;
  restante = 0;
  escena.parar();
  $("btnArrancar").disabled = false;
  Kit.brindis("Se cumplió el tiempo");
  Kit.guardar();
}

function reiniciar(){
  escena.parar();
  corriendo = false; restante = total; pasadas = 0; enganches = 0;
  hojas = []; baraja = []; proxima = 0; sobrante = 0;
  $("btnArrancar").disabled = false;
  marcar(); dibujar();
  Kit.guardar();
}

function marcar(){
  const m = Math.floor(restante / 60), s = restante % 60;
  $("mReloj").textContent = m + ":" + String(s).padStart(2, "0");
  $("mHojas").textContent = pasadas;
  $("mEnganches").textContent = enganches;
  pregunta();
}

/* La pregunta para abrir la sesión aparece pasada la mitad del tiempo, por si
   conviene cortar antes de que se cumpla el reloj. */
function pregunta(){
  const pasada = total - restante;
  const visible = pasada >= total / 2 && (pasadas > 0 || enganches > 0);
  $("cajaPregunta").hidden = !visible;
  if(!visible) return;
  $("pregunta").textContent = (!conBoton || enganches === 0)
    ? "Durante este rato, ¿en algún momento dejaste de ver el arroyo?"
    : "Cada vez que marcaste el botón, ¿qué te hizo darte cuenta?";
}

function resumen(){
  const l = [];
  l.push("PENSAMIENTOS QUE BAJARON POR EL AGUA");
  l.push(elegidos().length ? elegidos().join(" · ") : "(ninguno marcado)");
  l.push("", `PRÁCTICA (${total === 90 ? "minuto y medio" : "tres minutos"}, ` +
             `corriente ${lenta ? "lenta" : "normal"}): ${pasadas} hojas pasaron, ` +
             `${total - restante} segundos practicados.`);
  l.push(conBoton
    ? `Veces que se enganchó y volvió: ${enganches} (marcadas en pantalla).`
    : "Práctica visual sin registro de enganches.");
  return l.join("\n");
}

Kit.chips("pensamientos", PENSAMIENTOS, dibujar);
window.addEventListener("resize",dibujar);
$("d90").onclick = () => ponerDuracion(90);
$("d180").onclick = () => ponerDuracion(180);
$("vLento").onclick = () => ponerRitmo(true);
$("vNormal").onclick = () => ponerRitmo(false);
$("cMarcar").onclick = () => ponerBoton(!conBoton);

Kit.iniciar({
  clave: "met-hojas-en-el-arroyo",
  extra: () => ({pasadas, enganches, total, lenta, conBoton}),
  restaurar: d => {
    pasadas = d.pasadas || 0; enganches = d.enganches || 0;
    total = d.total || 180; restante = total; lenta = !!d.lenta;
    conBoton = d.conBoton === undefined ? false : !!d.conBoton;
  },
  alCambiar: () => { $("d90").classList.toggle("activa", total === 90);
                     $("d180").classList.toggle("activa", total === 180);
                     $("vLento").classList.toggle("activa", lenta);
                     $("vNormal").classList.toggle("activa", !lenta);
                     $("cMarcar").classList.toggle("activa", conBoton);
                     $("btnEnganche").hidden = !conBoton;
                     $("cajaEnganches").hidden = !conBoton;
                     marcar(); dibujar(); },
  resumen: resumen
});
