@@meta
archivo: act-echar-el-ancla.html
titulo: Echar el ancla
orden: 10
enfoque: ACT
etiqueta: Momento presente
sub: Cuando llega una tormenta emocional, el ancla no se echa para que el mar se calme: las anclas no cambian el clima. Sirve para sujetarse al fondo y no ser arrastrado mientras pasa la marejada. Se recorre el ciclo ACE (reconocer lo que hay adentro, conectar con el cuerpo e involucrarse en lo que hay aquí) las veces que haga falta.
fuente: Echar el ancla y la fórmula ACE (Acknowledge, Connect, Engage), en Harris, Trauma-Focused ACT (2021), cap. 8; When Life Hits Hard (2021), cap. 5.
resumen: Tres movimientos breves que se encadenan en ciclo (A · Reconocer lo que hay adentro, C · Conectar con el cuerpo, E · Involucrarse en lo que hay aquí) mientras una escena en acuarela muestra cómo el barco deja de derivar en medio del oleaje conforme el ancla llega al fondo.
@@css
  .mar-ancla{display:block;width:100%;height:auto;max-width:700px;margin:0 auto}
  .fase{font-size:19px;font-weight:700;text-align:center;margin:8px auto 2px;color:var(--acento);
    min-height:28px;max-width:600px;line-height:1.35}
  .fase-sub{text-align:center;font-size:14px;color:var(--tinta-suave);max-width:560px;margin:0 auto;
    min-height:22px;line-height:1.5}
  button.bajar{background:#3f9b86;border-color:#3f9b86;color:#fff;font-weight:600}
  button.bajar:hover{background:#357f6e;border-color:#357f6e}
  .paso-ace{display:inline-flex;align-items:center;justify-content:center;width:27px;height:27px;
    border-radius:50%;background:#e3f2ee;color:#2f7d6a;font-size:14px;font-weight:800}
@@html
<section class="paso">
  <h2><span class="num">1</span>A · Reconocer lo que hay adentro</h2>
  <p class="ayuda">Notar en silencio y con amabilidad qué pensamientos, emociones o sensaciones están
  presentes ahora mismo, sin pelear con ellos ni tratar de quitarlos.</p>
  <div class="cuerpo">
    <div class="chips" id="adentro"></div>
  </div>
</section>

<section class="paso">
  <h2><span class="num">2</span>C · Conectar con el cuerpo</h2>
  <p class="ayuda">Mientras eso sigue ahí adentro, llevar el mando al cuerpo con movimientos pequeños
  que se sientan en el momento.</p>
  <div class="cuerpo">
    <div class="chips" id="cuerpoApoyo"></div>
  </div>
</section>

<section class="paso">
  <h2><span class="num">3</span>E · Involucrarse en lo que hay aquí</h2>
  <p class="ayuda">Abrir el foco también a la habitación y a lo que se está haciendo ahora. No es
  distraerse de lo interno: es ampliar la atención para que quepan las dos cosas.</p>
  <div class="cuerpo">
    <div class="chips" id="entorno"></div>
  </div>
</section>

<div class="escenario">
  <svg class="mar-ancla" id="marAncla" viewBox="0 0 700 260" role="img"
    aria-label="Un barco en medio del oleaje que echa el ancla en tres tramos hasta sujetarse al fondo"></svg>
  <div class="fase" id="fase">El oleaje está activo y el barco va a la deriva</div>
  <div class="fase-sub" id="faseSub">Recorre A → C → E para bajar el ancla tramo a tramo. El mar no se apaga: cambia la sujeción.</div>
  <div class="marcas">
    <div><span class="n" id="mTramo" style="color:#3f9b86">0 / 3</span><span class="r">tramos de cadena</span></div>
    <div><span class="n" id="mDeriva" style="color:#b0503f">Alta</span><span class="r">deriva del barco</span></div>
  </div>
  <div class="mandos">
    <button type="button" class="bajar" id="btnBajar" onclick="bajarTramo()">Bajar un tramo del ancla (A → C → E)</button>
    <button type="button" onclick="soltarAncla()">Subir el ancla y reiniciar</button>
  </div>
</div>

<section class="bloque pregunta-sola">
  <div class="pregunta" id="pregunta">¿Qué cambia cuando dejas de esperar a que calme el mar y te sujetas al fondo?</div>
  <div class="cuerpo" style="padding:10px 0 0">
    <div class="chips" id="notado"></div>
  </div>
</section>
@@js
const $ = Kit.$;

const ADENTRO = [
  "Opresión en el pecho o la garganta",
  "Mente acelerada anticipando problemas",
  "Ganas de salir corriendo o cerrarme",
  "Tristeza o cansancio pesado",
  "Rabia o tensión en la mandíbula"
];
const CUERPO = [
  "Empujar suavemente los pies contra el piso",
  "Enderezar la espalda y notar el respaldo",
  "Estirar los dedos y juntar las palmas",
  "Soltar los hombros al exhalar",
  "Respirar lento notando el aire entrar y salir"
];
const ENTORNO = [
  "Tres cosas que veo en este lugar",
  "Dos sonidos que escucho ahora",
  "La temperatura y el apoyo de la silla",
  "La conversación que tenemos enfrente"
];
const NOTADO = [
  "La tormenta sigue, pero ya no me arrastra",
  "Recupero margen para elegir qué hacer",
  "Noto el cuerpo además del pensamiento",
  "Puedo quedarme presente sin pelear con la ola"
];

let tramo = 0;          /* 0, 1, 2, 3 */
let cadenaY = 118;      /* de 118 (arriba) a 232 (en el fondo) */
let t = 0;
let fondoMar = null;

const TRAMOS_TEXTO = [
  ["El oleaje está activo y el barco va a la deriva",
   "Recorre A → C → E para bajar el ancla tramo a tramo. El mar no se apaga: cambia la sujeción."],
  ["Ciclo 1 (A · Reconocer): la cadena empieza a bajar",
   "Reconoces lo que hay adentro sin pelear y pisas firme el suelo. El barco aún se mueve bastante."],
  ["Ciclo 2 (C · Cuerpo): el ancla se acerca al lecho",
   "Respiras, sueltas hombros y notas dónde estás. El oleaje sigue, pero el arrastre disminuye."],
  ["Ciclo 3 (E · Aquí y ahora): el ancla agarró fondo",
   "Las olas siguen pasando bajo el casco, pero el barco ya no deriva: estás presente y con mando."]
];

function metaCadena(){
  return 118 + tramo * 38; /* 118, 156, 194, 232 */
}

function dibujar(){
  const svg = $("marAncla");
  svg.innerHTML = "";
  const g = (tag, a) => svg.appendChild(Kit.svg(tag, a));

  g("rect", {x:0, y:0, width:700, height:260, fill:"#e9f2f7"});
  if(!fondoMar) fondoMar = Kit.svg("image", {
    href:"[[imagen:mar-acuarela.jpg]]", x:0, y:-40, width:700, height:300,
    preserveAspectRatio:"none", opacity:.86
  });
  svg.appendChild(fondoMar);

  /* lecho marino firme abajo */
  g("path", {
    d:"M0 236 Q 120 228 260 235 T 520 233 T 700 237 L700 260 L0 260 Z",
    fill:"#8c7a65", opacity:.85, filter:Kit.acuarela(svg)
  });
  g("path", {
    d:"M0 240 Q 150 234 320 240 T 700 239",
    fill:"none", stroke:"#6b5b48", "stroke-width":2
  });

  /* oleaje vivo que NO se apaga (las anclas no controlan el clima) */
  let dOla1 = "M0 140";
  let dOla2 = "M0 158";
  for(let i = 0; i <= 35; i++){
    const x = i * 20;
    const y1 = 132 + Math.sin(t * 2.4 + i * .45) * 9 + Math.cos(t * 1.5 - i * .25) * 4;
    const y2 = 152 + Math.sin(t * 1.9 - i * .4 + 1.2) * 7;
    dOla1 += ` L${x} ${y1.toFixed(1)}`;
    dOla2 += ` L${x} ${y2.toFixed(1)}`;
  }
  g("path", {
    d: dOla1 + " L700 242 L0 242 Z",
    fill:"#2f6f8f", "fill-opacity":.24, stroke:"#2f6f8f", "stroke-width":2
  });
  g("path", {
    d: dOla2 + " L700 242 L0 242 Z",
    fill:"#1f4e68", "fill-opacity":.22, stroke:"#3b7a9e", "stroke-width":1.5
  });

  /* etiquetas de lo que hay en las olas (adentro) */
  const internos = Kit.activas("adentro");
  if(internos.length){
    const txtOla = internos[0].length > 34 ? internos[0].slice(0, 33) + "…" : internos[0];
    const et = g("text", {
      x:135, y:182 + Math.sin(t * 2) * 4, "text-anchor":"middle",
      style:"font:600 12px system-ui,sans-serif;fill:#1d455c;paint-order:stroke;stroke:#e9f2f7;stroke-width:3"
    });
    et.textContent = "Oleaje: " + txtOla;
  }

  /* cálculo de deriva del barco: sin ancla deriva mucho de lado a lado; con ancla se sujeta */
  const factorDeriva = [1, 0.58, 0.25, 0.04][tramo];
  const bx = 360 + Math.sin(t * 1.45) * 95 * factorDeriva + Math.cos(t * 0.8) * 35 * factorDeriva;
  const olaEnBarco = 122 + Math.sin(t * 2.4 + (bx / 20) * .45) * 8;
  const inclinacion = Math.cos(t * 2.2) * (16 * factorDeriva + 3.5);

  /* cadena desde la proa hasta el ancla */
  const anclaX = 360 + (bx - 360) * (1 - tramo / 3) * 0.5;
  const proaX = bx, proaY = olaEnBarco - 4;
  g("path", {
    d:`M${proaX.toFixed(1)} ${proaY.toFixed(1)} Q ${((proaX + anclaX) / 2 + 12 * factorDeriva).toFixed(1)} ${((proaY + cadenaY) / 2).toFixed(1)} ${anclaX.toFixed(1)} ${cadenaY.toFixed(1)}`,
    fill:"none", stroke:tramo === 3 ? "#2c5a44" : "#4a5a68",
    "stroke-width":3, "stroke-dasharray":"5 4", "stroke-linecap":"round"
  });

  /* el ancla de hierro y la barca, en acuarela */
  const ah = 40, aw = ah * 0.76;
  svg.appendChild(Kit.figura("ancla", "[[imagen:ancla-hierro.webp]]", {x:anclaX - aw / 2, y:cadenaY - 26, width:aw, height:ah}));
  const gb = Kit.svg("g", {transform:`translate(${bx.toFixed(1)} ${olaEnBarco.toFixed(1)}) rotate(${inclinacion.toFixed(1)})`});
  const bw = 124, bh = bw / 1.173;
  gb.appendChild(Kit.figura("barca", "[[imagen:ancla-barca.webp]]", {x:-bw / 2, y:-bh + 22, width:bw, height:bh}));
  svg.appendChild(gb);

  /* rótulo en el fondo cuando el ancla agarra */
  if(tramo === 3){
    const rf = g("text", {
      x:anclaX, y:253, "text-anchor":"middle",
      style:"font:700 12px system-ui,sans-serif;fill:#f4faf6"
    });
    rf.textContent = "A · C · E sujetos al fondo";
  }
}

const reloj = Kit.reloj(dt => {
  t += dt;
  const meta = metaCadena();
  cadenaY += (meta - cadenaY) * Math.min(1, dt * 4.5);
  dibujar();
});

function actualizarUI(){
  const [tit, sub] = TRAMOS_TEXTO[tramo];
  $("fase").textContent = tit;
  $("faseSub").textContent = sub;
  $("mTramo").textContent = tramo + " / 3";
  const der = ["Alta", "Media", "Baja", "Sujeto al fondo"][tramo];
  $("mDeriva").textContent = der;
  $("mDeriva").style.color = tramo === 3 ? "#3f7d5a" : tramo === 2 ? "#c9962f" : "#b0503f";
  $("btnBajar").textContent = tramo < 3
    ? `Bajar tramo ${tramo + 1} del ancla (A → C → E)`
    : "Dar otra vuelta ACE en el fondo";
  if(!reloj.anda()) reloj.andar();
  dibujar();
}

function bajarTramo(){
  if(tramo < 3){
    tramo++;
    if(tramo === 3) Kit.brindis("El ancla llegó al fondo: el mar sigue, pero ya no te arrastra");
  } else {
    Kit.brindis("Otro ciclo lento de A → C → E manteniendo el ancla firme");
  }
  actualizarUI();
  Kit.guardar();
}

function soltarAncla(){
  tramo = 0;
  cadenaY = 118;
  actualizarUI();
  Kit.guardar();
}

function leer(){
  actualizarUI();
}

function resumen(){
  const l = [];
  const a = Kit.activas("adentro");
  if(a.length) l.push("A · Lo reconocido adentro: " + a.join(", "));
  const c = Kit.activas("cuerpoApoyo");
  if(c.length) l.push("C · Conexión con el cuerpo: " + c.join(", "));
  const e = Kit.activas("entorno");
  if(e.length) l.push("E · Involucrado en el presente: " + e.join(", "));
  l.push(`Ancla en escena: ${tramo}/3 tramos (${["a la deriva", "bajando", "cerca del fondo", "sujeto al fondo"][tramo]})`);
  const n = Kit.activas("notado");
  if(n.length) l.push("Qué cambió al sujetarse al fondo: " + n.join(", "));
  return l.join("\n");
}

Kit.chips("adentro", ADENTRO, leer);
Kit.chips("cuerpoApoyo", CUERPO, leer);
Kit.chips("entorno", ENTORNO, leer);
Kit.chips("notado", NOTADO);
reloj.andar();

Kit.iniciar({
  clave: "act-echar-el-ancla",
  alCambiar: leer,
  resumen: resumen,
  extra: () => ({tramo}),
  restaurar: d => { tramo = Math.min(3, Math.max(0, (d && d.tramo) || 0)); cadenaY = metaCadena(); }
});
