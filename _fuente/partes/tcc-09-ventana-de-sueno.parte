@@meta
archivo: tcc-ventana-de-sueno.html
titulo: Ventana de sueño
orden: 09
enfoque: Cognitivo-conductual
etiqueta: Insomnio
sub: Quedarse más tiempo en la cama para recuperar sueño produce un sueño superficial y cortado. La ventana hace lo contrario: el tiempo en cama se ajusta al tiempo que de verdad se duerme, con una hora fija para levantarse, y se va ampliando de a quince minutos a medida que el sueño se consolida. Menos cama, sueño más continuo.
fuente: Terapia de restricción del sueño y control de estímulos, en Perlis, Jungquist, Smith y Posner, Cognitive Behavioral Treatment of Insomnia: A Session-by-Session Guide (2005), caps. 2 y 4 y apéndice 1.
resumen: Con los promedios del diario de sueño se calcula la eficiencia y se fija la ventana: la hora de levantarse y la de acostarse, nunca menos de cuatro horas y media. Se ve cómo cambia el sueño dentro de la ventana, se practica el ajuste semanal según la eficiencia y se acuerdan las reglas que la acompañan.
identificacion: si
@@css
  .noche{display:block;width:100%;height:auto;max-width:680px;margin:0 auto}
  .fase{font-size:19px;font-weight:700;text-align:center;margin:6px auto 2px;color:var(--acento);min-height:26px}
  .fase-sub{text-align:center;font-size:14px;color:var(--tinta-suave);max-width:560px;margin:0 auto;min-height:22px}
  button.arrancar{background:#2f6f8f;border-color:#2f6f8f;color:#fff;font-weight:600}
  .ef{display:flex;align-items:baseline;gap:10px;margin-top:12px;padding:10px 14px;background:#f8fafc;border-radius:10px}
  .ef b{font-size:26px;color:#2f6f8f}
  .ef span{font-size:13.5px;color:var(--tinta-suave)}
  .ventana{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}
  .ventana div{background:#f8fafc;border-radius:10px;padding:10px 12px;text-align:center}
  .ventana b{display:block;font-size:22px;color:#2f4858}
  .ventana span{font-size:11.5px;text-transform:uppercase;letter-spacing:.5px;color:var(--tinta-suave)}
  @media (max-width:520px){.ventana{grid-template-columns:1fr}}
@@html
<section class="paso">
  <h2><span class="num">1</span>La semana, en promedio</h2>
  <p class="ayuda">Del diario de sueño de al menos una semana: cuánto tiempo se pasó en la cama y
  cuánto se durmió de verdad, en promedio por noche.</p>
  <div class="cuerpo">
    <div class="medidor">
      <label for="tib">Tiempo en la cama</label>
      <input type="range" id="tib" min="4" max="12" step="0.25" value="9">
      <span class="valor" id="vTib">9 h</span>
    </div>
    <div class="medidor" style="margin-top:8px">
      <label for="tst">Tiempo dormido</label>
      <input type="range" id="tst" min="2" max="10" step="0.25" value="6">
      <span class="valor" id="vTst">6 h</span>
    </div>
    <div class="ef"><b id="vEf">67 %</b><span id="lEf">de eficiencia: el tiempo dormido sobre el tiempo en la cama.</span></div>
  </div>
</section>

<section class="paso">
  <h2><span class="num">2</span>La ventana</h2>
  <p class="ayuda">Primero se fija la hora de levantarse, igual los siete días. La hora de acostarse
  se corre hacia más tarde hasta que el tiempo en la cama iguale el tiempo dormido.</p>
  <div class="cuerpo">
    <div class="medidor">
      <label for="levantar">Hora de levantarse</label>
      <input type="range" id="levantar" min="240" max="600" step="15" value="390">
      <span class="valor" id="vLevantar">6:30</span>
    </div>
    <div class="ventana">
      <div><b id="vAcostar">—</b><span>acostarse</span></div>
      <div><b id="vLev2">—</b><span>levantarse</span></div>
      <div><b id="vLargo">—</b><span>en la cama</span></div>
    </div>
    <div id="avisoMinimo"></div>
  </div>
</section>

<div class="escenario">
  <svg class="noche" id="noche" viewBox="0 0 680 210" role="img"
    aria-label="El tiempo en la cama antes y dentro de la ventana, con los momentos de sueño y de vigilia"></svg>
  <div class="fase" id="fase">Más tiempo en la cama no es más sueño</div>
  <div class="fase-sub" id="faseSub">Arriba, una noche de hoy. Abajo, la ventana.</div>
  <div class="mandos">
    <button type="button" class="arrancar" id="btnArrancar" onclick="arrancar()">Ver cómo cambia</button>
  </div>
</div>

<section class="paso">
  <h2><span class="num">3</span>El ajuste de cada semana</h2>
  <p class="ayuda">Se revisa el diario al comienzo de cada sesión. Con 90 % o más, la hora de
  acostarse se adelanta quince minutos; entre 85 y 90 %, se mantiene; con menos de 85 %, se
  atrasa quince minutos.</p>
  <div class="cuerpo">
    <div class="medidor">
      <label for="efSemana">Eficiencia de la semana siguiente</label>
      <input type="range" id="efSemana" min="60" max="100" step="1" value="91">
      <span class="valor" id="vEfSemana">91 %</span>
    </div>
    <div id="lecturaAjuste" style="margin-top:10px"></div>
  </div>
</section>

<section class="paso">
  <h2><span class="num">4</span>Lo que acompaña a la ventana</h2>
  <p class="ayuda">Las instrucciones de control de estímulos, para que la cama vuelva a asociarse con
  el sueño.</p>
  <div class="cuerpo">
    <div class="chips" id="reglas"></div>
    <label class="etiqueta">Antecedentes que obligan a consultar antes de restringir el sueño</label>
    <div class="chips" id="antecedentes"></div>
    <div id="bandera"></div>
  </div>
</section>
@@js
const $ = Kit.$;

const REGLAS = ["Levantarme a la misma hora los siete días", "Acostarme solo cuando tenga sueño",
  "La cama solo para dormir y para la vida sexual", "Si no me duermo en unos quince minutos, salir del cuarto",
  "Volver a la cama solo con sueño"];
const ANTECEDENTES = ["Manía", "Apnea obstructiva del sueño", "Convulsiones", "Parasomnias", "Riesgo de caídas"];
const MINIMO = 4.5;

const hhmm = m => { m = ((Math.round(m) % 1440) + 1440) % 1440; return String(Math.floor(m / 60)).padStart(2, "0") + ":" + String(m % 60).padStart(2, "0"); };
const horas = h => { const e = Math.floor(h), m = Math.round((h - e) * 60); return e + " h" + (m ? " " + m : ""); };
const q15 = h => Math.round(h * 4) / 4;

function datos(){
  const tib = +$("tib").value, tst = Math.min(+$("tst").value, tib);
  const lev = +$("levantar").value;
  const largo = Math.max(MINIMO, q15(tst));
  return {tib, tst, ef: tst / tib * 100, lev, largo, acostar: lev - largo * 60};
}

/* ---------- la noche ---------- */
const INI = 19 * 60, FIN = 36 * 60, X0 = 40, X1 = 660;
const px = m => X0 + (m - INI) / (FIN - INI) * (X1 - X0);
let prog = 0;   /* 0 = la cama de hoy; 1 = la ventana */

function fila(svg, y, ini, fin, dormido, rot, col){
  const t = Kit.svg("text", {x:X0, y:y - 8, "font-size":12, "font-weight":700, fill:"#55616d"});
  t.textContent = rot;
  svg.appendChild(t);
  svg.appendChild(Kit.svg("rect", {x:px(ini), y:y, width:px(fin) - px(ini), height:34, rx:6, fill:"#f3e6d8"}));
  /* el sueño dentro de la cama: un rato despierto al comienzo y despertares repartidos */
  const total = fin - ini, despierto = Math.max(0, total - dormido);
  const lat = despierto * .4, huecos = [.3, .55, .8].map(f => ini + total * f);
  const tramo = (despierto - lat) / 3;
  let cur = ini + lat;
  huecos.forEach(h => {
    const hasta = Math.max(cur, h - tramo / 2);
    if(hasta > cur) svg.appendChild(Kit.svg("rect", {x:px(cur), y:y + 5, width:px(hasta) - px(cur), height:24, rx:4, fill:col}));
    cur = hasta + tramo;
  });
  if(fin > cur) svg.appendChild(Kit.svg("rect", {x:px(cur), y:y + 5, width:px(fin) - px(cur), height:24, rx:4, fill:col}));
}

function dibujar(){
  const d = datos(), svg = $("noche");
  svg.innerHTML = "";
  for(let m = INI + 60; m < FIN; m += 120){
    svg.appendChild(Kit.svg("line", {x1:px(m), y1:28, x2:px(m), y2:188, stroke:"#e6ebee"}));
    const t = Kit.svg("text", {x:px(m), y:204, "text-anchor":"middle", "font-size":11, fill:"#8a96a0"});
    t.textContent = hhmm(m);
    svg.appendChild(t);
  }
  const lev = d.lev + 1440;
  fila(svg, 42, lev - d.tib * 60, lev, d.tst * 60, "Hoy: " + horas(d.tib) + " en la cama", "#8fa9c4");
  /* la ventana: la hora de acostarse se corre hacia la tarde de la cama de hoy a la ventana,
     y el sueño se va consolidando */
  const ini = (lev - d.tib * 60) + ((lev - d.largo * 60) - (lev - d.tib * 60)) * prog;
  const largo = lev - ini;
  const dormido = d.tst * 60 + (largo * .93 - d.tst * 60) * prog;
  fila(svg, 128, ini, lev, Math.min(largo, dormido), prog >= 1 ? "La ventana: " + horas(d.largo) : "Corriendo la hora de acostarse…",
    "#2f6f8f");
  svg.appendChild(Kit.svg("line", {x1:px(lev), y1:30, x2:px(lev), y2:176, stroke:"#c26a4e", "stroke-width":2, "stroke-dasharray":"4 3"}));
  const l = Kit.svg("text", {x:px(lev) + 5, y:188, "font-size":11, "font-weight":700, fill:"#c26a4e"});
  l.textContent = "levantarse " + hhmm(d.lev);
  svg.appendChild(l);
}

const reloj = Kit.reloj(dt => {
  prog = Math.min(1, prog + dt / 3);
  dibujar();
  if(prog >= 1){
    reloj.parar();
    $("fase").textContent = "Menos cama, sueño más continuo";
    $("faseSub").textContent = "Al principio se duerme algo menos; después cuesta mantenerse despierto hasta la hora.";
    $("btnArrancar").textContent = "Otra vez";
  }
});
function arrancar(){
  prog = 0;
  $("fase").textContent = "La hora de acostarse se corre";
  $("faseSub").textContent = "La de levantarse no se mueve.";
  reloj.andar();
}

/* ---------- lectura ---------- */
function leer(){
  const d = datos();
  $("vTib").textContent = horas(d.tib);
  $("vTst").textContent = horas(d.tst);
  $("vEf").textContent = Math.round(d.ef) + " %";
  $("vLevantar").textContent = hhmm(d.lev);
  $("vAcostar").textContent = hhmm(d.acostar);
  $("vLev2").textContent = hhmm(d.lev);
  $("vLargo").textContent = horas(d.largo);
  $("avisoMinimo").innerHTML = q15(d.tst) < MINIMO
    ? `<div class="pistas" style="margin-top:10px">El tiempo dormido es menor que cuatro horas y media:
       la ventana no baja de ese mínimo.</div>` : "";

  const e = +$("efSemana").value;
  $("vEfSemana").textContent = e + " %";
  let nuevo = d.largo, txt;
  if(e >= 90){ nuevo = d.largo + .25; txt = "Se adelanta quince minutos la hora de acostarse."; }
  else if(e >= 85){ txt = "La ventana se mantiene una semana más."; }
  else { nuevo = Math.max(MINIMO, d.largo - .25);
         txt = nuevo < d.largo ? "Se atrasa quince minutos la hora de acostarse." : "Ya está en el mínimo de cuatro horas y media: no se reduce más."; }
  $("lecturaAjuste").innerHTML = `<div class="${e >= 90 ? "logro" : "pistas"}">${txt} Nueva ventana:
    de ${hhmm(d.lev - nuevo * 60)} a ${hhmm(d.lev)} (${horas(nuevo)}).</div>`;

  const a = Kit.activas("antecedentes");
  $("bandera").innerHTML = a.length
    ? `<div class="bandera">Con antecedentes de ${a.join(", ").toLowerCase()}, la restricción del sueño
       puede estar contraindicada: se consulta con el médico antes de aplicarla.</div>` : "";
  if(!reloj.anda()) dibujar();
}

function resumen(){
  const d = datos(), l = [];
  l.push("Promedios: " + horas(d.tib) + " en cama · " + horas(d.tst) + " dormido · eficiencia " + Math.round(d.ef) + " %");
  l.push("VENTANA: de " + hhmm(d.acostar) + " a " + hhmm(d.lev) + " (" + horas(d.largo) + ")");
  const r = Kit.activas("reglas");
  if(r.length) l.push("Reglas acordadas: " + r.join("; "));
  const a = Kit.activas("antecedentes");
  if(a.length) l.push("Antecedentes a consultar: " + a.join(", "));
  return l.join("\n");
}

Kit.chips("reglas", REGLAS, null, true);
Kit.chips("antecedentes", ANTECEDENTES, leer, true);
["tib", "tst", "levantar"].forEach(id => $(id).addEventListener("input", () => { prog = 0; leer(); }));
$("efSemana").addEventListener("input", leer);

Kit.iniciar({ clave: "tcc-ventana-de-sueno", alCambiar: leer, resumen: resumen });
