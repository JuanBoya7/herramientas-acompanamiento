@@meta
archivo: act-fear-a-dare.html
titulo: De FEAR a DARE
orden: 14
enfoque: ACT
etiqueta: Acción comprometida
sub: Cuando un paso valioso se frena, casi siempre tropieza en alguna de las cuatro barreras FEAR (fusión con pensamientos, exceso en la meta, aversión al malestar o quedar remoto del valor). Cada barrera que marcas enciende su contraparte DARE para destrabar el movimiento sin esperar a dejar de sentir incomodidad.
fuente: Barreras FEAR y respuestas DARE en el plan de disposición y acción, en Harris, ACT Made Simple (2009), caps. 12 y 13; Luoma, Hayes y Walser, Learning ACT (2017), cap. 7.
resumen: Se elige el paso valioso que está frenado y se marcan las barreras FEAR presentes. El panel transforma en vivo cada obstáculo en su respuesta DARE (defusión, aceptación, realismo en la meta y enlace con el valor) para acordar la versión más pequeña y honesta del paso.
@@css
  .rejilla-fd{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:8px}
  .caja-fd{border:1px solid var(--linea);border-radius:10px;padding:13px 15px;background:#fbfcfd;
    transition:border-color .2s,background .2s,box-shadow .2s}
  .caja-fd.fear{border-left:4px solid #b0503f}
  .caja-fd.fear.encendida{background:#fdf6f4;border-color:#d9a196;border-left-color:#b0503f}
  .caja-fd.dare{border-left:4px solid #9aa8b5;opacity:.62}
  .caja-fd.dare.encendida{border-left-color:#3f7d5a;background:#f4faf6;border-color:#b8dcc8;
    opacity:1;box-shadow:0 2px 6px rgba(63,125,90,.08)}
  .sigla{display:inline-flex;align-items:center;gap:7px;font-size:14.5px;font-weight:700;margin-bottom:4px}
  .sigla .letra{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;
    border-radius:6px;color:#fff;font-size:13px;font-weight:800}
  .fear .letra{background:#b0503f}
  .dare .letra{background:#7d8994}
  .dare.encendida .letra{background:#3f7d5a}
  .sub-fd{font-size:12.5px;color:var(--tinta-suave);margin:0 0 9px;line-height:1.4}
  @media (max-width:680px){.rejilla-fd{grid-template-columns:1fr}}
@@html
<section class="paso">
  <h2><span class="num">1</span>El paso valioso que se está frenando</h2>
  <p class="ayuda">Una acción concreta hacia algo que te importa y que vienes postergando o evitando.</p>
  <div class="cuerpo">
    <div class="chips" id="pasoValor"></div>
    <details class="apunte">
      <summary>Anotar el paso en tus palabras</summary>
      <input type="text" id="pasoDetalle" placeholder="Ej. hablar con mi hermano sobre el acuerdo familiar">
    </details>
  </div>
</section>

<section class="paso">
  <h2><span class="num">2</span>Qué barrera FEAR apareció</h2>
  <p class="ayuda">Marca lo que hoy te está frenando. Al marcar cada barrera, abajo se encenderá su
  respuesta correspondiente.</p>
  <div class="cuerpo">
    <div class="rejilla-fd">
      <div class="caja-fd fear" id="boxFF">
        <div class="sigla"><span class="letra">F</span>Fusión con pensamientos</div>
        <p class="sub-fd">Reglas o anticipaciones que se leen como órdenes literales.</p>
        <div class="chips" id="fFusion"></div>
      </div>
      <div class="caja-fd fear" id="boxFE">
        <div class="sigla"><span class="letra">E</span>Exceso en la meta</div>
        <p class="sub-fd">El escalón quedó demasiado alto o falta algún recurso.</p>
        <div class="chips" id="fExceso"></div>
      </div>
      <div class="caja-fd fear" id="boxFA">
        <div class="sigla"><span class="letra">A</span>Aversión al malestar</div>
        <p class="sub-fd">No estar dispuesto a sentir lo que viene pegado al paso.</p>
        <div class="chips" id="fAversion"></div>
      </div>
      <div class="caja-fd fear" id="boxFR">
        <div class="sigla"><span class="letra">R</span>Remoto del valor</div>
        <p class="sub-fd">El paso se volvió un «debería» desconectado de lo que cuidas.</p>
        <div class="chips" id="fRemoto"></div>
      </div>
    </div>
  </div>
</section>

<section class="bloque" id="panelDare">
  <h2><span class="num">3</span>Transformar en DARE: la respuesta para cada barrera</h2>
  <p class="ayuda" id="ayudaDare">Las tarjetas iluminadas responden a las barreras que marcaste arriba.
  Elige qué movimiento vas a usar hoy.</p>
  <div class="cuerpo">
    <div class="rejilla-fd">
      <div class="caja-fd dare" id="boxDD">
        <div class="sigla"><span class="letra">D</span>Defusión (para F · Fusión)</div>
        <p class="sub-fd">Nombrar la historia y llevarla contigo sin esperar a que se calle.</p>
        <div class="chips" id="dDefusion"></div>
      </div>
      <div class="caja-fd dare" id="boxDA">
        <div class="sigla"><span class="letra">A</span>Aceptación (para A · Aversión)</div>
        <p class="sub-fd">Abrirle sitio en el cuerpo a esa incomodidad porque el paso lo vale.</p>
        <div class="chips" id="dAceptacion"></div>
      </div>
      <div class="caja-fd dare" id="boxDR">
        <div class="sigla"><span class="letra">R</span>Realismo en la meta (para E · Exceso)</div>
        <p class="sub-fd">Partir el escalón a la mitad o pedir lo que hoy falta.</p>
        <div class="chips" id="dRealismo"></div>
      </div>
      <div class="caja-fd dare" id="boxDE">
        <div class="sigla"><span class="letra">E</span>Enlazar con el valor (para R · Remoto)</div>
        <p class="sub-fd">Recordar qué cualidad personal o qué vínculo honras al darlo.</p>
        <div class="chips" id="dValor"></div>
      </div>
    </div>
  </div>
</section>

<section class="bloque pregunta-sola">
  <div class="pregunta" id="pregunta">¿Cuál es la versión más pequeña y honesta de este paso que sí estás dispuesto a dar con el malestar incluido?</div>
  <div class="cuerpo" style="padding:10px 0 0">
    <div class="chips" id="compromisoDare"></div>
  </div>
</section>
@@js
const $ = Kit.$;

const PASO_VALOR = [
  "Tener una conversación honesta",
  "Retomar una actividad que abandoné",
  "Poner un límite claro",
  "Entregar o mostrar un avance imperfecto",
  "Cuidar mi cuerpo hoy"
];

const F_FUSION = [
  "«No estoy listo todavía»",
  "«Va a salir mal»",
  "«Ya es demasiado tarde»"
];
const F_EXCESO = [
  "Querer resolver todo de golpe",
  "Exigirme no sentir nervios",
  "No tener tiempo ni recursos para un paso tan grande"
];
const F_AVERSION = [
  "No querer sentir ansiedad o incomodidad",
  "Evitar la posibilidad de un no",
  "Miedo a sentir culpa o vergüenza"
];
const F_REMOTO = [
  "Hacerlo por obligación o para quedar bien",
  "Olvidar qué cuido detrás de este paso",
  "Compararme con cómo lo hacen otros"
];

const D_DEFUSION = [
  "Decirme: «Ahí está la historia de que no voy a poder»",
  "Agradecerle a mi mente por intentar protegerme y seguir",
  "Llevar el pensamiento en el bolsillo mientras doy el paso"
];
const D_ACEPTACION = [
  "Respirar alrededor de los nervios y dejarlos estar",
  "Estar dispuesto a sentir incomodidad diez minutos por esto",
  "Aflojar los hombros y avanzar con el nudo incluido"
];
const D_REALISMO = [
  "Partir el paso a la mitad para hacerlo hoy mismo",
  "Empezar solo por los primeros diez minutos",
  "Pedir ayuda o preparar antes lo que me falta"
];
const D_VALOR = [
  "Recordar a quién o qué cuido detrás de esta acción",
  "Elegir cómo quiero portarme yo, más allá del resultado",
  "Hacerlo como un gesto de cuidado propio y no como un examen"
];

const COMPROMISO = [
  "Dar hoy solo el primer tramo aunque aparezca la duda",
  "Hacer la llamada o enviar el mensaje sin reescribirlo diez veces",
  "Dedicar quince minutos llevando la incomodidad conmigo",
  "Sostener mi límite con amabilidad aunque me dé culpa"
];

function leer(){
  const hayF = Kit.activas("fFusion").length > 0 || Kit.activas("dDefusion").length > 0;
  const hayE = Kit.activas("fExceso").length > 0 || Kit.activas("dRealismo").length > 0;
  const hayA = Kit.activas("fAversion").length > 0 || Kit.activas("dAceptacion").length > 0;
  const hayR = Kit.activas("fRemoto").length > 0 || Kit.activas("dValor").length > 0;

  $("boxFF").classList.toggle("encendida", Kit.activas("fFusion").length > 0);
  $("boxFE").classList.toggle("encendida", Kit.activas("fExceso").length > 0);
  $("boxFA").classList.toggle("encendida", Kit.activas("fAversion").length > 0);
  $("boxFR").classList.toggle("encendida", Kit.activas("fRemoto").length > 0);

  $("boxDD").classList.toggle("encendida", hayF);
  $("boxDR").classList.toggle("encendida", hayE);
  $("boxDA").classList.toggle("encendida", hayA);
  $("boxDE").classList.toggle("encendida", hayR);
}

function resumen(){
  const l = [];
  const p = Kit.activas("pasoValor");
  const det = $("pasoDetalle").value.trim();
  if(p.length || det) l.push("Paso valioso frenado: " + p.concat(det ? [det] : []).join(" · "));

  const pares = [
    ["F · Fusión", "fFusion", "D · Defusión", "dDefusion"],
    ["E · Exceso en la meta", "fExceso", "R · Realismo en la meta", "dRealismo"],
    ["A · Aversión al malestar", "fAversion", "A · Aceptación", "dAceptacion"],
    ["R · Remoto del valor", "fRemoto", "E · Enlazar con el valor", "dValor"]
  ];
  pares.forEach(([nf, idf, nd, idd]) => {
    const af = Kit.activas(idf), ad = Kit.activas(idd);
    if(af.length || ad.length){
      l.push("", `${nf}: ${af.join(", ") || "—"}`);
      l.push(`  → ${nd}: ${ad.join(", ") || "—"}`);
    }
  });

  const c = Kit.activas("compromisoDare");
  if(c.length) l.push("", "Paso pequeño dispuesto a dar hoy: " + c.join(", "));
  return l.join("\n");
}

Kit.chips("pasoValor", PASO_VALOR, leer);
Kit.chips("fFusion", F_FUSION, leer);
Kit.chips("fExceso", F_EXCESO, leer);
Kit.chips("fAversion", F_AVERSION, leer);
Kit.chips("fRemoto", F_REMOTO, leer);
Kit.chips("dDefusion", D_DEFUSION, leer);
Kit.chips("dAceptacion", D_ACEPTACION, leer);
Kit.chips("dRealismo", D_REALISMO, leer);
Kit.chips("dValor", D_VALOR, leer);
Kit.chips("compromisoDare", COMPROMISO);
$("pasoDetalle").addEventListener("input", leer);
leer();

Kit.iniciar({
  clave: "act-fear-a-dare",
  alCambiar: leer,
  resumen: resumen
});
