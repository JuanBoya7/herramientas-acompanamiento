@@meta
archivo: met-las-dos-caras.html
titulo: Las dos caras de la moneda
orden: 17
enfoque: ACT
etiqueta: Aceptación y valores
sub: Donde hay un dolor hondo casi siempre vive, en el reverso, algo o alguien que importa muchísimo. Son las dos caras de una misma moneda: solo dejaría de doler si dejara de importar. Intentar partir o arrancar la cara del dolor apaga también el amor y el sentido; llevar la moneda completa permite honrar lo que cuidas hoy.
fuente: El dolor y los valores como dos caras de la misma moneda en pérdidas y crisis vitales, en Harris, When Life Hits Hard (2021), caps. 9, 13 y 21; Trauma-Focused ACT (2021), caps. 24 y 31.
resumen: Se nombra qué duele hoy en una cara de la moneda y qué amor o valor habita en el reverso. En la escena en acuarela se gira la moneda, se comprueba qué ocurre al intentar esconder el dolor y se elige llevar la moneda entera con un gesto que honre ese valor.
@@css
  .moneda-svg{display:block;width:100%;height:auto;max-width:700px;margin:0 auto;cursor:pointer}
  .fase{font-size:19px;font-weight:700;text-align:center;margin:8px auto 2px;color:var(--acento);
    min-height:28px;max-width:600px;line-height:1.35}
  .fase-sub{text-align:center;font-size:14px;color:var(--tinta-suave);max-width:560px;margin:0 auto;
    min-height:22px;line-height:1.5}
@@html
<section class="paso">
  <h2><span class="num">1</span>La cara que duele hoy</h2>
  <p class="ayuda">Qué forma tiene el dolor, la tristeza, el vacío o el temor que hoy se hace sentir.</p>
  <div class="cuerpo">
    <div class="chips" id="caraDolor"></div>
  </div>
</section>

<section class="paso">
  <h2><span class="num">2</span>El reverso: qué amor o qué valor vive detrás de ese dolor</h2>
  <p class="ayuda">Si este dolor pudiera hablar de lo que te importa cuidar, ¿qué diría que hay del
  otro lado de la moneda?</p>
  <div class="cuerpo">
    <div class="chips" id="caraValor"></div>
  </div>
</section>

<div class="escenario">
  <svg class="moneda-svg" id="svgMoneda" viewBox="0 0 700 467" role="img"
    aria-label="Una moneda de bronce sobre una mesa: en una cara el dolor, en la otra lo que importa"></svg>
  <div class="duracion" id="mandosMoneda">
    <button type="button" class="chip activa" id="btnGirar" onclick="girarMoneda()">Girar la moneda: ver el dolor / ver el valor</button>
    <button type="button" class="chip" id="btnEsconder" onclick="esconderMoneda()">Intentar partir o esconder la moneda</button>
    <button type="button" class="chip" id="btnCompleta" onclick="llevarCompleta()">Llevar la moneda completa en la mano</button>
  </div>
</div>

<section class="bloque pregunta-sola">
  <div class="pregunta" id="pregunta">Si este dolor es el reverso de lo que tanto te importa, ¿con qué gesto pequeño podrías honrar hoy ese lado de la moneda?</div>
  <div class="cuerpo" style="padding:10px 0 0">
    <div class="chips" id="gestoHonrar"></div>
  </div>
</section>
@@js
const $ = Kit.$;

const DOLOR = [
  "Tristeza profunda o añoranza",
  "Vacío por lo que cambió o ya no está",
  "Miedo a volver a perder",
  "Culpa por lo que quedó pendiente",
  "Dolor al recordar"
];
const VALOR = [
  "Haber querido de verdad",
  "El cuidado y la lealtad hacia los míos",
  "El deseo de construir vínculos auténticos",
  "La gratitud por lo compartido",
  "Lo que todavía quiero honrar con mi vida"
];
const GESTO = [
  "Permitirme sentir la tristeza un momento como muestra de afecto",
  "Tener un gesto de cuidado con alguien que quiero hoy",
  "Recordar con gratitud algo vivido sin huir de la emoción",
  "Hacer hoy algo pequeño que represente ese valor"
];

/* estado: "dolor" | "valor" | "escondida" | "completa" */
let estado = "dolor";
let giro = 0, giroMeta = 0;         /* 0 = dolor, 1 = valor */
let opacidad = 1, opacidadMeta = 1;

function textoDolor(){
  const d = Kit.activas("caraDolor");
  return d.length ? d[0] : "Tristeza profunda o añoranza";
}
function textoValor(){
  const v = Kit.activas("caraValor");
  return v.length ? v[0] : "Haber querido de verdad";
}

let fondoMesa = null, tiempo = 0;
const CARA = {dolor:"[[imagen:moneda-dolor.webp]]", valor:"[[imagen:moneda-valor.webp]]"};
function dibujar(){
  const svg = $("svgMoneda");
  svg.innerHTML = "";
  const g = (tag, a, p) => (p || svg).appendChild(Kit.svg(tag, a));
  const rotulo = (x, y, s, color, op) => {
    const e = Kit.svg("text", {x, y, "text-anchor":"middle",
      style:`font:600 15px Georgia,serif;font-style:italic;fill:${color};opacity:${op};paint-order:stroke;stroke:#fbf6ea;stroke-width:4.5px;stroke-linejoin:round`});
    e.textContent = s.length > 44 ? s.slice(0, 42) + "…" : s; svg.appendChild(e);
  };
  const moneda = (clave, cara, x, y, radio, escalaX, op) => {
    g("ellipse", {cx:x + 6, cy:y + radio * 0.86, rx:radio * 0.9 * Math.max(0.12, escalaX), ry:radio * 0.2, fill:"#231c14", opacity:(0.28 * op).toFixed(2)});
    const gm = Kit.svg("g", {transform:`translate(${x} ${y}) scale(${Math.max(0.04, escalaX).toFixed(3)} 1)`, opacity:op.toFixed(2)});
    gm.appendChild(Kit.figura(clave, CARA[cara], {x:-radio, y:-radio, width:radio * 2, height:radio * 2}));
    svg.appendChild(gm);
  };
  if(!fondoMesa) fondoMesa = Kit.svg("image", {href:"[[imagen:moneda-acuarela.jpg]]", x:0, y:0, width:700, height:467, preserveAspectRatio:"none"});
  svg.appendChild(fondoMesa);

  if(estado === "completa"){
    /* la moneda entera: las dos caras a la vista, unidas */
    g("path", {d:"M262 205 Q350 150 438 205 Q350 260 262 205 Z", fill:"#f0c75e", opacity:.3, filter:Kit.acuarela(svg)});
    moneda("mCd", "dolor", 232, 200 + Math.sin(tiempo * 1.3) * 3, 84, 1, 1);
    moneda("mCv", "valor", 468, 200 - Math.sin(tiempo * 1.3) * 3, 84, 1, 1);
    rotulo(232, 322, textoDolor(), "#6b2f24", 1);
    rotulo(468, 322, textoValor(), "#1f5a45", 1);
    return;
  }
  /* la moneda gira sobre su canto: nunca muestra una cara sin llevar la otra detrás */
  const ang = giro * Math.PI, escalaX = Math.abs(Math.cos(ang)), viendoValor = giro > 0.5;
  moneda("mG" + (viendoValor ? "v" : "d"), viendoValor ? "valor" : "dolor", 350, 200, 106, escalaX, opacidad);
  if(estado === "escondida"){
    /* tapar la cara que duele apaga la moneda entera */
    g("rect", {x:0, y:0, width:700, height:467, fill:"#8d949b", opacity:.3, style:"mix-blend-mode:saturation"});
    rotulo(350, 344, textoValor(), "#5d666e", 0.55);
  } else {
    rotulo(350, 344, viendoValor ? textoValor() : textoDolor(), viendoValor ? "#1f5a45" : "#6b2f24", Math.min(1, escalaX * 1.6).toFixed(2));
  }
}

$("svgMoneda").addEventListener("click", () => {
  if(estado === "completa" || estado === "escondida") estado = "dolor";
  girarMoneda();
});

const reloj = Kit.reloj(dt => {
  giro += (giroMeta - giro) * Math.min(1, dt * 6);
  opacidad += (opacidadMeta - opacidad) * Math.min(1, dt * 5);
  if(Math.abs(giroMeta - giro) < 0.01 && Math.abs(opacidadMeta - opacidad) < 0.01){
    giro = giroMeta; opacidad = opacidadMeta;
    reloj.parar();
  }
  dibujar();
});

function actualizarUI(){
  $("btnGirar").classList.toggle("activa", estado === "dolor" || estado === "valor");
  $("btnEsconder").classList.toggle("activa", estado === "escondida");
  $("btnCompleta").classList.toggle("activa", estado === "completa");
}

function girarMoneda(){
  opacidadMeta = 1;
  if(estado === "dolor"){
    estado = "valor"; giroMeta = 1;
  } else {
    estado = "dolor"; giroMeta = 0;
  }
  actualizarUI();
  reloj.andar();
  Kit.guardar();
}

function esconderMoneda(){
  estado = "escondida";
  opacidadMeta = 0.28;
  actualizarUI();
  reloj.andar();
  Kit.guardar();
}

function llevarCompleta(){
  estado = "completa";
  opacidadMeta = 1;
  actualizarUI();
  dibujar();
  Kit.guardar();
}

function leer(){
  actualizarUI();
  dibujar();
}

function resumen(){
  const l = [];
  const d = Kit.activas("caraDolor");
  if(d.length) l.push("Cara A · Lo que hoy duele: " + d.join(", "));
  const v = Kit.activas("caraValor");
  if(v.length) l.push("Cara B · Qué amor o valor vive detrás: " + v.join(", "));
  l.push("Posición en la escena: " + (
    estado === "completa" ? "Llevar la moneda completa en la mano"
    : estado === "escondida" ? "Comprobando el costo de esconder la moneda"
    : estado === "valor" ? "Mirando el reverso del valor" : "Mirando la cara del dolor"
  ));
  const g = Kit.activas("gestoHonrar");
  if(g.length) l.push("Gesto pequeño para honrar ese lado de la moneda hoy: " + g.join(", "));
  return l.join("\n");
}

Kit.chips("caraDolor", DOLOR, leer);
Kit.chips("caraValor", VALOR, leer);
Kit.chips("gestoHonrar", GESTO);
dibujar();

Kit.iniciar({
  clave: "met-las-dos-caras",
  alCambiar: leer,
  resumen: resumen,
  extra: () => ({estado}),
  restaurar: d => {
    estado = (d && d.estado) || "dolor";
    giro = giroMeta = estado === "valor" ? 1 : 0;
    opacidad = opacidadMeta = estado === "escondida" ? 0.28 : 1;
  }
});
