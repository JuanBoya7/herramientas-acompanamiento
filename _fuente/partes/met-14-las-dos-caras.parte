@@meta
archivo: met-las-dos-caras.html
titulo: Las dos caras de la moneda
orden: 17
enfoque: ACT
etiqueta: Aceptación y valores
sub: Donde hay un dolor hondo casi siempre vive, en el reverso, algo o alguien que importa muchísimo. Son las dos caras de una misma moneda: solo dejaría de doler si dejara de importar. Intentar partir o arrancar la cara del dolor apaga también el amor y el sentido; llevar la moneda completa permite honrar lo que cuidas hoy.
fuente: El dolor y los valores como dos caras de la misma moneda en pérdidas y crisis vitales, en Harris, When Life Hits Hard (2021), caps. 9, 13 y 21; Trauma-Focused ACT (2021), caps. 24 y 31.
resumen: Se nombra qué duele hoy en una cara de la moneda y qué amor o valor habita en el reverso. En la escena en acuarela se gira la moneda, se comprueba qué ocurre al intentar esconder el dolor y se elige llevar la moneda entera con un gesto que honre ese valor.
@@css
  .moneda-svg{display:block;width:100%;height:auto;max-width:700px;margin:0 auto;cursor:pointer}
  .fase{font-size:19px;font-weight:700;text-align:center;margin:8px auto 2px;color:var(--acento);
    min-height:28px;max-width:600px;line-height:1.35}
  .fase-sub{text-align:center;font-size:14px;color:var(--tinta-suave);max-width:560px;margin:0 auto;
    min-height:22px;line-height:1.5}
@@html
<section class="paso">
  <h2><span class="num">1</span>La cara que duele hoy</h2>
  <p class="ayuda">Qué forma tiene el dolor, la tristeza, el vacío o el temor que hoy se hace sentir.</p>
  <div class="cuerpo">
    <div class="chips" id="caraDolor"></div>
  </div>
</section>

<section class="paso">
  <h2><span class="num">2</span>El reverso: qué amor o qué valor vive detrás de ese dolor</h2>
  <p class="ayuda">Si este dolor pudiera hablar de lo que te importa cuidar, ¿qué diría que hay del
  otro lado de la moneda?</p>
  <div class="cuerpo">
    <div class="chips" id="caraValor"></div>
  </div>
</section>

<div class="escenario">
  <svg class="moneda-svg" id="svgMoneda" viewBox="0 0 700 250" role="img"
    aria-label="Una moneda artesanal con el dolor en una cara y el valor en el reverso"></svg>
  <div class="fase" id="fase">Cara A a la vista: lo que hoy duele</div>
  <div class="fase-sub" id="faseSub">Toca para girar la moneda y mirar qué sostiene este dolor del otro lado.</div>
  <div class="duracion" id="mandosMoneda">
    <button type="button" class="chip activa" id="btnGirar" onclick="girarMoneda()">Girar la moneda: ver el dolor / ver el valor</button>
    <button type="button" class="chip" id="btnEsconder" onclick="esconderMoneda()">Intentar partir o esconder la moneda</button>
    <button type="button" class="chip" id="btnCompleta" onclick="llevarCompleta()">Llevar la moneda completa en la mano</button>
  </div>
</div>

<section class="bloque pregunta-sola">
  <div class="pregunta" id="pregunta">Si este dolor es el reverso de lo que tanto te importa, ¿con qué gesto pequeño podrías honrar hoy ese lado de la moneda?</div>
  <div class="cuerpo" style="padding:10px 0 0">
    <div class="chips" id="gestoHonrar"></div>
  </div>
</section>
@@js
const $ = Kit.$;

const DOLOR = [
  "Tristeza profunda o añoranza",
  "Vacío por lo que cambió o ya no está",
  "Miedo a volver a perder",
  "Culpa por lo que quedó pendiente",
  "Dolor al recordar"
];
const VALOR = [
  "Haber querido de verdad",
  "El cuidado y la lealtad hacia los míos",
  "El deseo de construir vínculos auténticos",
  "La gratitud por lo compartido",
  "Lo que todavía quiero honrar con mi vida"
];
const GESTO = [
  "Permitirme sentir la tristeza un momento como muestra de afecto",
  "Tener un gesto de cuidado con alguien que quiero hoy",
  "Recordar con gratitud algo vivido sin huir de la emoción",
  "Hacer hoy algo pequeño que represente ese valor"
];

/* estado: "dolor" | "valor" | "escondida" | "completa" */
let estado = "dolor";
let giro = 0, giroMeta = 0;         /* 0 = dolor, 1 = valor */
let opacidad = 1, opacidadMeta = 1;

function textoDolor(){
  const d = Kit.activas("caraDolor");
  return d.length ? d[0] : "Tristeza profunda o añoranza";
}
function textoValor(){
  const v = Kit.activas("caraValor");
  return v.length ? v[0] : "Haber querido de verdad";
}

function dibujar(){
  const svg = $("svgMoneda");
  svg.innerHTML = "";
  const g = (tag, a) => svg.appendChild(Kit.svg(tag, a));

  const fondo = estado === "escondida" ? "#eceff2" : estado === "completa" ? "#f2faf5" : "#f7f5ef";
  g("rect", {x:0, y:0, width:700, height:250, rx:10, fill:fondo});

  if(estado === "completa"){
    /* vista de la moneda entera mostrando simultáneamente sus dos caras unidas en la palma */
    /* silueta suave de mano sosteniendo ambas caras */
    g("path", {
      d:"M150 205 Q350 238 550 205 Q515 182 350 186 Q185 182 150 205 Z",
      fill:"#e5c4aa", opacity:.85, filter:Kit.acuarela(svg)
    });
    /* arco que une las dos caras de la misma moneda */
    g("path", {
      d:"M230 112 Q350 58 470 112",
      fill:"none", stroke:"#c9962f", "stroke-width":3, "stroke-dasharray":"5 4"
    });

    /* Cara izquierda: Dolor */
    const gd = Kit.svg("g", {transform:"translate(225 118)", filter:Kit.acuarela(svg)});
    gd.appendChild(Kit.svg("circle", {cx:0, cy:0, r:74, fill:"#d88c7a", stroke:"#9e4736", "stroke-width":3}));
    gd.appendChild(Kit.svg("circle", {cx:0, cy:0, r:63, fill:"none", stroke:"#fbe7e2", "stroke-width":1.4, "stroke-dasharray":"4 4"}));
    svg.appendChild(gd);
    const td1 = g("text", {x:225, y:96, "text-anchor":"middle", style:"font:700 11px system-ui,sans-serif;fill:#5e2218;letter-spacing:.7px"});
    td1.textContent = "ANVERSO · EL DOLOR";
    const td2 = g("text", {x:225, y:122, "text-anchor":"middle", style:"font:700 13px system-ui,sans-serif;fill:#3b130d"});
    const sD = textoDolor();
    td2.textContent = sD.length > 24 ? sD.slice(0, 23) + "…" : sD;

    /* Cara derecha: Valor */
    const gv = Kit.svg("g", {transform:"translate(475 118)", filter:Kit.acuarela(svg)});
    gv.appendChild(Kit.svg("circle", {cx:0, cy:0, r:74, fill:"#6ab08e", stroke:"#2f6f50", "stroke-width":3}));
    gv.appendChild(Kit.svg("circle", {cx:0, cy:0, r:63, fill:"none", stroke:"#e8f7ef", "stroke-width":1.4, "stroke-dasharray":"4 4"}));
    svg.appendChild(gv);
    const tv1 = g("text", {x:475, y:96, "text-anchor":"middle", style:"font:700 11px system-ui,sans-serif;fill:#17422d;letter-spacing:.7px"});
    tv1.textContent = "REVERSO · EL VALOR";
    const tv2 = g("text", {x:475, y:122, "text-anchor":"middle", style:"font:700 13px system-ui,sans-serif;fill:#102e1f"});
    const sV = textoValor();
    tv2.textContent = sV.length > 24 ? sV.slice(0, 23) + "…" : sV;

    const tc = g("text", {x:350, y:232, "text-anchor":"middle", style:"font:700 13px system-ui,sans-serif;fill:#2c5a44"});
    tc.textContent = "Una sola moneda en la mano: hay sitio para el dolor porque hay sitio para el amor";
    return;
  }

  /* giro 3D de la moneda en el centro (coseno de pi * giro) */
  const ang = giro * Math.PI;
  const cos = Math.cos(ang);
  const escalaX = Math.max(0.06, Math.abs(cos));
  const viendoValor = cos < 0;

  const gm = Kit.svg("g", {
    transform:`translate(350 122) scale(${escalaX.toFixed(2)} 1)`,
    opacity:opacidad.toFixed(2),
    filter:Kit.acuarela(svg)
  });
  const colRelleno = estado === "escondida" ? "#b5bec7" : (viendoValor ? "#6ab08e" : "#d88c7a");
  const colBorde = estado === "escondida" ? "#7b8691" : (viendoValor ? "#2f6f50" : "#9e4736");
  gm.appendChild(Kit.svg("circle", {cx:0, cy:0, r:88, fill:colRelleno, stroke:colBorde, "stroke-width":3.5}));
  gm.appendChild(Kit.svg("circle", {cx:0, cy:0, r:75, fill:"none", stroke:"#ffffff", "stroke-opacity":.65, "stroke-width":1.6, "stroke-dasharray":"5 4"}));
  svg.appendChild(gm);

  if(escalaX > 0.22){
    const gt = Kit.svg("g", {opacity:(opacidad * Math.min(1, (escalaX - 0.2) * 2)).toFixed(2)});
    const tSup = Kit.svg("text", {
      x:350, y:95, "text-anchor":"middle",
      style:`font:700 11.5px system-ui,sans-serif;fill:${viendoValor ? "#17422d" : "#5e2218"};letter-spacing:.7px`
    });
    tSup.textContent = estado === "escondida"
      ? "MONEDA APAGADA"
      : (viendoValor ? "CARA B · EL AMOR Y EL VALOR DETRÁS" : "CARA A · LO QUE HOY DUELE");
    gt.appendChild(tSup);

    const tCen = Kit.svg("text", {
      x:350, y:126, "text-anchor":"middle",
      style:"font:700 15px system-ui,sans-serif;fill:#1f2421"
    });
    const frase = estado === "escondida"
      ? "Sin dolor, pero también sin lo que amas"
      : (viendoValor ? textoValor() : textoDolor());
    tCen.textContent = frase.length > 34 ? frase.slice(0, 33) + "…" : frase;
    gt.appendChild(tCen);

    const tInf = Kit.svg("text", {
      x:350, y:152, "text-anchor":"middle",
      style:"font:600 12px system-ui,sans-serif;fill:#2e3833"
    });
    tInf.textContent = estado === "escondida"
      ? "Al bloquear una cara, se apaga la otra"
      : "Toca la moneda para ver su reverso";
    gt.appendChild(tInf);
    svg.appendChild(gt);
  }
}

$("svgMoneda").addEventListener("click", () => {
  if(estado === "completa" || estado === "escondida") estado = "dolor";
  girarMoneda();
});

const reloj = Kit.reloj(dt => {
  giro += (giroMeta - giro) * Math.min(1, dt * 6);
  opacidad += (opacidadMeta - opacidad) * Math.min(1, dt * 5);
  if(Math.abs(giroMeta - giro) < 0.01 && Math.abs(opacidadMeta - opacidad) < 0.01){
    giro = giroMeta; opacidad = opacidadMeta;
    reloj.parar();
  }
  dibujar();
});

function actualizarUI(){
  $("btnGirar").classList.toggle("activa", estado === "dolor" || estado === "valor");
  $("btnEsconder").classList.toggle("activa", estado === "escondida");
  $("btnCompleta").classList.toggle("activa", estado === "completa");

  if(estado === "dolor"){
    $("fase").textContent = "Cara A a la vista: lo que hoy duele";
    $("faseSub").textContent = "Toca para girar la moneda y mirar qué sostiene este dolor del otro lado.";
  } else if(estado === "valor"){
    $("fase").textContent = "Cara B a la vista: el amor y el valor en el reverso";
    $("faseSub").textContent = "Duele porque importa. Sin este cuidado tampoco existiría ese dolor.";
  } else if(estado === "escondida"){
    $("fase").textContent = "Intentar esconder o arrancar el lado que duele";
    $("faseSub").textContent = "No se puede borrar una sola cara de una moneda: al anestesiar el dolor se apaga también el vínculo.";
  } else {
    $("fase").textContent = "Llevar la moneda completa en la mano";
    $("faseSub").textContent = "Haces espacio para el dolor porque eliges quedarte con el amor y el sentido que viven en el reverso.";
  }
}

function girarMoneda(){
  opacidadMeta = 1;
  if(estado === "dolor"){
    estado = "valor"; giroMeta = 1;
  } else {
    estado = "dolor"; giroMeta = 0;
  }
  actualizarUI();
  reloj.andar();
  Kit.guardar();
}

function esconderMoneda(){
  estado = "escondida";
  opacidadMeta = 0.28;
  actualizarUI();
  reloj.andar();
  Kit.guardar();
}

function llevarCompleta(){
  estado = "completa";
  opacidadMeta = 1;
  Kit.brindis("La moneda entera en la mano: dolor y valor juntos");
  actualizarUI();
  dibujar();
  Kit.guardar();
}

function leer(){
  actualizarUI();
  dibujar();
}

function resumen(){
  const l = [];
  const d = Kit.activas("caraDolor");
  if(d.length) l.push("Cara A · Lo que hoy duele: " + d.join(", "));
  const v = Kit.activas("caraValor");
  if(v.length) l.push("Cara B · Qué amor o valor vive detrás: " + v.join(", "));
  l.push("Posición en la escena: " + (
    estado === "completa" ? "Llevar la moneda completa en la mano"
    : estado === "escondida" ? "Comprobando el costo de esconder la moneda"
    : estado === "valor" ? "Mirando el reverso del valor" : "Mirando la cara del dolor"
  ));
  const g = Kit.activas("gestoHonrar");
  if(g.length) l.push("Gesto pequeño para honrar ese lado de la moneda hoy: " + g.join(", "));
  return l.join("\n");
}

Kit.chips("caraDolor", DOLOR, leer);
Kit.chips("caraValor", VALOR, leer);
Kit.chips("gestoHonrar", GESTO);
dibujar();

Kit.iniciar({
  clave: "met-las-dos-caras",
  alCambiar: leer,
  resumen: resumen,
  extra: () => ({estado}),
  restaurar: d => {
    estado = (d && d.estado) || "dolor";
    giro = giroMeta = estado === "valor" ? 1 : 0;
    opacidad = opacidadMeta = estado === "escondida" ? 0.28 : 1;
  }
});
