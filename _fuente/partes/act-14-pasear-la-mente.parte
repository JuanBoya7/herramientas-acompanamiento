@@meta
archivo: act-pasear-la-mente.html
titulo: Sacar la mente a pasear
enfoque: ACT
etiqueta: Defusión
sub: Los pies caminan hacia donde elegiste y la mente va flotando al lado, comentando sin parar. Se puede frenar a discutir con ella o seguir caminando con ella hablando.
fuente: Ejercicio clásico «Taking Your Mind for a Walk» (Hayes, Strosahl y Wilson, 1999, cap. 6; 2012; Luoma, Hayes y Walser, 2017).
resumen: La mente comenta sola, con frases barajadas. Pararse a discutir detiene los pies y multiplica los comentarios; seguir caminando no la calla, y las cuadras avanzan. El marcador cuenta las veces que se volvió a caminar.
@@css
  .marcas div{min-width:120px}
  .mandos button.discutir{background:#7a4b3a;border-color:#7a4b3a;color:#fff;font-weight:600}
  .mandos button.discutir:hover{background:#673e30;border-color:#673e30}
  .mandos button.seguir{background:#2f7a5f;border-color:#2f7a5f;color:#fff;font-weight:600}
  .mandos button.seguir:hover{background:#27674f;border-color:#27674f}
@@html
<section class="paso">
  <h2><span class="num">1</span>Hacia dónde caminan hoy tus pies y qué va diciendo tu mente</h2>
  <div class="cuerpo">
    <label class="etiqueta">Hacia dónde vas</label>
    <div class="chips" id="rumbo">
      <button class="chip" data-v="Hacer esa llamada pendiente">Hacer esa llamada pendiente</button>
      <button class="chip" data-v="Retomar mi cuidado personal">Retomar mi cuidado personal</button>
      <button class="chip" data-v="Presentar mi trabajo">Presentar mi trabajo</button>
      <button class="chip" data-v="Acercarme a alguien importante">Acercarme a alguien importante</button>
    </div>
    <label class="etiqueta">Lo que comenta tu mente cuando das el primer paso</label>
    <div class="chips" id="parloteo">
      <button class="chip" data-v="«Hoy no estás listo, déjalo para mañana»">«Hoy no estás listo, déjalo para mañana»</button>
      <button class="chip" data-v="«Te va a salir mal y se va a notar»">«Te va a salir mal y se va a notar»</button>
      <button class="chip" data-v="«¿Para qué, si ya fallaste antes?»">«¿Para qué, si ya fallaste antes?»</button>
      <button class="chip" data-v="«Primero resuelve todas tus dudas»">«Primero resuelve todas tus dudas»</button>
    </div>
  </div>
</section>

<div class="escenario">
  <svg id="svgPaseo" viewBox="0 0 700 350" role="img" aria-label="Una persona camina por la acera con su mente flotando al lado"></svg>
  <div class="marcas">
    <div><span class="n" id="mPasos">0</span><span class="r">cuadras caminadas</span></div>
    <div><span class="n" id="mVolvi" style="color:#2f7a5f">0</span><span class="r">veces que volví a caminar</span></div>
  </div>
  <div class="mandos">
    <button type="button" class="discutir" id="bDiscutir">Pararme a discutir con ella</button>
    <button type="button" class="seguir" id="bSeguir">Seguir caminando con ella al lado</button>
    <button type="button" id="bReiniciar">Empezar el paseo de nuevo</button>
  </div>
</div>

<section class="bloque pregunta-sola" id="cierre">
  <div class="pregunta" id="qPaseo">La mente no se calló en todo el paseo. ¿Qué pasa con tus pies cada vez que te detienes a convencerla?</div>
  <details class="apunte">
    <summary>Anotar lo conversado</summary>
    <textarea id="apunte" placeholder="Qué paso darás esta semana llevando a tu mente de paseo..."></textarea>
  </details>
</section>
@@js
const $ = Kit.$;
Kit.chips("rumbo", {multiple:false, libre:true});
Kit.chips("parloteo", {multiple:true, libre:true});

/* ----- geometría de la calle en acuarela (700 x 350) ----- */
/* La calle mide 1148 de ancho: la cámara acompaña a la persona. */
const MUNDO = 1148, PISO = 300;  // ancho de la calle y línea por donde van los pies
const ESQUINA = 828;             // x donde la acera dobla hacia el parque
const ALTO = 115;
const FIG = {
  camina:  {href:"[[imagen:invitado-anfitrion-camina.webp]]", r:0.513},
  discute: {href:"[[imagen:paseo-discute.webp]]",             r:0.347},
  mente:   {href:"[[imagen:paseo-mente.webp]]",               r:1.39},
};
const EXTRA = ["«Si fuera el camino correcto te sentirías seguro»", "«Mira todo lo que te falta todavía»",
  "«Mejor da media vuelta»", "«¿Y si te ven dudar?»", "«No fue suficiente»", "«Cuidado, cuidado»"];

let x, modo, cuadras, volvi, t, velo, baraja, globos, sigGlobo;
function barajar(){
  const a = Kit.activas("parloteo").concat(EXTRA);
  for(let i = a.length - 1; i > 0; i--){ const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
  return a;
}
function frase(){ if(!baraja.length) baraja = barajar(); return baraja.pop(); }
function reiniciar(){
  x = 70; modo = "camina";      // camina | discute
  cuadras = 0; volvi = 0; t = 0; velo = 0; baraja = []; globos = []; sigGlobo = 1.2;
  $("qPaseo").textContent = "La mente no se calló en todo el paseo. ¿Qué pasa con tus pies cada vez que te detienes a convencerla?";
}
reiniciar();

const escena = Kit.reloj(latido);
function latido(dt){
  t += dt;
  velo = Math.max(0, velo - dt * 1.4);
  if(modo === "camina"){
    x += 34 * dt;
    if(x >= ESQUINA){                    // dobló hacia donde eligió: otra cuadra
      cuadras++; x = 40; velo = 1; globos = [];
      if(cuadras === 2) $("qPaseo").textContent = "Las cuadras avanzaron con la mente hablando todo el tiempo. ¿Qué cambia cuando descubres que no necesitas convencerla para que tus pies caminen?";
    }
  }
  /* la mente comenta sola; discutiendo, por cada respuesta saca varias objeciones */
  sigGlobo -= dt;
  if(sigGlobo <= 0){
    globos.push({txt:frase(), v:0});
    sigGlobo = modo === "discute" ? 1.1 : 3.6;
  }
  const dura = modo === "discute" ? 4.5 : 3.2;
  globos.forEach(g => g.v += dt);
  globos = globos.filter(g => g.v < dura).slice(-3);
  dibujar();
}

function renglones(s, n){
  const out = []; let fila = "";
  s.split(" ").forEach(p => { if((fila + " " + p).trim().length > n){ out.push(fila); fila = p; } else fila = (fila + " " + p).trim(); });
  if(fila) out.push(fila);
  return out.slice(0, 3);
}
let fondo = null;
function dibujar(){
  const svg = $("svgPaseo");
  svg.innerHTML = "";
  const cam = Math.min(MUNDO - 700, Math.max(0, x - 280));
  const lienzo = svg, mundo = Kit.svg("g", {transform:`translate(${(-cam).toFixed(1)} 0)`});
  lienzo.appendChild(mundo);
  const g = (tg, a, p) => (p || lienzo).appendChild(Kit.svg(tg, a));
  if(!fondo) fondo = Kit.svg("image", {href:"[[imagen:calle-acuarela.jpg]]", x:0, y:-135, width:MUNDO, height:641, preserveAspectRatio:"none"});
  mundo.appendChild(fondo);

  const rumbo = Kit.activas("rumbo")[0];
  if(rumbo){
    const e = Kit.svg("text", {x:880, y:150, "text-anchor":"middle",
      style:"font:600 13px Georgia,serif;font-style:italic;fill:#3d5a2e;paint-order:stroke;stroke:#fffbe9;stroke-width:4px;stroke-linejoin:round"});
    e.textContent = rumbo.length > 34 ? rumbo.slice(0, 32) + "…" : rumbo;
    mundo.appendChild(e);
  }

  /* la persona */
  const paso = modo === "camina" ? Math.abs(Math.sin(t * 5.2)) * 3 : 0;
  const f = FIG[modo === "camina" ? "camina" : "discute"], w = ALTO * f.r;
  mundo.appendChild(Kit.figura("yo" + modo, f.href, {x:x - w / 2, y:PISO - ALTO - paso, width:w, height:ALTO}));

  /* la mente: flota detrás del hombro, sube y baja, y habla */
  const mw = 58, mh = mw / FIG.mente.r;
  const mx = x - 58, my = PISO - ALTO - 8 + Math.sin(t * 2.1) * 5;
  mundo.appendChild(Kit.figura("mente", FIG.mente.href, {x:mx - mw / 2, y:my - mh / 2, width:mw, height:mh}));

  let base = my - mh / 2 - 8;
  globos.slice().reverse().forEach(gl => {
    const filas = renglones(gl.txt, 26), alto = filas.length * 15 + 12;
    const ancho = Math.max(...filas.map(s => s.length)) * 6.6 + 22;
    const cx = Math.min(cam + 700 - ancho / 2 - 6, Math.max(cam + ancho / 2 + 6, mx + 10));
    const dura = modo === "discute" ? 4.5 : 3.2;
    const op = Math.min(1, gl.v * 4, (dura - gl.v) * 2).toFixed(2);
    const gg = Kit.svg("g", {opacity:op});
    gg.appendChild(Kit.svg("rect", {x:cx - ancho / 2, y:base - alto, width:ancho, height:alto, rx:11, fill:"#fffdf6", stroke:"#8b8f98", "stroke-width":1.2}));
    filas.forEach((s, i) => {
      const e = Kit.svg("text", {x:cx, y:base - alto + 19 + i * 15, "text-anchor":"middle", style:"font:500 12.5px system-ui,sans-serif;fill:#3a3f47"});
      e.textContent = s; gg.appendChild(e);
    });
    mundo.appendChild(gg);
    base -= alto + 5;
  });

  if(velo > 0) g("rect", {x:0, y:0, width:700, height:350, fill:"#fffdf6", opacity:velo.toFixed(2)});

  $("mPasos").textContent = cuadras;
  $("mVolvi").textContent = volvi;
  $("bDiscutir").disabled = modo === "discute";
  $("bSeguir").disabled = modo === "camina";
}

$("bDiscutir").addEventListener("click", () => { modo = "discute"; sigGlobo = 0.3; Kit.guardar(); });
$("bSeguir").addEventListener("click", () => {
  if(modo !== "discute") return;
  modo = "camina"; volvi++; sigGlobo = 2.5;
  Kit.guardar();
});
$("bReiniciar").addEventListener("click", () => { reiniciar(); Kit.guardar(); });

Kit.iniciar({
  clave: "act-pasear-la-mente",
  alCambiar: () => { baraja = []; dibujar(); },
  resumen: () => [
    "SACAR LA MENTE A PASEAR",
    `Rumbo elegido: ${Kit.activas("rumbo")[0] || "—"}`,
    `Lo que comenta la mente: ${Kit.activas("parloteo").join(" · ") || "—"}`,
    `Cuadras caminadas: ${cuadras} · Veces que volví a caminar: ${volvi}`,
    $("apunte").value.trim() ? `Notas: ${$("apunte").value.trim()}` : ""
  ].filter(Boolean).join("\n")
});
escena.andar();
