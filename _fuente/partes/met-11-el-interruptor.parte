@@meta
archivo: met-el-interruptor.html
titulo: El interruptor de la lucha
orden: 11
enfoque: ACT
etiqueta: Aceptación
sub: Cuando aparece una emoción difícil, a veces se enciende en automático el interruptor de la lucha: pelear contra lo que se siente, culparse por sentirlo o exigir que se vaya ya. Con el interruptor encendido, el malestar limpio de la vida se multiplica en turbulencia secundaria y se lleva toda la energía. Apagarlo no borra la emoción primaria: le devuelve su tamaño natural.
fuente: El interruptor de la lucha (The Struggle Switch) y dolor limpio frente a dolor sucio, en Harris, ACT Made Simple (2009), cap. 8; Trauma-Focused ACT (2021), cap. 12.
resumen: Se distingue la emoción que llegó primero de la pelea que se encendió encima. En la escena viva, apagar el interruptor de la lucha detiene la amplificación secundaria y libera la energía, mientras la emoción natural sigue subiendo y bajando por su cuenta.
@@css
  .ondas{display:block;width:100%;height:auto;max-width:700px;margin:0 auto;cursor:pointer}
  .fase{font-size:19px;font-weight:700;text-align:center;margin:8px auto 2px;color:var(--acento);
    min-height:28px;max-width:600px;line-height:1.35}
  .fase-sub{text-align:center;font-size:14px;color:var(--tinta-suave);max-width:560px;margin:0 auto;
    min-height:22px;line-height:1.5}
  button.apagar{background:#3f7d5a;border-color:#3f7d5a;color:#fff;font-weight:600}
  button.apagar:hover{background:#356b4d;border-color:#356b4d}
  button.encender{background:#b0503f;border-color:#b0503f;color:#fff;font-weight:600}
  button.encender:hover{background:#944132;border-color:#944132}
@@html
<section class="paso">
  <h2><span class="num">1</span>Lo que llegó primero y lo que se encendió encima</h2>
  <p class="ayuda">La primera ola llega sola con vivir; la segunda aparece cuando el interruptor de
  la lucha se enciende y empezamos a pelear con lo que sentimos.</p>
  <div class="cuerpo">
    <label class="etiqueta">Lo que apareció primero (malestar limpio)</label>
    <div class="chips" id="primaria"></div>
    <label class="etiqueta">Lo que se encendió encima al pelear (lucha secundaria)</label>
    <div class="chips" id="secundaria"></div>
  </div>
</section>

<div class="escenario">
  <svg class="ondas" id="escenaInterruptor" viewBox="0 0 700 250" role="img"
    aria-label="Onda de emoción natural y un gran interruptor que enciende o apaga los anillos de lucha secundaria"></svg>
  <div class="fase" id="fase">Interruptor de la lucha: ENCENDIDO</div>
  <div class="fase-sub" id="faseSub">Cada ola natural dispara anillos de pelea secundaria y agota la energía disponible.</div>
  <div class="marcas">
    <div><span class="n" id="mEstado" style="color:#b0503f">Encendida</span><span class="r">lucha secundaria</span></div>
    <div><span class="n" id="mEnergia" style="color:#3f7d5a">18 %</span><span class="r">energía libre hoy</span></div>
  </div>
  <div class="mandos">
    <button type="button" class="apagar" id="btnInterruptor" onclick="alternarInterruptor()">Soltar el interruptor de la lucha</button>
  </div>
</div>

<section class="bloque pregunta-sola">
  <div class="pregunta" id="pregunta">Si esta emoción pudiera subir y bajar sin que tuvieras que pelearte con ella, ¿en qué usarías hoy esa energía?</div>
  <div class="cuerpo" style="padding:10px 0 0">
    <div class="chips" id="librePara"></div>
  </div>
</section>
@@js
const $ = Kit.$;

const PRIMARIA = [
  "Ansiedad o nervios",
  "Tristeza",
  "Rabia o frustración",
  "Culpa",
  "Vergüenza",
  "Dolor o fatiga física"
];
const SECUNDARIA = [
  "«No debería estar sintiendo esto»",
  "Rabia por sentirme ansioso",
  "Culpa por estar triste",
  "Miedo a perder el control",
  "Reprocharme por seguir igual"
];
const LIBRE = [
  "Atender lo que tengo entre manos hoy",
  "Estar presente con alguien que quiero",
  "Descansar el cuerpo sin castigarme",
  "Dar un paso pequeño que vengo posponiendo"
];

let lucha = true;
let energia = 18;
let t = 0;
let nivelPalanca = 1; /* 1 = encendida, 0 = apagada */

function nombrePrimaria(){
  const p = Kit.activas("primaria");
  return p.length ? p.join(" · ") : "Emoción natural";
}
function nombreSecundaria(){
  const s = Kit.activas("secundaria");
  return s.length ? s[0] : "Pelear contra lo que siento";
}

function dibujar(){
  const svg = $("escenaInterruptor");
  svg.innerHTML = "";
  const g = (tag, a) => svg.appendChild(Kit.svg(tag, a));

  g("rect", {x:0, y:0, width:700, height:250, rx:10, fill:lucha ? "#fdf6f4" : "#f4faf7"});

  /* zona izquierda: las ondas (0 a 500) */
  /* anillos turbulentos secundarios cuando la lucha está encendida */
  if(nivelPalanca > 0.03){
    for(let k = 0; k < 3; k++){
      const pulso = ((t * 1.4 + k * 0.33) % 1);
      const cx = 130 + k * 125;
      const cy = 128 + Math.sin(t * 2 + k * 1.5) * 24;
      g("circle", {
        cx:cx, cy:cy, r:16 + pulso * 58 * nivelPalanca,
        fill:"none", stroke:"#b0503f", "stroke-width":2.2,
        opacity:((1 - pulso) * 0.65 * nivelPalanca).toFixed(2),
        "stroke-dasharray":"6 4"
      });
    }
    /* trazado dentado de amplificación secundaria */
    let dSec = "M24 128";
    for(let i = 1; i <= 46; i++){
      const x = 24 + i * 10;
      const base = Math.sin(t * 2.1 + i * 0.28) * 26;
      const pico = (Math.sin(t * 9 + i * 1.7) * 34 + (i % 2 ? 18 : -18)) * nivelPalanca;
      dSec += ` L${x} ${(128 + base + pico).toFixed(1)}`;
    }
    g("path", {
      d:dSec, fill:"none", stroke:"#b0503f",
      "stroke-width":2.4, opacity:(0.85 * nivelPalanca).toFixed(2)
    });
    const etSec = g("text", {
      x:260, y:42, "text-anchor":"middle",
      style:`font:700 12.5px system-ui,sans-serif;fill:#9e3c2c;opacity:${nivelPalanca.toFixed(2)}`
    });
    etSec.textContent = "Amplificación secundaria: " + nombreSecundaria();
  }

  /* onda suave primaria (siempre presente: sube y baja con la vida) */
  let dPri = "M24 136";
  for(let i = 0; i <= 46; i++){
    const x = 24 + i * 10;
    const y = 136 + Math.sin(t * 2.1 + i * 0.28) * 26 + Math.cos(t * 1.1 - i * 0.15) * 7;
    dPri += ` L${x} ${y.toFixed(1)}`;
  }
  g("path", {
    d:dPri + " L484 225 L24 225 Z",
    fill:"#3f83a6", "fill-opacity":0.16
  });
  g("path", {
    d:dPri, fill:"none", stroke:"#2f6f8f", "stroke-width":3.2, "stroke-linecap":"round"
  });
  const etPri = g("text", {
    x:254, y:198, "text-anchor":"middle",
    style:"font:600 12.5px system-ui,sans-serif;fill:#234f66"
  });
  etPri.textContent = "Onda primaria (sube y baja sola): " + nombrePrimaria();

  /* barra de energía disponible */
  g("rect", {x:24, y:214, width:460, height:12, rx:6, fill:"#dfe7ee"});
  const colE = Kit.mezcla("#b0503f", "#3f7d5a", energia / 100);
  g("rect", {x:24, y:214, width:Math.max(12, 4.6 * energia), height:12, rx:6, fill:colE});
  const etEn = g("text", {
    x:254, y:242, "text-anchor":"middle",
    style:"font:600 11.5px system-ui,sans-serif;fill:#556575"
  });
  etEn.textContent = lucha
    ? "Energía consumida en pelear contra la emoción"
    : "Energía libre para hacer lo que importa mientras la ola pasa";

  /* panel del interruptor interactivo a la derecha (x: 520..676) */
  g("rect", {
    x:526, y:26, width:148, height:198, rx:14,
    fill:"#ffffff", stroke:lucha ? "#e2b5aa" : "#b8dcc8", "stroke-width":2
  });
  const tInt = g("text", {
    x:600, y:52, "text-anchor":"middle",
    style:"font:700 12px system-ui,sans-serif;fill:#3f5163;letter-spacing:.5px"
  });
  tInt.textContent = "INTERRUPTOR";

  /* riel vertical del interruptor */
  g("rect", {
    x:572, y:68, width:56, height:112, rx:28,
    fill:lucha ? "#d96854" : "#4a946d", filter:Kit.acuarela(svg)
  });
  const cyBoton = 96 + (1 - nivelPalanca) * 56;
  g("circle", {
    cx:600, cy:cyBoton, r:22, fill:"#fff", stroke:"#d0dae3", "stroke-width":2
  });
  const tEstado = g("text", {
    x:600, y:204, "text-anchor":"middle",
    style:`font:700 13px system-ui,sans-serif;fill:${lucha ? "#b0503f" : "#2f6f4e"}`
  });
  tEstado.textContent = lucha ? "LUCHA ON" : "LUCHA OFF";
}

$("escenaInterruptor").addEventListener("click", () => alternarInterruptor());

const reloj = Kit.reloj(dt => {
  t += dt;
  const metaP = lucha ? 1 : 0;
  nivelPalanca += (metaP - nivelPalanca) * Math.min(1, dt * 6);
  const metaE = lucha ? 16 + Math.sin(t * 3) * 4 : 88;
  energia += (metaE - energia) * Math.min(1, dt * 2.4);
  $("mEnergia").textContent = Math.round(energia) + " %";
  $("mEnergia").style.color = lucha ? "#b0503f" : "#3f7d5a";
  dibujar();
});

function actualizarUI(){
  $("mEstado").textContent = lucha ? "Encendida" : "Apagada";
  $("mEstado").style.color = lucha ? "#b0503f" : "#3f7d5a";
  if(lucha){
    $("fase").textContent = "Interruptor de la lucha: ENCENDIDO";
    $("faseSub").textContent = "Cada ola natural dispara anillos de pelea secundaria y agota la energía disponible.";
    $("btnInterruptor").textContent = "Soltar el interruptor de la lucha";
    $("btnInterruptor").className = "apagar";
  } else {
    $("fase").textContent = "Interruptor de la lucha: APAGADO";
    $("faseSub").textContent = "La emoción primaria sigue subiendo y bajando con naturalidad, pero sin la pelea encima.";
    $("btnInterruptor").textContent = "Volver a encender la lucha (comparar)";
    $("btnInterruptor").className = "encender";
  }
  if(!reloj.anda()) reloj.andar();
  dibujar();
}

function alternarInterruptor(){
  lucha = !lucha;
  if(!lucha) Kit.brindis("Interruptor apagado: la ola sigue, la pelea secundaria se detiene");
  actualizarUI();
  Kit.guardar();
}

function leer(){
  actualizarUI();
}

function resumen(){
  const l = [];
  const p = Kit.activas("primaria");
  if(p.length) l.push("Malestar limpio (primario): " + p.join(", "));
  const s = Kit.activas("secundaria");
  if(s.length) l.push("Lucha secundaria encendida encima: " + s.join(", "));
  l.push("Estado del interruptor al cerrar: " + (lucha ? "Lucha encendida" : "Lucha apagada (malestar limpio)"));
  const lb = Kit.activas("librePara");
  if(lb.length) l.push("En qué usar la energía liberada hoy: " + lb.join(", "));
  return l.join("\n");
}

Kit.chips("primaria", PRIMARIA, leer);
Kit.chips("secundaria", SECUNDARIA, leer);
Kit.chips("librePara", LIBRE);
reloj.andar();

Kit.iniciar({
  clave: "met-el-interruptor",
  alCambiar: leer,
  resumen: resumen,
  extra: () => ({lucha}),
  restaurar: d => {
    lucha = d && d.lucha !== undefined ? !!d.lucha : true;
    nivelPalanca = lucha ? 1 : 0;
    energia = lucha ? 18 : 88;
  }
});
