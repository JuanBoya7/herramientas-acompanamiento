@@meta
archivo: met-el-interruptor.html
titulo: El interruptor de la lucha
orden: 11
enfoque: ACT
etiqueta: Aceptación
sub: Cuando aparece una emoción difícil, a veces se enciende en automático el interruptor de la lucha: pelear contra lo que se siente, culparse por sentirlo o exigir que se vaya ya. Con el interruptor encendido, el malestar limpio de la vida se multiplica en turbulencia secundaria y se lleva toda la energía. Apagarlo no borra la emoción primaria: le devuelve su tamaño natural.
fuente: El interruptor de la lucha (The Struggle Switch) y dolor limpio frente a dolor sucio, en Harris, ACT Made Simple (2009), cap. 8; Trauma-Focused ACT (2021), cap. 12.
resumen: Se distingue la emoción que llegó primero de la pelea que se encendió encima. En la escena viva, apagar el interruptor de la lucha detiene la amplificación secundaria y libera la energía, mientras la emoción natural sigue subiendo y bajando por su cuenta.
@@css
  .ondas{display:block;width:100%;height:auto;max-width:700px;margin:0 auto;cursor:pointer}
  .fase{font-size:19px;font-weight:700;text-align:center;margin:8px auto 2px;color:var(--acento);
    min-height:28px;max-width:600px;line-height:1.35}
  .fase-sub{text-align:center;font-size:14px;color:var(--tinta-suave);max-width:560px;margin:0 auto;
    min-height:22px;line-height:1.5}
  button.apagar{background:#3f7d5a;border-color:#3f7d5a;color:#fff;font-weight:600}
  button.apagar:hover{background:#356b4d;border-color:#356b4d}
  button.encender{background:#b0503f;border-color:#b0503f;color:#fff;font-weight:600}
  button.encender:hover{background:#944132;border-color:#944132}
@@html
<section class="paso">
  <h2><span class="num">1</span>Lo que llegó primero y lo que se encendió encima</h2>
  <p class="ayuda">La primera ola llega sola con vivir; la segunda aparece cuando el interruptor de
  la lucha se enciende y empezamos a pelear con lo que sentimos.</p>
  <div class="cuerpo">
    <label class="etiqueta">Lo que apareció primero (malestar limpio)</label>
    <div class="chips" id="primaria"></div>
    <label class="etiqueta">Lo que se encendió encima al pelear (lucha secundaria)</label>
    <div class="chips" id="secundaria"></div>
  </div>
</section>

<div class="escenario">
  <svg class="ondas" id="escenaInterruptor" viewBox="0 0 700 467" role="img"
    aria-label="Una pared con un interruptor antiguo; la emoción cruza la habitación como una ola"></svg>
  <div class="marcas">
    <div><span class="n" id="mVolvi" style="color:#3f7d5a">0</span><span class="r">veces que solté el interruptor</span></div>
  </div>
  <div class="mandos">
    <button type="button" class="apagar" id="btnInterruptor" onclick="alternarInterruptor()">Soltar el interruptor de la lucha</button>
  </div>
</div>

<section class="bloque pregunta-sola">
  <div class="pregunta" id="pregunta">Si esta emoción pudiera subir y bajar sin que tuvieras que pelearte con ella, ¿en qué usarías hoy esa energía?</div>
  <div class="cuerpo" style="padding:10px 0 0">
    <div class="chips" id="librePara"></div>
  </div>
</section>
@@js
const $ = Kit.$;

const PRIMARIA = [
  "Ansiedad o nervios",
  "Tristeza",
  "Rabia o frustración",
  "Culpa",
  "Vergüenza",
  "Dolor o fatiga física"
];
const SECUNDARIA = [
  "«No debería estar sintiendo esto»",
  "Rabia por sentirme ansioso",
  "Culpa por estar triste",
  "Miedo a perder el control",
  "Reprocharme por seguir igual"
];
const LIBRE = [
  "Atender lo que tengo entre manos hoy",
  "Estar presente con alguien que quiero",
  "Descansar el cuerpo sin castigarme",
  "Dar un paso pequeño que vengo posponiendo"
];

let lucha = true;
let energia = 18;
let t = 0;
let nivelPalanca = 1; /* 1 = encendida, 0 = apagada */

function nombrePrimaria(){
  const p = Kit.activas("primaria");
  return p.length ? p.join(" · ") : "Emoción natural";
}
function nombreSecundaria(){
  const s = Kit.activas("secundaria");
  return s.length ? s[0] : "Pelear contra lo que siento";
}

let fondoPared = null, volvi = 0;
const PALANCA = {href:"[[imagen:interruptor-palanca.webp]]", r:0.535};
function dibujar(){
  const svg = $("escenaInterruptor");
  svg.innerHTML = "";
  const g = (tag, a, p) => (p || svg).appendChild(Kit.svg(tag, a));
  const rotulo = (x, y, s, color, op) => {
    const e = Kit.svg("text", {x, y, "text-anchor":"middle",
      style:`font:600 14px Georgia,serif;font-style:italic;fill:${color};opacity:${op};paint-order:stroke;stroke:#fbf7ee;stroke-width:4px;stroke-linejoin:round`});
    e.textContent = s.length > 46 ? s.slice(0, 44) + "…" : s; svg.appendChild(e);
  };
  if(!fondoPared) fondoPared = Kit.svg("image", {href:"[[imagen:interruptor-acuarela.jpg]]", x:0, y:0, width:700, height:467, preserveAspectRatio:"none"});
  svg.appendChild(fondoPared);

  const capa = Kit.svg("g", {filter:Kit.acuarela(svg)});
  svg.appendChild(capa);
  const BASE = 250;       /* altura por donde cruza la ola */

  /* la ola primaria: cruza la habitación, sube y baja sola, esté como esté el interruptor */
  let dPri = `M0 ${BASE}`;
  for(let i = 0; i <= 49; i++){
    const x = i * 10;
    const y = BASE + Math.sin(t * 2.1 + i * 0.28) * 30 + Math.cos(t * 1.1 - i * 0.15) * 8;
    dPri += ` L${x} ${y.toFixed(1)}`;
  }
  g("path", {d:dPri + ` Q548 ${BASE + 46} 498 372 L0 372 Z`, fill:"#3f83a6", opacity:.3}, capa);
  g("path", {d:dPri, fill:"none", stroke:"#2f6f8f", "stroke-width":4, "stroke-linecap":"round", opacity:.85}, capa);

  /* la lucha encendida: sobre cada ola se monta otra, dentada, y anillos que se abren por la pared */
  if(nivelPalanca > 0.03){
    let dSec = `M0 ${BASE - 8}`;
    for(let i = 1; i <= 49; i++){
      const x = i * 10;
      const base = Math.sin(t * 2.1 + i * 0.28) * 30;
      const pico = (Math.sin(t * 9 + i * 1.7) * 44 + (i % 2 ? 24 : -24)) * nivelPalanca;
      dSec += ` L${x} ${(BASE - 8 + base + pico).toFixed(1)}`;
    }
    g("path", {d:dSec, fill:"none", stroke:"#a8432f", "stroke-width":3.4, "stroke-linejoin":"round", opacity:(0.85 * nivelPalanca).toFixed(2)}, capa);
    for(let k = 0; k < 4; k++){
      const pulso = ((t * 0.9 + k * 0.25) % 1);
      g("circle", {cx:90 + k * 118, cy:BASE - 30 + Math.sin(t * 2 + k * 1.5) * 34, r:18 + pulso * 92 * nivelPalanca,
        fill:"#b0503f", opacity:((1 - pulso) * 0.22 * nivelPalanca).toFixed(2)}, capa);
    }
    /* y la habitación entera se tiñe */
    g("rect", {x:0, y:0, width:700, height:467, fill:"#8a2f22", opacity:(0.13 * nivelPalanca).toFixed(3), style:"mix-blend-mode:multiply"});
    rotulo(245, 128, nombreSecundaria(), "#8a2f22", nivelPalanca.toFixed(2));
  }
  rotulo(245, 356, nombrePrimaria(), "#1f4a63", 1);

  /* la palanca en su placa de bronce: arriba encendida, abajo suelta */
  const lado = 2 * nivelPalanca - 1, alto = 92, ancho = alto * PALANCA.r;
  const gp = Kit.svg("g", {transform:`translate(560 197) scale(1 ${(Math.abs(lado) < .08 ? .08 : lado).toFixed(3)})`});
  gp.appendChild(Kit.figura("palanca", PALANCA.href, {x:-ancho / 2, y:-alto + 12, width:ancho, height:alto}));
  svg.appendChild(gp);
}

$("escenaInterruptor").addEventListener("click", () => alternarInterruptor());

const reloj = Kit.reloj(dt => {
  t += dt;
  const metaP = lucha ? 1 : 0;
  nivelPalanca += (metaP - nivelPalanca) * Math.min(1, dt * 6);
  const metaE = lucha ? 16 + Math.sin(t * 3) * 4 : 88;
  energia += (metaE - energia) * Math.min(1, dt * 2.4);
  dibujar();
});

function actualizarUI(){
  $("mVolvi").textContent = volvi;
  $("btnInterruptor").textContent = lucha ? "Soltar el interruptor de la lucha" : "Volver a encender la lucha";
  $("btnInterruptor").className = lucha ? "apagar" : "encender";
  if(!reloj.anda()) reloj.andar();
  dibujar();
}

function alternarInterruptor(){
  lucha = !lucha;
  if(!lucha) volvi++;
  actualizarUI();
  Kit.guardar();
}

function leer(){
  actualizarUI();
}

function resumen(){
  const l = [];
  const p = Kit.activas("primaria");
  if(p.length) l.push("Malestar limpio (primario): " + p.join(", "));
  const s = Kit.activas("secundaria");
  if(s.length) l.push("Lucha secundaria encendida encima: " + s.join(", "));
  l.push("Estado del interruptor al cerrar: " + (lucha ? "Lucha encendida" : "Lucha apagada (malestar limpio)"));
  const lb = Kit.activas("librePara");
  if(lb.length) l.push("En qué usar la energía liberada hoy: " + lb.join(", "));
  return l.join("\n");
}

Kit.chips("primaria", PRIMARIA, leer);
Kit.chips("secundaria", SECUNDARIA, leer);
Kit.chips("librePara", LIBRE);
reloj.andar();

Kit.iniciar({
  clave: "met-el-interruptor",
  alCambiar: leer,
  resumen: resumen,
  extra: () => ({lucha}),
  restaurar: d => {
    lucha = d && d.lucha !== undefined ? !!d.lucha : true;
    nivelPalanca = lucha ? 1 : 0;
    energia = lucha ? 18 : 88;
  }
});
