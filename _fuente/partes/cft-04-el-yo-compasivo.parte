@@meta
archivo: cft-el-yo-compasivo.html
titulo: El yo compasivo
orden: 04
enfoque: Compasión y mindfulness
etiqueta: Autocrítica
sub: Como un actor que prepara un papel: no se discute si uno ya es así, se imagina cómo sería. Primero se ponen, una a una, las cualidades del yo compasivo —calidez y fuerza, el deseo de ayudar, la sabiduría, el valor—. Después, desde ahí, se va a acompañar a la versión de uno que lo está pasando mal.
fuente: El yo compasivo y la compasión hacia el yo vulnerable, en Kolts, CFT Made Simple (2016), cap. 9, con el enfoque de actuación de método de Gilbert (2010).
resumen: Una práctica guiada en dos tiempos: ponerse el papel del yo compasivo, cualidad por cualidad, y desde ahí mirar y acompañar a la versión de uno que sufre en una situación reciente. Termina con lo que ese yo querría que entendiera y los momentos del día para volver a ponerse el papel.
@@css
  .fase{font-size:20px;font-weight:700;text-align:center;margin:8px auto 2px;color:var(--acento);
    min-height:28px;max-width:560px;line-height:1.35}
  .fase-sub{text-align:center;font-size:14px;color:var(--tinta-suave);max-width:560px;margin:0 auto;
    min-height:44px;line-height:1.5}
  .actor{display:block;width:100%;max-width:380px;height:auto;margin:0 auto}
  button.arrancar{background:#4a8a7a;border-color:#4a8a7a;color:#fff;font-weight:600}
  button.arrancar:hover{background:#3f776a;border-color:#3f776a}
  .cualidades{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin-top:8px}
  .cualidades span{font-size:12px;padding:3px 10px;border-radius:20px;border:1px solid var(--linea);
    color:var(--tinta-suave);transition:all .5s}
  .cualidades span.puesta{color:#fff;border-color:transparent}
@@html
<section class="paso">
  <h2><span class="num">1</span>La situación</h2>
  <p class="ayuda">Una reciente en la que hubo miedo, ansiedad o autocrítica. No hace falta
  contarla entera: basta con poder volver a verla.</p>
  <div class="cuerpo">
    <textarea id="situacion" placeholder="Dónde estabas, qué pasaba"></textarea>
    <label class="etiqueta">Lo que sentía esa versión tuya</label>
    <div class="chips" id="sentia"></div>
    <label class="etiqueta">Si cuesta imaginarse con estas cualidades</label>
    <div class="chips" id="apoyo"></div>
    <input type="text" id="quien" placeholder="Alguien que las tenga (opcional)" style="margin-top:8px">
  </div>
</section>

<div class="escenario">
  <svg class="actor" id="actor" viewBox="0 0 380 250" role="img"
    aria-label="Una figura que se va rodeando de las cualidades del yo compasivo y luego acompaña a otra más pequeña"></svg>
  <div class="cualidades" id="cualidades">
    <span data-k="calor">Calidez y fuerza</span><span data-k="ayuda">Deseo de ayudar</span>
    <span data-k="sabe">Sabiduría</span><span data-k="valor">Valor</span>
  </div>
  <div class="fase" id="fase">Cuando estés listo</div>
  <div class="fase-sub" id="faseSub">Siéntate erguido y cómodo. Si quieres, cierra los ojos.</div>
  <div class="marcas">
    <div><span class="n" id="mReloj" style="color:#4a8a7a">6:00</span><span class="r">quedan</span></div>
  </div>
  <div class="duracion" id="tiempo">
    <button type="button" class="chip activa" id="tLarga">Completa</button>
    <button type="button" class="chip" id="tCorta">Breve</button>
  </div>
  <div class="mandos">
    <button type="button" class="arrancar" id="btnArrancar" onclick="arrancar()">Empezar</button>
    <button type="button" onclick="siguiente()">Siguiente</button>
    <button type="button" onclick="detener()">Detener</button>
  </div>
</div>

<section class="paso">
  <h2><span class="num">2</span>Qué hizo el yo compasivo</h2>
  <p class="ayuda">Tú conoces a esa versión tuya mejor que nadie y sabes qué necesitaba.</p>
  <div class="cuerpo">
    <div class="chips" id="hizo"></div>
    <label class="etiqueta" for="entender">¿Qué querría que entendiera?</label>
    <textarea id="entender" placeholder="En sus palabras"></textarea>
  </div>
</section>

<section class="paso">
  <h2><span class="num">3</span>Qué pasó</h2>
  <p class="ayuda">Al principio es común no sentirlo. Lo que se practica es cambiar de perspectiva.</p>
  <div class="cuerpo">
    <div class="chips" id="notado"></div>
    <div id="lectura"></div>
  </div>
</section>

<section class="paso">
  <h2><span class="num">4</span>Volver a ponerse el papel</h2>
  <p class="ayuda">Primero en momentos tranquilos, no en medio de la crisis. Con práctica basta
  con traer cuatro palabras: amable, sabio, valiente, compasivo.</p>
  <div class="cuerpo">
    <label class="etiqueta">Momentos del día</label>
    <div class="chips" id="momentos"></div>
    <label class="etiqueta">Además</label>
    <div class="chips" id="ademas"></div>
  </div>
</section>
@@js
const $ = Kit.$;

const SENTIA = ["Miedo", "Vergüenza", "Tristeza", "Rabia", "Me criticaba"];
const APOYO = ["Imaginarme a mí", "Apoyarme en alguien que las tenga"];
const HIZO = ["Se sentó a su lado sin decir nada", "Le tomó la mano",
  "Le dijo que tiene sentido sentirse así", "Le recordó que no es su culpa",
  "Lo animó a quedarse y dar el paso"];
const NOTADO = ["Pude sentirlo, al menos un poco", "Solo pude imaginar cómo sería",
  "No me parezco en nada a eso", "Me dio tristeza o ganas de llorar",
  "Me resultó más fácil pensando en otra persona"];
const MOMENTOS = ["Al levantarme", "Antes de una reunión o una tarea", "Antes de recoger a los hijos",
  "Antes de dormir"];
const ADEMAS = ["Escribirme una carta desde el yo compasivo", "Empezar cada sesión con dos minutos de práctica"];

const COL = {calor:"#d08a3c", ayuda:"#b8566e", sabe:"#5b6fa6", valor:"#3f9b86"};
const ORDEN = ["calor", "ayuda", "sabe", "valor"];

/* [título, indicación, cualidades puestas, ¿aparece la versión vulnerable?, s completa, s breve] */
function pasos(){
  const alguien = Kit.activas("apoyo").indexOf("Apoyarme en alguien que las tenga") >= 0;
  const quien = $("quien").value.trim();
  const apoyo = alguien ? " Si ayuda, piensa en " + (quien || "alguien que las tenga") +
    " y en cómo sería sentirse como esa persona." : "";
  const s = $("situacion").value.trim();
  const sit = s ? " (" + s.slice(0, 70) + (s.length > 70 ? "…" : "") + ")" : "";
  return [
    ["Más despacio", "Unos treinta segundos de respiración lenta, más lenta que la habitual.", 0, 0, 30, 15],
    ["Calidez y fuerza", "Imagina que el cuerpo se siente tranquilo, seguro, lleno de calidez y de fuerza. " +
      "Deja que aparezca una sonrisa suave." + apoyo, 1, 0, 30, 15],
    ["El deseo de ayudar", "Imagina que te llena un deseo amable y firme de ayudar a quien sufre, a ti y a " +
      "los demás. Siente cómo crece.", 2, 0, 40, 20],
    ["La sabiduría", "Puedes ver las cosas desde varios lados. Sabes que lo difícil llega y se va, y que " +
      "es parte de la vida; entiendes de dónde viene y qué ayudaría.", 3, 0, 40, 20],
    ["El valor", "Aparece la confianza: pase lo que pase, también puedo trabajar con esto.", 4, 0, 40, 20],
    ["Así se ve el mundo desde aquí", "¿Qué entenderías? ¿Qué sentirías? ¿Qué te darían ganas de hacer?", 4, 0, 40, 15],
    ["La otra versión de ti", "Trae la situación" + sit + ". Mírala desde aquí. Ve a esa versión tuya " +
      "y lo difícil que es para ella.", 4, 1, 30, 15],
    ["¿Tiene sentido?", "¿Se entiende que se sienta así, con lo que ha vivido? No es su culpa.", 4, 1, 30, 15],
    ["Estar a su lado", "Imagina que estás allí y que solo esa versión tuya te ve. ¿Cómo la ayudarías a sentirse segura? " +
      "¿Qué necesita?", 4, 2, 45, 20],
    ["Lo que querrías que entendiera", "Quédate un momento enviándole comprensión y apoyo. Mira cómo lo recibe.", 4, 2, 35, 15],
    ["Volver", "Abre los ojos cuando quieras y trae contigo algo de esa calidez, sabiduría y confianza.", 4, 2, 15, 10]
  ];
}
let largo = true, paso = -1, enPaso = 0;
const dur = p => largo ? p[4] : p[5];

function figura(svg, x, y, esc, color, op){
  svg.appendChild(Kit.svg("circle", {cx:x, cy:y - 62 * esc, r:17 * esc, fill:color, "fill-opacity":op}));
  svg.appendChild(Kit.svg("path", {d:`M${x - 30 * esc} ${y + 40 * esc} Q${x - 32 * esc} ${y - 38 * esc} ${x} ${y - 38 * esc}` +
    ` Q${x + 32 * esc} ${y - 38 * esc} ${x + 30 * esc} ${y + 40 * esc} Z`, fill:color, "fill-opacity":op}));
}

function dibujar(){
  const svg = $("actor");
  svg.innerHTML = "";
  const p = paso >= 0 ? pasos()[paso] : [0, 0, 0, 0];
  const n = p[2], otra = p[3];
  const cx = otra ? 150 : 190, cy = 150;
  for(let i = n - 1; i >= 0; i--){
    const k = ORDEN[i];
    svg.appendChild(Kit.svg("ellipse", {cx:cx, cy:cy - 20, rx:62 + i * 14, ry:92 + i * 11,
      fill:COL[k], "fill-opacity":.10, stroke:COL[k], "stroke-width":2, "stroke-opacity":.55}));
  }
  if(otra === 2)
    svg.appendChild(Kit.svg("ellipse", {cx:250, cy:cy + 22, rx:62, ry:58, fill:COL.ayuda, "fill-opacity":.10,
      stroke:COL.ayuda, "stroke-width":1.5, "stroke-dasharray":"4 4"}));
  figura(svg, cx, cy, 1, n ? "#3f5f58" : "#9aa7a4", n ? .85 : .5);
  if(otra) figura(svg, 262, cy + 42, .6, "#8a8f98", .7);
  document.querySelectorAll("#cualidades span").forEach((s, i) => {
    const puesta = i < n;
    s.classList.toggle("puesta", puesta);
    s.style.background = puesta ? COL[ORDEN[i]] : "";
  });
}

function mostrar(){
  if(paso < 0) return;
  const p = pasos()[paso];
  $("fase").textContent = p[0];
  $("faseSub").textContent = p[1];
  dibujar();
}
function pintarReloj(){
  const ps = pasos();
  let s = 0;
  ps.forEach((p, i) => { if(paso < 0 || i >= paso) s += dur(p); });
  if(paso >= 0) s -= enPaso;
  s = Math.max(0, Math.ceil(s));
  $("mReloj").textContent = Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0");
}

const reloj = Kit.reloj(dt => {
  enPaso += dt;
  if(enPaso >= dur(pasos()[paso])) siguiente();
  pintarReloj();
});
function arrancar(){
  if(reloj.anda()) return;
  paso = 0; enPaso = 0;
  $("btnArrancar").textContent = "En curso…";
  mostrar(); pintarReloj();
  reloj.andar();
}
function siguiente(){
  if(paso < 0) return arrancar();
  if(paso >= pasos().length - 1) return terminar();
  paso++; enPaso = 0;
  mostrar(); pintarReloj();
}
function detener(){
  reloj.parar();
  $("fase").textContent = "Detenido";
  $("faseSub").textContent = "Abre los ojos despacio.";
  $("btnArrancar").textContent = "Empezar";
}
function terminar(){
  reloj.parar();
  paso = pasos().length - 1; enPaso = dur(pasos()[paso]);
  $("fase").textContent = "Terminó";
  $("faseSub").textContent = "¿Qué hizo el yo compasivo? ¿Qué querría que entendiera?";
  $("btnArrancar").textContent = "Otra vez";
  dibujar(); pintarReloj();
  Kit.brindis("Práctica terminada");
}
$("tiempo").addEventListener("click", e => {
  const b = e.target.closest(".chip"); if(!b || reloj.anda()) return;
  $("tiempo").querySelectorAll(".chip").forEach(c => c.classList.toggle("activa", c === b));
  largo = b.id === "tLarga"; pintarReloj();
});

function leer(){
  const n = Kit.activas("notado");
  let html = "";
  if(n.indexOf("No me parezco en nada a eso") >= 0)
    html += `<div class="pistas">Es el obstáculo más común, y justo por eso se trabaja como un papel:
      no se afirma que uno ya sea así, se imagina cómo sería. Si no aparece, se puede tomar prestado
      de alguien que tenga esas cualidades, o recordar una vez en que se ayudó a otro.</div>`;
  if(n.indexOf("Solo pude imaginar cómo sería") >= 0)
    html += `<div class="logro">Al comienzo eso es todo lo que se pide. El sentirlo suele llegar
      después, con la práctica.</div>`;
  if(n.indexOf("Me resultó más fácil pensando en otra persona") >= 0)
    html += `<div class="pistas">Con mucha vergüenza o autocrítica conviene empezar por ahí: acompañar
      a alguien querido que sufre, y volver a la propia versión vulnerable más adelante.</div>`;
  if(n.indexOf("Me dio tristeza o ganas de llorar") >= 0)
    html += `<div class="pistas">Conmoverse por el sufrimiento de esa versión propia es la compasión.
      Si la tristeza desborda, se vuelve a la respiración lenta y se retoma otro día.</div>`;
  if(!html && n.indexOf("Pude sentirlo, al menos un poco") >= 0)
    html += `<div class="logro">Esa es la perspectiva que se busca fortalecer: volver a ella muchas
      veces y en muchas situaciones.</div>`;
  $("lectura").innerHTML = html;
  $("quien").hidden = Kit.activas("apoyo").indexOf("Apoyarme en alguien que las tenga") < 0;
  if(reloj.anda()) mostrar();
  pintarReloj();
}

function resumen(){
  const l = [];
  const s = $("situacion").value.trim();
  if(s) l.push("Situación: " + s);
  const se = Kit.activas("sentia");
  if(se.length) l.push("Lo que sentía: " + se.join(", "));
  const q = $("quien").value.trim();
  if(Kit.activas("apoyo").length) l.push("Apoyo: " + Kit.activas("apoyo").join(", ") + (q ? " (" + q + ")" : ""));
  const h = Kit.activas("hizo");
  if(h.length) l.push("Qué hizo el yo compasivo: " + h.join(", "));
  const e = $("entender").value.trim();
  if(e) l.push("Lo que querría que entendiera: " + e);
  const n = Kit.activas("notado");
  if(n.length) l.push("Qué pasó: " + n.join(", "));
  const m = Kit.activas("momentos"), a = Kit.activas("ademas");
  if(m.length || a.length) l.push("", "PRÁCTICA: " + m.concat(a).join(", "));
  return l.join("\n");
}

Kit.chips("sentia", SENTIA, leer);
Kit.chips("apoyo", APOYO, leer, true);
Kit.chips("hizo", HIZO, leer);
Kit.chips("notado", NOTADO, leer);
Kit.chips("momentos", MOMENTOS);
Kit.chips("ademas", ADEMAS);
$("quien").addEventListener("input", leer);
$("situacion").addEventListener("input", leer);
dibujar(); pintarReloj();

Kit.iniciar({ clave: "cft-el-yo-compasivo", alCambiar: leer, resumen: resumen });
